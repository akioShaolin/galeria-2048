---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { areas, getAreaPath } from "../data/areas";

const areaDescriptions = [
	"Desenvolvimento, diagnóstico, reparo e experimentação com circuitos eletrônicos, sistemas embarcados, interfaces e instrumentação.",
	"Software como ferramenta para fazer hardware conversar, automatizar processos, coletar dados e transformar experimentos em sistemas utilizáveis.",
	"CLPs, comunicação industrial, Modbus, RS485, redes e integração entre equipamentos que nem sempre foram projetados para trabalhar juntos.",
	"Pedais, amplificadores, pré-amplificadores e experiências em que o circuito deixa de ser apenas medido e também passa a ser ouvido.",
	"Instrumentos como projetos em evolução: elétrica, captadores, peças, restauração, modificações e experimentação.",
	"Construir para entender. Medir, desmontar, testar hipóteses, errar, modificar e tentar novamente.",
];

const ferramentas = [
	"ESP8266",
	"ESP32",
	"Arduino",
	"C / C++",
	"Python",
	"Modbus RTU",
	"Modbus TCP",
	"RS485",
	"CLP",
	"Git",
	"GitHub",
	"Astro",
	"Osciloscópio",
	"Eletrônica analógica",
	"Sistemas embarcados",
];
---

<BaseLayout
	title="Sobre — Galeria -2048"
	description="Sobre Pedro Akio Sakuma, akioShaolin, e o processo por trás da Galeria -2048."
>
	<style is:global>
		body {
			background:
				linear-gradient(
					rgba(255,255,255,.018) 1px,
					transparent 1px
				),
				linear-gradient(
					90deg,
					rgba(255,255,255,.018) 1px,
					transparent 1px
				),
				var(--bg);

			background-size: 40px 40px;

			font-family:
				Arial,
				Helvetica,
				sans-serif;
		}

		/* HEADER */

		header {
			border-bottom: 1px solid var(--line);

			background: rgba(5, 7, 8, .88);
		}

		nav {
			height: 70px;

			display: flex;
			align-items: center;
			justify-content: space-between;

			gap: 30px;
		}

		.brand {
			font-weight: 800;
			letter-spacing: -.045em;
		}

		.back {
			color: var(--muted);

			font-family: monospace;
			font-size: .875rem;
		}

		.back:hover {
			color: var(--programacao);
		}

		/* HERO */

		.hero {
			padding: 110px 0 100px;

			border-bottom: 1px solid var(--line);
		}

		.path {
			margin-bottom: 25px;

			color: var(--programacao);

			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;

			letter-spacing: .08em;
		}

		h1 {
			margin: 0;

			font-size: clamp(5rem, 13vw, 11rem);

			line-height: .8;

			letter-spacing: -.08em;
		}

		.intro {
			max-width: 850px;

			margin-top: 50px;

			font-size: clamp(1.35rem, 2.4vw, 2rem);

			line-height: 1.45;

			letter-spacing: -.025em;
		}

		.intro .muted {
			color: var(--muted);
		}

		.cursor {
			display: inline-block;

			width: .55em;
			height: .08em;

			margin-left: 7px;

			background: var(--programacao);

			box-shadow:
				0 0 8px var(--programacao);

			animation:
				cursorBlink 1.1s step-end infinite;
		}

		@keyframes cursorBlink {
			50% {
				opacity: 0;
			}
		}

		/* SEÇÕES */

		.content {
			padding: 110px 0;

			border-bottom: 1px solid var(--line);
		}

		.section-grid {
			display: grid;

			grid-template-columns: 280px 1fr;

			gap: 80px;
		}

		.section-label {
			color: var(--programacao);

			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;

			letter-spacing: .08em;
		}

		h2 {
			margin: 0 0 35px;

			font-size: clamp(2.3rem, 4.5vw, 4.5rem);

			line-height: 1;

			letter-spacing: -.055em;
		}

		.prose {
			max-width: 790px;
		}

		.prose p {
			margin: 0 0 25px;

			color: var(--muted);

			font-family: Georgia, "Times New Roman", serif;
			font-size: 1.125rem;
			line-height: 1.8;
		}

		.prose strong {
			color: var(--text);
		}

		.context-link {
			display: inline-flex;
			align-items: center;
			gap: 12px;

			margin-top: 10px;
			padding-bottom: 7px;

			border-bottom: 1px solid var(--programacao);

			color: var(--programacao);

			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;
			letter-spacing: .04em;
		}

		.context-link:hover,
		.context-link:focus-visible {
			color: var(--text);
		}

		/* QUEM */

		.identity {
			margin-top: 55px;

			display: grid;

			grid-template-columns: repeat(3, 1fr);

			border: 1px solid var(--line);
		}

		.identity-item {
			padding: 22px;

			border-right: 1px solid var(--line);
		}

		.identity-item:last-child {
			border-right: 0;
		}

		.identity-label {
			margin-bottom: 8px;

			color: var(--muted);

			font-family: monospace;
			font-size: .875rem;
			line-height: 1.45;
		}

		.identity-value {
			font-family: monospace;
			font-size: .9375rem;
			line-height: 1.45;
		}

		.online {
			color: var(--programacao);
		}

		.online::before {
			content: "●";

			margin-right: 8px;

			text-shadow:
				0 0 8px var(--programacao);
		}

		/* ÁREAS */

		.areas {
			border-top: 1px solid var(--line);
		}

		.area {
			display: grid;

			grid-template-columns: 70px 220px 1fr;

			gap: 30px;

			align-items: baseline;

			padding: 28px 0;

			border-bottom: 1px solid var(--line);
		}

		.area-number {
			color: var(--muted);

			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;
		}

		.area-name {
			font-family: monospace;
			font-size: .9375rem;
			line-height: 1.45;
			font-weight: bold;
		}

		.area-text {
			max-width: 650px;

			color: var(--muted);

			font-family: Georgia, "Times New Roman", serif;
			font-size: 1.0625rem;
			line-height: 1.7;
		}

		.area-name a:hover,
		.area-name a:focus-visible {
			text-decoration: underline;
			text-underline-offset: 5px;
			outline: 0;
		}

		.eletronica { color: var(--eletronica); }
		.programacao { color: var(--programacao); }
		.automacao { color: var(--automacao); }
		.audio { color: var(--audio); }
		.luthieria { color: var(--luthieria); }
		.experimentacao { color: var(--experimentacao); }

		/* FERRAMENTAS */

		.tools {
			display: flex;
			flex-wrap: wrap;

			gap: 10px;

			max-width: 800px;
		}

		.tool {
			padding: 8px 11px;

			border: 1px solid var(--line);

			background: var(--surface);

			color: var(--muted);

			font-family: monospace;
			font-size: .875rem;
			line-height: 1.4;

			transition:
				border-color .2s ease,
				color .2s ease;
		}

		.tool:hover {
			border-color: var(--programacao);

			color: var(--programacao);
		}

		/* MANIFESTO */

		.manifesto {
			padding: 130px 0;
		}

		.manifesto-label {
			margin-bottom: 35px;

			color: var(--experimentacao);

			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;

			letter-spacing: .08em;
		}

		.manifesto-text {
			max-width: 1000px;

			font-size: clamp(2.3rem, 5vw, 5rem);

			line-height: 1.05;

			letter-spacing: -.055em;
		}

		.manifesto-text span {
			color: var(--muted);
		}

		.signature {
			margin-top: 65px;

			color: var(--programacao);

			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;
		}

		/* LINKS */

		.links {
			display: grid;

			grid-template-columns: repeat(2, 1fr);

			border-top: 1px solid var(--line);
		}

		.link {
			position: relative;

			padding: 35px 0;

			border-bottom: 1px solid var(--line);

			font-family: monospace;

			transition:
				color .2s ease;
		}

		.link:nth-child(odd) {
			padding-right: 35px;

			border-right: 1px solid var(--line);
		}

		.link:nth-child(even) {
			padding-left: 35px;
		}

		.link span {
			float: right;

			color: var(--muted);
		}

		.link:hover {
			color: var(--programacao);
		}

		/* FOOTER */

		footer {
			padding: 30px 0;

			border-top: 1px solid var(--line);

			color: var(--muted);

			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;
		}

		.footer {
			display: flex;

			justify-content: space-between;

			gap: 30px;
		}

		@media (max-width: 800px) {

			.section-grid {
				grid-template-columns: 1fr;

				gap: 35px;
			}

			.identity {
				grid-template-columns: 1fr;
			}

			.identity-item {
				border-right: 0;
				border-bottom: 1px solid var(--line);
			}

			.identity-item:last-child {
				border-bottom: 0;
			}

			.area {
				grid-template-columns: 45px 1fr;

				gap: 15px;
			}

			.area-text {
				grid-column: 2;
			}

			.links {
				grid-template-columns: 1fr;
			}

			.link:nth-child(odd),
			.link:nth-child(even) {
				padding:
					30px 0;

				border-right: 0;
			}

			.footer {
				flex-direction: column;
			}
		}

	</style>

	<SiteHeader />

	<main>

		<div class="container">

			<section class="hero">

				<div class="path">
					~/GALERIA/SOBRE/
				</div>

				<h1>
					SOBRE
				</h1>

				<div class="intro">

					Meu nome é{" "}
					<strong>Pedro Akio Sakuma</strong>.

					<br /><br />

					<span class="muted">
						Na internet, assino como akioShaolin.
						Construo, desmonto e documento coisas
						para entender como elas funcionam.
					</span>

					<span
						class="cursor"
						aria-hidden="true"
					></span>

				</div>

				<div class="identity">

					<div class="identity-item">

						<div class="identity-label">
							NOME
						</div>

						<div class="identity-value">
							PEDRO AKIO SAKUMA
						</div>

					</div>

					<div class="identity-item">

						<div class="identity-label">
							IDENTIDADE
						</div>

						<div class="identity-value">
							AKIOSHAOLIN
						</div>

					</div>

					<div class="identity-item">

						<div class="identity-label">
							STATUS
						</div>

						<div class="identity-value online">
							EXPERIMENTANDO
						</div>

					</div>

				</div>

			</section>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 01 / SOBRE ]
					</div>

					<div class="prose">

						<h2>
							Aqui os projetos simplesmente acontecem.
						</h2>

						<p>
							Meu nome é Pedro Akio Sakuma. Na internet,
							uso o nome akioShaolin. A Galeria -2048 é
							o lugar onde reúno projetos, experiências,
							reparos e investigações que surgem entre
							a bancada, o computador e os instrumentos.
						</p>

						<p>
							Não existe uma fronteira muito clara entre
							o que faço por necessidade e o que começo
							por curiosidade. Uma falha de comunicação
							pode virar uma ferramenta; um instrumento
							pode se transformar em experiência de
							luthieria, eletrônica e áudio.
						</p>

						<p>
							Aqui os projetos simplesmente acontecem.
							Alguns chegam a uma versão estável; outros
							continuam abertos. Ambos merecem registro.
						</p>

					</div>

				</div>

			</section>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 02 / O PROCESSO ]
					</div>

					<div class="prose">

						<h2>
							O caminho também faz parte do projeto.
						</h2>

						<p>
							Quase nada nasce pronto. Antes do resultado
							existem hipóteses, medições, peças trocadas,
							código provisório, decisões revistas e
							tentativas que não levam aonde eu esperava.
						</p>

						<p>
							É justamente essa parte que costuma
							desaparecer quando se mostra apenas o objeto
							final. Na <strong>Galeria -2048</strong>,
							o processo permanece visível.
						</p>

						<p>
							Documentar serve para organizar o raciocínio,
							preservar o que aprendi e permitir que uma
							ideia antiga volte a produzir sinal no futuro.
						</p>

						<p>
							<strong>O processo é tão importante quanto
							o resultado.</strong>
						</p>

					</div>

				</div>

			</section>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 03 / O ACUMULADOR ]
					</div>

					<div class="prose">

						<h2>
							Guardar peças também é guardar possibilidades.
						</h2>

						<p>
							Tenho o hábito de guardar componentes,
							módulos, instrumentos incompletos e objetos
							que parecem ter alguma história técnica para
							contar. Nem tudo tem uso imediato.
						</p>

						<p>
							Às vezes uma peça espera anos até encontrar
							o problema certo. Em outras ocasiões, o objeto
							é o próprio problema: identificar o circuito,
							entender o protocolo ou descobrir por que ele
							deixou de funcionar.
						</p>

						<p>
							O estudo do <strong>ED100</strong> nasceu desse
							tipo de encontro: um datalogger, uma interface
							RS485 e perguntas suficientes para transformar
							o hardware em referência técnica.
						</p>

						<a class="context-link" href="/artigos/ed100-hardware-rs485/">
							LER O ARTIGO DO ED100 <span>→</span>
						</a>

					</div>

				</div>

			</section>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 04 / A MÚSICA ]
					</div>

					<div class="prose">

						<h2>
							Ouvir também é uma forma de medir.
						</h2>

						<p>
							A música atravessa muitos dos projetos daqui.
							Ela aparece na construção e modificação de
							instrumentos, nos circuitos de áudio e na
							curiosidade sobre o percurso de um sinal.
						</p>

						<p>
							Uma guitarra pode ser instrumento, objeto de
							estudo e plataforma de testes ao mesmo tempo.
							Madeira, captadores, elétrica e regulagem se
							encontram em uma experiência que também precisa
							ser ouvida, não apenas medida.
						</p>

						<p>
							A <strong>GTR-01</strong> registra esse caminho:
							uma guitarra em transformação, preservada como
							processo e não apresentada como peça definitiva.
						</p>

						<a class="context-link" href="/projetos/gtr-01/">
							VER O PROJETO GTR-01 <span>→</span>
						</a>

					</div>

				</div>

			</section>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 05 / ÁREAS ]
					</div>

					<div>

						<h2>
							O que aparece por aqui.
						</h2>

						<div class="areas">
							{areas.map((area, index) => (
								<div class="area">
									<div class="area-number">{(index + 1).toString().padStart(2, "0")}</div>
									<div class={`area-name ${area.tone}`}><a href={getAreaPath(area)}>{area.label} →</a></div>
									<div class="area-text">{areaDescriptions[index]}</div>
								</div>
							))}
						</div>

					</div>

				</div>

			</section>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 06 / BANCADA ]
					</div>

					<div>

						<h2>
							Ferramentas e tecnologias.
						</h2>

						<div class="tools">
							{ferramentas.map((ferramenta) => (
								<span class="tool">{ferramenta}</span>
							))}
						</div>

					</div>

				</div>

			</section>

			<section class="manifesto">

				<div class="manifesto-label">
					[ IDEIAS EM SINAL ]
				</div>

				<div class="manifesto-text">

					Construir para entender.

					<br />

					<span>
						Documentar para não deixar
						o que foi aprendido desaparecer
						em alguma pasta.
					</span>

				</div>

				<div class="signature">
					— akioShaolin / GALERIA -2048
				</div>

			</section>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 07 / ENCONTRE ]
					</div>

					<div>

						<h2>
							Continue explorando.
						</h2>

						<div class="links">

							<a
								class="link"
								href="https://github.com/akioShaolin"
								target="_blank"
								rel="noopener noreferrer"
							>
								GITHUB
								<span>↗</span>
							</a>

							<a
								class="link"
								href="/playlist/"
							>
								PLAYLIST
								<span>→</span>
							</a>

							<a
								class="link"
								href="/projetos/gtr-01/"
							>
								GTR-01
								<span>→</span>
							</a>

							<a
								class="link"
								href="/"
							>
								ACERVO
								<span>→</span>
							</a>

						</div>

					</div>

				</div>

			</section>

		</div>

	</main>

	<SiteFooter rightText="IDEIAS EM SINAL" />

</BaseLayout>
