---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

type CreatorLink = { label: string; href: string };

type Creator = {
	name: string;
	publicName: string;
	handle: string;
	platform?: string;
	externalLinks: CreatorLink[];
	image: string;
	alt: string;
	focus: string;
	story: string[];
	links?: CreatorLink[];
};

// Avatares do YouTube obtidos das páginas públicas dos canais em 22/11/2026.
// O retrato de Alan Baldo vem de https://alanbaldo.eng.br/esperapci/.
const creators: Creator[] = [
	{
		name: "Professor Bairros",
		publicName: "Professor Bairros (Pesquisar Eletrônica)",
		handle: "@professorbairros",
		externalLinks: [
			{ label: "VISITAR CANAL", href: "https://www.youtube.com/@professorbairros" },
			{ label: "SITE ↗", href: "https://www.bairrospd.com/" },
		],
		image: "/images/fontes-inspiracoes/professor-bairros.webp",
		alt: "Imagem de perfil do canal Professor Bairros no YouTube",
		focus: "ELETRÔNICA / AULAS E PESQUISA",
		story: [
			"Assisti a muitas aulas do Professor Bairros. O conteúdo dele costuma partir de um nível de análise muito mais teórico do que aquele pelo qual eu naturalmente começo. Minha tendência é montar, testar, medir, modificar e tentar entender o circuito enquanto trabalho sobre ele — não calcular cada estágio completamente antes de encostar nos componentes.",
			"Isso significa que nem sempre absorvi toda a teoria apresentada. Mesmo assim, suas explicações me deram base suficiente para reconhecer circuitos, compreender melhor o que estava diante de mim e transformar conceitos em experimentos. Essa influência aparece de forma concreta no PD-02, que nasceu diretamente de um pré-amplificador com BF245 apresentado por ele. Parte do que apliquei nos testes de ignição e da bobina do Monza também veio de uma de suas aulas sobre bobinas automotivas. Mesmo quando não acompanho cada cálculo, o conhecimento permanece ali como uma referência que reaparece na bancada.",
		],
		links: [
			{ label: "PD-02 / AMPLIFICADOR JFET", href: "/projetos/pd-02/" },
			{ label: "TESTADOR DE IGNIÇÃO DO MONZA", href: "/projetos/monza-ignicao-emergencial/" },
		],
	},
	{
		name: "Freesia Gaul",
		publicName: "Freesia Gaul",
		handle: "@FreesiaG",
		externalLinks: [
			{ label: "VISITAR CANAL", href: "https://www.youtube.com/@FreesiaG" },
			{ label: "INSTAGRAM ↗", href: "https://www.instagram.com/freesia.gaul/" },
			{ label: "SITE ↗", href: "https://freesiagaul.com/" },
		],
		image: "/images/fontes-inspiracoes/freesia-gaul.webp",
		alt: "Imagem de perfil do canal Freesia Gaul no YouTube",
		focus: "ELETRÔNICA CRIATIVA / HARDWARE",
		story: [
			"Eu a conheci primeiro por uma publicação no Instagram sobre circuitos embarcados, ESP32 e assuntos práticos de elétrica e eletrônica. O tema já conversava com coisas que eu gostava de investigar, mas não foi apenas isso que chamou minha atenção.",
			"Eu pessoalmente não costumo encontrar tantas mulheres produzindo esse tipo de conteúdo sobre eletrônica e sistemas embarcados. Ver uma mulher apresentando esses assuntos de forma acessível, com dicas úteis para quem está começando e uma aproximação prática do hardware, fez o conteúdo se destacar para mim.",
		],
	},
	{
		name: "Alan Baldo",
		publicName: "Alan Baldo",
		handle: "@alanhbaldo",
		platform: "INSTAGRAM / SITE",
		externalLinks: [
			{ label: "INSTAGRAM ↗", href: "https://www.instagram.com/alanhbaldo/" },
			{ label: "SITE / CURSOS ↗", href: "https://alanbaldo.eng.br/links/" },
		],
		image: "/images/fontes-inspiracoes/alan-baldo.webp",
		alt: "Retrato de Alan Baldo usado no site oficial",
		focus: "ELETRÔNICA / SISTEMAS EMBARCADOS / PROJETO DE HARDWARE",
		story: [
			"Comecei a acompanhar o Alan pelas dicas de eletrônica e sistemas embarcados. Lembro de vê-lo reconhecer um componente da Texas Instruments pelo padrão da marcação no encapsulamento. Até o jeito como o código estava impresso já era uma pista.",
			"O que mais ficou comigo foram as dicas de projeto. O caminho de uma trilha, o limite de um componente ou uma condição de uso que não aparece no esquema podem mudar o que acontece quando a placa sai do papel. Passei a olhar para os meus circuitos com uma pergunta a mais: além de funcionar na bancada, em que condições isso pode falhar?",
		],
	},
	{
		name: "gabo5x",
		publicName: "gabo5x",
		handle: "@gabo5x",
		externalLinks: [
			{ label: "VISITAR CANAL", href: "https://www.youtube.com/@gabo5x" },
			{ label: "INSTAGRAM ↗", href: "https://www.instagram.com/gabo.5x/" },
		],
		image: "/images/fontes-inspiracoes/gabo5x.webp",
		alt: "Identidade visual do canal gabo5x no YouTube",
		focus: "REPARO DE PLACAS / DIAGNÓSTICO",
		story: [
			"O conteúdo que colocou gabo5x no meu radar começou com uma situação quase banal: por volta de 1h36 da manhã, a internet parou. Em vez de apenas aceitar o problema, ele levou o modem para a bancada, testou sua alimentação, percebeu o consumo subir e decidiu abri-lo para procurar a falha.",
			"A brincadeira sobre não querer perder a garantia, seguida imediatamente pela decisão de abrir o equipamento mesmo assim, resumiu bem o espírito do vídeo. Houve curiosidade, diagnóstico, reparo e humor sarcástico no meio de uma falha inconveniente. Eu me identifiquei porque essa sequência — alguma coisa para, a curiosidade assume o controle e o problema acaba sobre a bancada — se parece muito com a forma como lido com meus próprios equipamentos.",
		],
	},
	{
		name: "Universo Programado",
		publicName: "Universo Programado",
		handle: "@UniversoProgramado",
		externalLinks: [{ label: "VISITAR CANAL", href: "https://www.youtube.com/@UniversoProgramado" }],
		image: "/images/fontes-inspiracoes/universo-programado.webp",
		alt: "Imagem de perfil ilustrada do canal Universo Programado no YouTube",
		focus: "PROGRAMAÇÃO / SIMULAÇÕES / IA",
		story: [
			"O Universo Programado é um daqueles canais em que o assunto inicial nem sempre é aquilo que mais me prende. Não sou especialmente movido pelos jogos usados em várias demonstrações, mas posso passar horas acompanhando a maneira como redes neurais, inteligência artificial, algoritmos e simulações são apresentados.",
			"O que me mantém assistindo é a tentativa de compreender o mecanismo por trás da demonstração. Enquanto vejo, quase sempre aparece a mesma pergunta: existe alguma coisa aqui que eu poderia aplicar em um projeto meu? A influência, nesse caso, não é a reprodução de uma montagem específica. É a curiosidade computacional que o conteúdo consegue provocar.",
		],
	},
	{
		name: "WR Kits",
		publicName: "WR Kits",
		handle: "@canalwrkits",
		externalLinks: [{ label: "VISITAR CANAL", href: "https://www.youtube.com/@canalwrkits" }],
		image: "/images/fontes-inspiracoes/wr-kits.webp",
		alt: "Logotipo do canal WR Kits no YouTube",
		focus: "ELETRÔNICA / ROBÓTICA / PROGRAMAÇÃO",
		story: [
			"Assisti a menos vídeos da WR Kits do que dos outros canais desta página. Ainda assim, alguns desses vídeos foram importantes porque mostraram que certas tecnologias e circuitos eram compreensíveis.",
			"Antes de uma boa explicação, um equipamento pode parecer uma caixa mágica: entra alguma coisa de um lado e um resultado aparece do outro. Quando o circuito é dividido em blocos, componentes, sinais e decisões, essa camada de mistério começa a desaparecer. Talvez eu ainda não saiba construir tudo aquilo, mas já consigo enxergar por onde começar a investigar.",
		],
	},
];
---

<BaseLayout
	title="Fontes & Inspirações — Galeria -2048"
	description="Criadores que compartilharam conhecimento, despertaram curiosidade e influenciaram a forma como akioShaolin aprende, investiga e constrói."
>
	<style is:global>
		body {
			background:
				radial-gradient(circle at 82% 7%, rgba(0, 217, 255, .055), transparent 520px),
				linear-gradient(rgba(255,255,255,.014) 1px, transparent 1px),
				linear-gradient(90deg, rgba(255,255,255,.014) 1px, transparent 1px),
				var(--bg);
			background-size: auto, 42px 42px, 42px 42px, auto;
			overflow-x: hidden;
			font-family: Arial, Helvetica, sans-serif;
		}

		.sources-hero {
			padding: 105px 0 95px;
			border-bottom: 1px solid var(--line);
		}

		.eyebrow,
		.section-code,
		.channel-platform,
		.channel-handle,
		.channel-focus,
		.story-label,
		.not-ranking {
			font-family: "Courier New", Courier, monospace;
			font-size: .875rem;
			line-height: 1.5;
			letter-spacing: .07em;
		}

		.eyebrow,
		.section-code,
		.channel-platform,
		.story-label {
			color: var(--programacao);
		}

		.sources-hero h1 {
			max-width: 1100px;
			margin: 24px 0 38px;
			font-size: clamp(3.8rem, 10vw, 8.4rem);
			line-height: .86;
			letter-spacing: -.065em;
		}

		.sources-intro {
			max-width: 800px;
			color: var(--muted);
			font-family: Georgia, "Times New Roman", serif;
			font-size: clamp(1.18rem, 2vw, 1.55rem);
			line-height: 1.7;
		}

		.not-ranking {
			display: inline-block;
			margin-top: 34px;
			padding: 11px 14px;
			border: 1px solid var(--line);
			color: var(--text);
			background: var(--surface);
		}

		.creators {
			border-bottom: 1px solid var(--line);
		}

		.creator {
			display: grid;
			grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
			gap: clamp(45px, 7vw, 100px);
			padding: 90px 0;
			border-bottom: 1px solid var(--line);
			min-width: 0;
		}

		.creator:last-child {
			border-bottom: 0;
		}

		.channel-card {
			align-self: start;
			border: 1px solid var(--line);
			background: var(--surface);
			min-width: 0;
		}

		.channel-image {
			display: block;
			width: 100%;
			aspect-ratio: 1;
			object-fit: cover;
			border-bottom: 1px solid var(--line);
		}

		.channel-info {
			padding: 22px;
		}

		.channel-platform {
			margin: 0 0 14px;
		}

		.channel-info h2 {
			margin: 0;
			font-size: clamp(1.65rem, 3vw, 2.25rem);
			line-height: 1;
			letter-spacing: -.04em;
		}

		.channel-public-name {
			margin: 8px 0 0;
			color: var(--muted);
			font-family: Georgia, "Times New Roman", serif;
			font-size: .9375rem;
			line-height: 1.5;
		}

		.channel-handle {
			margin: 9px 0 0;
			color: var(--text);
			text-transform: none;
		}

		.channel-focus {
			margin: 20px 0 0;
			padding-top: 18px;
			border-top: 1px solid var(--line);
			color: var(--muted);
		}

		.channel-link {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 18px;
			margin-top: 22px;
			padding: 15px 16px;
			border: 1px solid var(--programacao);
			color: var(--programacao);
			font-family: "Courier New", Courier, monospace;
			font-size: .875rem;
			font-weight: bold;
			line-height: 1.4;
		}

		.channel-link + .channel-link {
			margin-top: 10px;
		}

		.channel-link:hover,
		.channel-link:focus-visible {
			background: rgba(0, 217, 255, .08);
		}

		.creator-story {
			max-width: 750px;
			align-self: center;
			min-width: 0;
		}

		.creator-story h2 {
			margin: 14px 0 30px;
			font-size: clamp(2.25rem, 5vw, 4.8rem);
			line-height: .94;
			letter-spacing: -.055em;
		}

		.creator-story p:not(.story-label) {
			margin: 0;
			color: var(--muted);
			font-family: Georgia, "Times New Roman", serif;
			font-size: 1.125rem;
			line-height: 1.82;
		}

		.creator-story p + p {
			margin-top: 20px;
		}

		.project-links {
			display: flex;
			flex-wrap: wrap;
			gap: 10px;
			margin-top: 32px;
		}

		.project-links a {
			padding: 11px 13px;
			border: 1px solid var(--line);
			font-family: "Courier New", Courier, monospace;
			font-size: .875rem;
			font-weight: bold;
			line-height: 1.4;
		}

		.project-links a:hover,
		.project-links a:focus-visible {
			border-color: var(--programacao);
			color: var(--programacao);
		}

		.closing {
			padding: 110px 0;
		}

		.closing-grid {
			display: grid;
			grid-template-columns: 280px minmax(0, 1fr);
			gap: 80px;
		}

		.closing blockquote {
			max-width: 850px;
			margin: 0;
			font-size: clamp(2.2rem, 5vw, 4.7rem);
			font-weight: 800;
			line-height: 1.02;
			letter-spacing: -.05em;
		}

		.closing blockquote span {
			color: var(--muted);
		}

		@media (max-width: 800px) {
			.sources-hero {
				padding: 72px 0 65px;
			}

			.eyebrow,
			.not-ranking {
				max-width: 100%;
				overflow-wrap: anywhere;
			}

			.sources-hero h1 {
				font-size: clamp(2.85rem, 13vw, 3.6rem);
				line-height: .9;
				overflow-wrap: anywhere;
			}

			.sources-intro,
			.creator-story,
			.channel-info {
				overflow-wrap: break-word;
			}

			.creator {
				grid-template-columns: 1fr;
				gap: 38px;
				padding: 70px 0;
			}

			.channel-card {
				width: min(100%, 390px);
			}

			.creator-story {
				max-width: none;
			}

			.closing {
				padding: 75px 0;
			}

			.closing-grid {
				grid-template-columns: 1fr;
				gap: 30px;
			}
		}
	</style>

	<SiteHeader accent="var(--programacao)" />

	<main>
		<header class="sources-hero">
			<div class="container">
				<p class="eyebrow">[ GALERIA / CONHECIMENTO COMPARTILHADO ]</p>
				<h1>FONTES &<br />INSPIRAÇÕES</h1>
				<p class="sources-intro">
					A Galeria -2048 reúne coisas que eu construí, mas nenhuma delas surgiu isolada. Ao longo do tempo, alguns criadores me ensinaram conceitos, mostraram maneiras práticas de resolver problemas ou simplesmente despertaram curiosidade suficiente para que eu abrisse alguma coisa e tentasse entendê-la. Esta página é uma forma de compartilhar algumas dessas fontes de conhecimento e inspiração.
				</p>
				<p class="not-ranking">NÃO É UM RANKING / É UMA HISTÓRIA DE INFLUÊNCIAS</p>
			</div>
		</header>

		<section class="creators" aria-label="Criadores que são fontes de conhecimento e inspiração">
			<div class="container">
				{creators.map((creator, index) => (
					<article class="creator">
						<div class="channel-card">
							<img class="channel-image" src={creator.image} alt={creator.alt} width="360" height="360" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
							<div class="channel-info">
								<p class="channel-platform">[ {creator.platform ?? "YOUTUBE / CANAL"} ]</p>
								<h2>{creator.name}</h2>
								{creator.publicName !== creator.name && <p class="channel-public-name">No YouTube: {creator.publicName}</p>}
								<p class="channel-handle">{creator.handle}</p>
								<p class="channel-focus">{creator.focus}</p>
								{creator.externalLinks.map((link) => (
									<a class="channel-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
								))}
							</div>
						</div>

						<div class="creator-story">
							<p class="story-label">{String(index + 1).padStart(2, "0")} / POR QUE ESTÁ AQUI</p>
							<h2>{creator.name}</h2>
							{creator.story.map((paragraph) => <p>{paragraph}</p>)}
							{creator.links && (
								<nav class="project-links" aria-label={`Projetos relacionados a ${creator.name}`}>
									{creator.links.map((link) => <a href={link.href}>{link.label}</a>)}
								</nav>
							)}
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="closing">
			<div class="container closing-grid">
				<p class="section-code">[ EM SINAL ]</p>
				<blockquote>
					Quando alguém compartilha o que aprendeu, <span>aquele conhecimento deixa de pertencer a uma bancada só.</span>
				</blockquote>
			</div>
		</section>
	</main>

	<SiteFooter rightText="CONHECIMENTO EM SINAL" />
</BaseLayout>
