---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StatusGrid from "../../components/StatusGrid.astro";
import Tag from "../../components/Tag.astro";
import { getProject } from "../../data/projects";

const project = getProject("inverter-modbus-lib");
if (!project?.page) throw new Error("Dados do projeto InverterModbusLib não encontrados.");
const page = project.page;
const currentStatus = [
	["BIBLIOTECA BASE", "FUNCIONAL", "ok"], ["MAPS / DESCRIPTORS", "EM EXPANSÃO", "progress"],
	["getGridFrequency()", "VALIDADO EM HARDWARE", "ok"], ["getActivePower()", "VALIDADO EM HARDWARE", "ok"],
	["getRatedPower()", "VALIDADO EM HARDWARE", "ok"], ["getSerialNumber()", "VALIDADO EM HARDWARE", "ok"],
	["setPowerLimit()", "EM DESENVOLVIMENTO / VALIDAÇÃO", "progress"], ["setPowerLimitPercent()", "EM DESENVOLVIMENTO / VALIDAÇÃO", "progress"],
	["BARRAMENTO NÃO BLOQUEANTE", "IMPLEMENTADO / EM TESTES", "progress"], ["3 INVERSORES NO MESMO BUS", "VALIDADO EM BANCADA", "ok"],
	["ESP32", "OBJETIVO DE COMPATIBILIDADE", "future"], ["EXPORT LIMIT MULTI-INVERSOR", "PLANEJADO", "future"],
];
---

<BaseLayout title="InverterModbusLib — Galeria -2048" description={page.subtitle} image={project.image} keywords={project.keywords}>
	<style is:global>
		body{background:radial-gradient(circle at 80% 10%,rgba(0,217,255,.055),transparent 520px),linear-gradient(rgba(255,255,255,.014) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.014) 1px,transparent 1px),var(--bg);background-size:auto,42px 42px,42px 42px,auto;font-family:Arial,Helvetica,sans-serif}.hero{padding:100px 0 75px}.code,.section-label,.event-year{color:var(--programacao);font:.875rem/1.5 monospace;letter-spacing:.08em}h1{max-width:1120px;margin:25px 0 0;font-size:clamp(3.7rem,9.6vw,8rem);line-height:.82;letter-spacing:-.075em}.subtitle{max-width:850px;margin-top:38px;color:var(--muted);font-size:clamp(1.2rem,2vw,1.6rem);line-height:1.55}.tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}.status{margin-top:55px}
		.hero-visual{margin:0;border:1px solid var(--line);background:var(--surface)}.hero-visual img{display:block;width:100%;height:clamp(340px,54vw,680px);object-fit:contain}.hero-visual figcaption{padding:12px 15px;border-top:1px solid var(--line);color:var(--muted);font:.875rem/1.5 monospace}.content{padding:100px 0;border-bottom:1px solid var(--line)}.section-grid{display:grid;grid-template-columns:235px minmax(0,1fr);gap:75px}h2{max-width:900px;margin:0 0 35px;font-size:clamp(2.2rem,5vw,4.4rem);line-height:.96;letter-spacing:-.05em}h3{margin:34px 0 14px;font-size:1.45rem}.prose{max-width:780px}.prose p,.prose li{color:var(--muted);font:1.125rem/1.8 Georgia,"Times New Roman",serif}.prose p{margin:0 0 22px}.prose strong{color:var(--text)}.prose ul,.prose ol{padding-left:24px}.prose li+li{margin-top:10px}
		.layer-diagram,.bus-diagram,.control-diagram{display:grid;gap:1px;margin:40px 0;border:1px solid var(--line);background:var(--line)}.layer-diagram{max-width:780px}.layer{padding:18px 22px;background:var(--surface)}.layer strong{font:.9rem/1.5 monospace}.layer span{display:block;margin-top:6px;color:var(--muted);font:.875rem/1.5 monospace}.layer.active{border-left:2px solid var(--programacao)}.knowledge,.modbus-example{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:35px 0;border:1px solid var(--line);background:var(--line)}.knowledge article,.modbus-example div{padding:22px;background:var(--surface)}.knowledge strong,.modbus-example b{display:block;color:var(--programacao);font:.875rem/1.5 monospace}.knowledge p{margin:10px 0 0;color:var(--muted);font:1rem/1.65 Georgia,"Times New Roman",serif}.modbus-example code{display:block;margin-top:12px;color:var(--muted);font:.875rem/1.7 monospace}
		.flow-compare{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:35px 0}.flow{padding:24px;border:1px solid var(--line);background:var(--surface)}.flow b{display:block;margin-bottom:16px;font:.875rem/1.5 monospace}.flow code{color:var(--muted);font:.875rem/1.8 monospace}.flow.async{border-color:rgba(0,217,255,.5)}.bus-core{padding:22px;background:rgba(0,217,255,.05);text-align:center;font:700 .95rem/1.5 monospace}.devices{display:grid;grid-template-columns:repeat(3,1fr);gap:1px}.device{padding:22px;background:var(--surface);text-align:center}.device b,.device span{display:block;font:.875rem/1.5 monospace}.device span{margin-top:8px;color:var(--muted)}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin:35px 0;border:1px solid var(--line);background:var(--line)}.metric{padding:20px;background:var(--surface)}.metric span{color:var(--muted);font:.875rem/1.45 monospace}.metric strong{display:block;margin-top:10px;font-size:1.15rem}
		.callout{max-width:780px;margin:35px 0;padding:24px;border:1px solid var(--line);border-left:2px solid var(--programacao);background:rgba(0,217,255,.035)}.callout.warning{border-left-color:var(--automacao);background:rgba(255,138,0,.035)}.callout strong{display:block;margin-bottom:9px;font:.875rem/1.5 monospace;letter-spacing:.06em}.callout p{margin:0;color:var(--muted);font:1.0625rem/1.7 Georgia,"Times New Roman",serif}.control-row{display:grid;grid-template-columns:repeat(3,1fr);gap:1px}.control-node{padding:22px;background:var(--surface);text-align:center;font:.875rem/1.5 monospace}.control-node.primary{background:rgba(169,92,255,.06);color:var(--experimentacao)}
		.status-list{max-width:850px;border:1px solid var(--line)}.status-row{display:grid;grid-template-columns:1fr minmax(230px,.75fr);gap:20px;padding:15px 18px;border-bottom:1px solid var(--line);font:.875rem/1.5 monospace}.status-row:last-child{border-bottom:0}.status-row span:last-child{text-align:right}.status-row .ok{color:var(--eletronica)}.status-row .progress{color:var(--automacao)}.status-row .future{color:var(--experimentacao)}.timeline{border-left:1px solid var(--line);margin-top:60px}.event{position:relative;padding:0 0 48px 40px}.event:last-child{padding-bottom:0}.event::before{content:"";position:absolute;left:-5px;top:5px;width:9px;height:9px;border-radius:50%;background:var(--programacao);box-shadow:0 0 12px var(--programacao)}.event h3{margin:10px 0}.event p{max-width:700px;margin:0;color:var(--muted);font:1.0625rem/1.75 Georgia,"Times New Roman",serif}
		.project-open{padding:120px 0;text-align:center}.project-open div{margin-bottom:20px;color:var(--programacao);font:.875rem/1.5 monospace}.project-open h2{margin:auto}.project-link{display:inline-block;margin-top:35px;padding:14px 18px;border:1px solid var(--line);color:var(--text);font:700 .875rem/1.4 monospace;text-decoration:none}.project-link:hover,.project-link:focus-visible{border-color:var(--programacao);color:var(--programacao);outline:none}@media(max-width:800px){.hero{padding:70px 0 55px}.content{padding:75px 0}.section-grid{grid-template-columns:1fr;gap:30px}.knowledge,.modbus-example,.devices,.metrics,.control-row{grid-template-columns:1fr 1fr}.status-row{grid-template-columns:1fr}.status-row span:last-child{text-align:left}}@media(max-width:600px){.knowledge,.modbus-example,.devices,.metrics,.control-row,.flow-compare{grid-template-columns:1fr}h1{font-size:clamp(3rem,15vw,5rem)}}
	</style>
	<SiteHeader accent="var(--programacao)" />
	<main><div class="container">
		<section class="hero"><div class="code">{project.type} / {project.number} / MODBUS RTU</div><h1>INVERTER<br />MODBUS<br />LIB</h1><p class="subtitle">{page.subtitle}</p><div class="tags">{project.categories.map(({label,tone})=><Tag label={label} tone={tone} />)}</div><div class="status"><StatusGrid items={page.status} /></div></section>
		<figure class="hero-visual"><img src={project.image} alt="Diagrama da InverterModbusLib conectando uma API comum a três inversores no mesmo barramento" /><figcaption>Uma API comum para organizar diferenças reais entre mapas Modbus.</figcaption></figure>
		<section class="content"><div class="section-grid"><div class="section-label">01 / ORIGEM DA IDEIA</div><div class="prose"><h2>Fazer o mesmo trabalho uma vez só.</h2><p>A InverterModbusLib nasceu de necessidades práticas observadas no setor fotovoltaico. Controlar geração, limitar potência, preparar geração programada ou estudar um export limit exigia voltar aos mapas de cada equipamento.</p><p>Mesmo quando todos falavam Modbus, o trabalho se repetia: localizar registradores, confirmar tipos, unidades, escalas, ordem de palavras e regras de escrita. A biblioteca começou como uma forma de <strong>organizar esse conhecimento e reutilizá-lo</strong>.</p></div></div></section>
		<section class="content"><div class="section-grid"><div class="section-label">02 / O PROBLEMA</div><div><h2>Modbus é comum. Os mapas não.</h2><div class="prose"><p>O protocolo define como pedir e transportar dados. Ele não obriga fabricantes diferentes a colocar a mesma grandeza no mesmo endereço ou representá-la da mesma forma.</p></div><div class="modbus-example"><div><b>FABRICANTE A</b><code>potência → endereço X<br />escala → × 0,1<br />tipo → int32</code></div><div><b>FABRICANTE B</b><code>potência → endereço Y<br />escala → × 1<br />tipo → uint32</code></div><div><b>FABRICANTE C</b><code>outro endereço<br />outra ordem de words<br />regra especial</code></div></div><div class="prose"><p>Também podem mudar quantidade de registradores, sinal, código de função, permissões, offsets e comportamento conforme modelo ou firmware. A página não reproduz mapas proprietários: documenta a abstração criada para lidar com essas diferenças.</p></div></div></div></section>
		<section class="content"><div class="section-grid"><div class="section-label">03 / A SOLUÇÃO</div><div><h2>Separar o que o inversor é de onde seus dados estão.</h2><div class="layer-diagram"><div class="layer active"><strong>APLICAÇÃO</strong><span>pede potência, frequência, identificação ou controle</span></div><div class="layer"><strong>INVERTER API</strong><span>interface comum usada pelo sketch</span></div><div class="layer"><strong>DESCRIPTOR / MAP / FEATURES</strong><span>modelo, capacidades, campos e regras</span></div><div class="layer"><strong>INVERTER MODBUS BUS</strong><span>arbitragem e transação Modbus RTU</span></div><div class="layer"><strong>RS485 / INVERSOR REAL</strong><span>equipamento e mapa específicos</span></div></div><div class="prose"><p>A aplicação trabalha com funções como <code>getActivePower()</code> e <code>getGridFrequency()</code>. Endereço, escala e interpretação ficam abaixo dessa interface.</p></div></div></div></section>
		<section class="content"><div class="section-grid"><div class="section-label">04 / MAPS E DESCRIPTORS</div><div><h2>Onde o conhecimento fica.</h2><div class="knowledge"><article><strong>DESCRIPTOR</strong><p>Descreve topologia, conexão, fases, potência nominal, configuração padrão, strings, MPPTs e capacidades.</p></article><article><strong>MAP</strong><p>Organiza endereço, tipo, comprimento, stride, escala, acesso e modo de tratamento.</p></article><article><strong>FEATURE</strong><p>Agrupa identificação, controle, potência, export limit, rede, energia, strings, bateria, EPS, diagnóstico e status.</p></article></div><div class="prose"><p>O <code>Handler</code> fica reservado a exceções reais. Um campo pode indicar tratamento simples ou especial e selecionar um handler específico.</p><h3>API real da branch ativa</h3><p><code>InverterRequestStatus status = inverter.getActivePower(activePower);</code></p><p>A chamada retorna estados intermediários e finais. A operação pode estar ocupada, concluída, em erro ou rejeitada; a aplicação continua executando e consulta novamente no loop.</p></div></div></div></section>
		<section class="content"><div class="section-grid"><div class="section-label">05 / EVOLUÇÃO TÉCNICA</div><div><h2>Do bloqueante ao não bloqueante.</h2><div class="prose"><p>As primeiras versões usavam uma abordagem direta: enviar, esperar e só então continuar. Isso atende testes pequenos, mas disputa tempo com Wi‑Fi, servidor web, LEDs, diagnóstico e lógica de controle.</p></div><div class="flow-compare"><div class="flow"><b>MODELO BLOQUEANTE</b><code>envia request<br />↓<br />espera resposta<br />↓<br />continua</code></div><div class="flow async"><b>MODELO NÃO BLOQUEANTE</b><code>envia request<br />↓<br />continua Wi‑Fi / web / LEDs<br />↓<br />bus.task()<br />↓<br />atualiza o estado</code></div></div></div></div></section>
		<section class="content"><div class="section-grid"><div class="section-label">06 / ARQUITETURA ASSÍNCRONA</div><div><h2>Um barramento, vários inversores.</h2><div class="prose"><p>Um <code>InverterModbusBus</code> representa o barramento compartilhado. Vários objetos <code>Inverter</code> podem usá-lo, mas apenas uma transação ocupa o RS485 por vez. Pedidos concorrentes são arbitrados e podem ser rejeitados para nova tentativa.</p><p>O barramento físico continua serial. O ganho é não congelar a aplicação inteira durante a espera.</p></div><div class="bus-diagram"><div class="bus-core">ESP8266 · INVERTER MODBUS BUS · RS485</div><div class="devices"><div class="device"><b>INVERTER #1</b><span>ID 1</span></div><div class="device"><b>INVERTER #2</b><span>ID 2</span></div><div class="device"><b>INVERTER #3</b><span>ID 3</span></div></div></div><div class="callout"><strong>COMPATIBILIDADE DE PLATAFORMA</strong><p>O estado confirmado atualmente é ESP8266. Tornar a biblioteca compatível e validada no ESP32 é um dos objetivos; referências antecipadas a ESP32 no repositório não são tratadas aqui como validação concluída.</p></div></div></div></section>
		<section class="content"><div class="section-grid"><div class="section-label">07 / TESTE DE BANCADA</div><div><h2>Três inversores no mesmo RS485.</h2><div class="prose"><p>O sketch de validação usa ESP8266, ponto de acesso Wi‑Fi, página local em <code>192.168.4.1</code>, três objetos no mesmo barramento e leituras sequenciais. Um heartbeat alterna o LED aproximadamente a cada 250 ms para evidenciar que o loop permanece ativo.</p></div><div class="devices"><div class="device"><b>SIW500H_ST030_M3</b><span>Modbus ID 1</span></div><div class="device"><b>SIW400G_T100_W0</b><span>Modbus ID 2</span></div><div class="device"><b>SIW400G_T100_W0</b><span>Modbus ID 3</span></div></div><div class="metrics"><div class="metric"><span>FREQUÊNCIA</span><strong>VALIDADA</strong></div><div class="metric"><span>POTÊNCIA ATIVA</span><strong>VALIDADA</strong></div><div class="metric"><span>POTÊNCIA NOMINAL</span><strong>VALIDADA</strong></div><div class="metric"><span>SERIAL NUMBER</span><strong>VALIDADO, NÃO EXPOSTO</strong></div></div><div class="prose"><p>O painel mantém contadores de sucessos, falhas, timeouts e rejeições por operação. Assim, “não funcionou” deixa de ser um único estado e passa a carregar contexto para o diagnóstico.</p></div></div></div></section>
		<section class="content"><div class="section-grid"><div class="section-label">08 / EXPORT LIMIT</div><div><h2>Quando controlar um inversor não é suficiente.</h2><div class="prose"><p>O objetivo futuro central é usar a biblioteca como base de um controlador de exportação para dois ou mais inversores. Um medidor informa a potência no ponto de conexão; o controlador calcula a redução, distribui limites, envia comandos, confirma respostas e repete o ciclo.</p></div><div class="control-diagram"><div class="control-row"><div class="control-node">REDE / MEDIDOR</div><div class="control-node primary">CONTROLADOR</div><div class="control-node">DIAGNÓSTICO / WEB</div></div><div class="control-row"><div class="control-node">INVERSOR A</div><div class="control-node">INVERSOR B</div><div class="control-node">INVERSOR C</div></div></div><div class="prose"><p>A distribuição ainda precisa definir proporção pela potência nominal, prioridades, limites, equipamentos offline, comandos rejeitados e estabilidade. Por isso <code>getRatedPower()</code> importa: inversores de 30 kW e 100 kW não necessariamente devem receber o mesmo limite absoluto.</p><p>A mesma abstração pode apoiar geração programada — por exemplo, 30% às 08:00, 60% às 10:00 e 100% ao meio-dia — mas esse módulo ainda não está concluído.</p></div></div></div></section>
		<section class="content"><div class="section-grid"><div class="section-label">09 / ESTADO ATUAL</div><div><h2>O que já funciona.</h2><div class="status-list">{currentStatus.map(([name,status,tone])=><div class="status-row"><span>{name}</span><span class={tone}>{status}</span></div>)}</div></div></div></section>
		<section class="content"><div class="section-grid"><div class="section-label">10 / PRÓXIMOS PASSOS</div><div><h2>Transformar abstração em controle.</h2><div class="prose"><ol><li>Finalizar a validação de <code>setPowerLimit()</code> e <code>setPowerLimitPercent()</code>.</li><li>Ampliar maps e descriptors e validar mais modelos em hardware.</li><li>Aprimorar diagnóstico e recuperação após timeout ou falha.</li><li>Portar, compilar e validar a arquitetura no ESP32.</li><li>Desenvolver o controlador de export limit multi-inversor.</li><li>Estudar distribuição proporcional, prioridades e estabilidade.</li><li>Manter exemplos e documentação por modelo.</li></ol></div><div class="timeline">{page.timeline.map((entry)=><article class="event"><div class="event-year">{entry.year}</div><h3>{entry.title}</h3><p>{entry.text}</p></article>)}</div></div></div></section>
		<section class="content"><div class="section-grid"><div class="section-label">11 / CUIDADOS E LIMITAÇÕES</div><div class="prose"><h2>Projeto aberto.</h2><ul><li>A biblioteca está em fase alpha e não é um produto certificado.</li><li>Mapas podem variar por fabricante, modelo, firmware, região e permissões.</li><li>Funções de escrita devem ser validadas cuidadosamente em bancada.</li><li>Controle de potência interfere na operação real do sistema.</li><li>Teste de bancada não equivale a validação completa em campo.</li><li>Não existe garantia universal de compatibilidade.</li></ul><div class="callout warning"><strong>ESCRITAS MODBUS</strong><p><code>setPowerLimit()</code> e <code>setPowerLimitPercent()</code> permanecem em desenvolvimento e validação. Não são apresentadas como prontas para uso irrestrito em campo.</p></div></div></div></section>
		<section class="project-open"><div>[ PROJETO ABERTO ]</div><h2>O objetivo não é esconder as diferenças entre os inversores. É organizá-las para que não precisem ser resolvidas novamente em cada projeto.</h2><a class="project-link" href="https://github.com/akioShaolin/InverterModbusLib/tree/refactor/nonblocking-modbus" target="_blank" rel="noreferrer">VER BRANCH NO GITHUB ↗</a></section>
	</div></main>
	<SiteFooter rightText={`${project.type} / ${project.number}`} />
</BaseLayout>
