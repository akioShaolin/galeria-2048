---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StatusGrid from "../../components/StatusGrid.astro";
import Tag from "../../components/Tag.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import ImageLightbox from "../../components/ImageLightbox.astro";
import { getProject } from "../../data/projects";

const project = getProject("controle-iluminacao-bancada");
if (!project?.page) throw new Error("Dados do projeto Controle de Iluminação da Bancada não encontrados.");
const page = project.page;

const firstDocumentation = [
	{ part: "PARTE 1", title: "Testes iniciais", text: "Fontes e fitas de LED foram verificadas antes da integração com o NodeMCU e a placa de potência.", images: [{ src: "/images/controle-iluminacao-bancada/infinity-light-teste-fita.webp", alt: "Rolo de fita de LED aceso durante um teste inicial com fonte de 12 volts", caption: "Teste inicial da fita de LED e da fonte, antes da integração com o controle eletrônico.", variant: "portrait" }] },
	{ part: "PARTE 2", title: "PWM com 555", text: "Um temporizador 555 simulou o PWM que depois seria produzido pelo sistema embarcado e aplicado ao driver de MOSFET.", images: [{ src: "/images/controle-iluminacao-bancada/infinity-light-pwm-555.webp", alt: "Fita de LED, protoboard com temporizador 555 e fonte durante o teste de PWM", caption: "Protótipo em protoboard usado para verificar o controle de brilho por PWM com um temporizador 555.", variant: "portrait" }] },
	{ part: "PARTE 3", title: "Design no Fritzing", text: "O desenho da placa ajudou a lidar com pouco espaço, reduzir erros e sair da protoboard e da fiação solta.", images: [{ src: "/images/controle-iluminacao-bancada/infinity-light-esquema-fritzing.webp", alt: "Esquema elétrico histórico do controlador desenhado no Fritzing", caption: "Esquema elétrico elaborado no Fritzing como referência para a etapa de montagem.", fit: "contain" }, { src: "/images/controle-iluminacao-bancada/infinity-light-design-placa.webp", alt: "Desenho histórico da distribuição dos componentes e ligações da placa", caption: "Design final registrado em 2023 para organizar os componentes na placa de prototipagem.", fit: "contain" }] },
	{ part: "PARTE 4", title: "Placa ilhada", text: "A montagem em placa de prototipagem exigiu alterações por erros iniciais e diferenças entre o desenho e os componentes reais.", images: [{ src: "/images/controle-iluminacao-bancada/infinity-light-placa-frente.webp", alt: "Frente da placa de potência montada em placa de prototipagem com NodeMCU", caption: "Frente da primeira placa de potência, montada manualmente em placa ilhada.", variant: "portrait" }, { src: "/images/controle-iluminacao-bancada/infinity-light-placa-verso.webp", alt: "Verso soldado da placa de potência montada manualmente", caption: "Verso da montagem: as conexões soldadas registram também as limitações dessa primeira execução.", variant: "portrait" }] },
];
---

<BaseLayout title="Controle de Iluminação da Bancada — Galeria -2048" description={page.subtitle} image={project.image} keywords={project.keywords}>
	<style is:global>
		body { background: radial-gradient(circle at 82% 8%, rgba(255,138,0,.045), transparent 540px), linear-gradient(rgba(255,255,255,.014) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.014) 1px, transparent 1px), var(--bg); background-size: auto, 42px 42px, 42px 42px, auto; font-family: Arial, Helvetica, sans-serif; }
		.hero { padding: 100px 0 75px; }
		.code, .section-label, .note-label, .event-part { color: var(--automacao); font-family: monospace; font-size: .875rem; line-height: 1.5; letter-spacing: .08em; }
		h1 { max-width: 1120px; margin: 25px 0 0; font-size: clamp(3.5rem, 9vw, 7.4rem); line-height: .86; letter-spacing: -.07em; }
		.subtitle { max-width: 850px; margin-top: 38px; color: var(--muted); font-family: Georgia, "Times New Roman", serif; font-size: clamp(1.2rem, 2vw, 1.6rem); line-height: 1.6; }
		.tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
		.status { margin-top: 55px; }
		.status .status-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
		.content { padding: 95px 0; border-bottom: 1px solid var(--line); }
		.section-grid { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 75px; }
		h2 { max-width: 900px; margin: 0 0 35px; font-size: clamp(2.2rem, 5vw, 4.3rem); line-height: .96; letter-spacing: -.05em; }
		h3 { margin: 42px 0 18px; font-size: clamp(1.35rem, 2.5vw, 2rem); line-height: 1.15; }
		.prose { max-width: 780px; }
		.prose p, .prose li { color: var(--muted); font-family: Georgia, "Times New Roman", serif; font-size: 1.125rem; line-height: 1.8; }
		.prose p { margin: 0 0 22px; }
		.prose strong { color: var(--text); }
		.prose a:not(.document-link) { color: var(--programacao); text-underline-offset: 4px; }
		.prose a:not(.document-link):hover, .prose a:not(.document-link):focus-visible { color: var(--text); }
		.prose ul { padding-left: 24px; }
		.prose li + li { margin-top: 10px; }
		.callout { margin: 36px 0; padding: 28px; border: 1px solid var(--line); border-left: 2px solid var(--automacao); background: rgba(255,138,0,.025); }
		.callout p:last-child { margin-bottom: 0; }
		.archive-grid, .tech-grid, .future-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 38px 0; border: 1px solid var(--line); background: var(--line); }
		.archive-card, .tech-card, .future-card { padding: 25px; background: var(--surface); }
		.archive-card h3, .tech-card h3, .future-card h3 { margin: 0 0 14px; font-size: 1.2rem; }
		.archive-card p, .tech-card p, .future-card p { margin: 0; font-size: 1rem; line-height: 1.7; }
		.documentation { border-top: 1px solid var(--line); }
		.documentation-event { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 25px; padding: 28px 0; border-bottom: 1px solid var(--line); }
		.documentation-event h3 { margin: 0 0 10px; font-size: 1.25rem; }
		.documentation-event p { margin-bottom: 16px; }
		.documentation-images { margin-top: 24px; }
		.documentation-images.pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
		.documentation-images .editorial-image { margin: 0; }
		.media-placeholder { display: grid; min-height: 190px; margin-top: 22px; padding: 25px; place-content: center; border: 1px dashed var(--line); background: linear-gradient(rgba(255,255,255,.012) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.012) 1px, transparent 1px), var(--surface); background-size: 24px 24px; color: var(--muted); text-align: center; font-family: monospace; font-size: .875rem; line-height: 1.6; }
		.protocol { margin: 35px 0; padding: 30px; border: 1px solid var(--line); background: var(--surface); text-align: center; }
		.protocol code { color: var(--programacao); font-family: monospace; font-size: clamp(1.5rem, 5vw, 3.4rem); letter-spacing: .05em; }
		.document-link { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin: 35px 0; padding: 24px 26px; border: 1px solid var(--automacao); background: rgba(255,138,0,.025); color: var(--text); font-family: monospace; font-size: .9375rem; line-height: 1.5; text-decoration: none; }
		.document-link::after { content: "ABRIR PDF ↗"; flex: 0 0 auto; color: var(--automacao); font-size: .875rem; }
		.document-link:hover, .document-link:focus-visible { background: rgba(255,138,0,.075); outline: none; }
		.diagnostic-steps { margin: 38px 0; border-top: 1px solid var(--line); }
		.diagnostic-step { position: relative; padding: 28px 28px 28px 32px; border-bottom: 1px solid var(--line); background: linear-gradient(90deg, rgba(255,138,0,.035), transparent 70%); }
		.diagnostic-step::before { content: ""; position: absolute; top: 28px; bottom: 28px; left: 0; width: 2px; background: var(--automacao); }
		.diagnostic-step h3 { margin: 0 0 14px; color: var(--automacao); font-family: "Courier New", Courier, monospace; font-size: 1rem; line-height: 1.5; letter-spacing: .07em; text-transform: uppercase; }
		.diagnostic-step p { margin-bottom: 0; }
		.current-placeholders { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 38px; }
		.current-placeholders .media-placeholder { margin-top: 0; min-height: 240px; }
		.current-placeholders .editorial-image { margin: 0; }
		@media (max-width: 800px) { .hero { padding: 70px 0 55px; } .content { padding: 70px 0; } .section-grid { grid-template-columns: 1fr; gap: 28px; } .status .status-grid, .archive-grid, .tech-grid, .future-grid, .current-placeholders, .documentation-images.pair { grid-template-columns: 1fr; } .documentation-event { grid-template-columns: 1fr; gap: 8px; } .document-link { align-items: flex-start; flex-direction: column; } }
	</style>

	<SiteHeader accent="var(--automacao)" />
	<main>
		<section class="hero"><div class="container">
			<p class="code">[ PROJETO / 008 / ORIGEM: INFINITY LIGHT ]</p>
			<h1>CONTROLE DE<br />ILUMINAÇÃO<br />DA BANCADA</h1>
			<p class="subtitle">{page.subtitle}</p>
			<div class="tags">{project.categories.map((category) => <Tag label={category.label} tone={category.tone} />)}</div>
			<div class="status"><StatusGrid items={page.status} /></div>
		</div></section>

		<section class="content"><div class="container section-grid"><p class="section-label">01 / ORIGEM EM 2023</p><div class="prose">
			<h2>ANTES DA BANCADA, O QUARTO.</h2>
			<p>O projeto nasceu em 2023 com o nome <strong>Infinity Light</strong>. A ideia era iluminar o quarto com fitas de LED brancas controladas por ESP8266/NodeMCU. Um pino geraria PWM, um driver acionaria o MOSFET e o brilho seria ajustado pelo celular via Wi-Fi.</p>
			<p>O plano era mais ambicioso que a versão atual: três fileiras, cada uma com seu ESP, um controlador principal, comandos distribuídos e agendamento. A intenção também era reaproveitar o que já existia em casa e comprar apenas fitas, fontes, ESPs e componentes indispensáveis.</p>
			<EditorialImage src="/images/controle-iluminacao-bancada/infinity-light-planejamento.jpg" alt="Mapa original de planejamento financeiro, executivo e técnico do Infinity Light" caption="Arquivo histórico de 2023: o planejamento do Infinity Light dividido entre recursos financeiros, execução e objetivos." eager={true} fit="contain" />
			<div class="archive-grid"><article class="archive-card"><h3>05/04/2023</h3><p>Compra inicial estimada em R$ 316,15: três fontes 12 V / 5 A, três NodeMCU ESP8266 e fitas de LED.</p></article><article class="archive-card"><h3>22/05/2023</h3><p>Conectores do tipo Wago: aproximadamente R$ 38,09. O planejamento também previa driver e MOSFET IRFZ44N.</p></article></div>
		</div></div></section>

		<section class="content"><div class="container section-grid"><p class="section-label">02 / PRIMEIRA EXECUÇÃO</p><div class="prose">
			<h2>FUNCIONAVA, MAS NÃO ESTAVA SEGURO.</h2>
			<p>A primeira instalação chegou a usar aproximadamente 13 metros de fita de LED no perímetro do quarto, alimentados por duas fontes de 12 V / 5 A associadas em paralelo. A iluminação era bonita e cumpria o objetivo visual, mas as fontes não dividiam a carga de maneira estável.</p>
			<p>Os ajustes de tensão eram ligeiramente diferentes: uma fonte trabalhava e aquecia mais que a outra. Eu precisava reajustar manualmente os trimpots de tempos em tempos. Uma das fontes chegou a estourar e precisou ser substituída.</p>
			<EditorialImage src="/images/controle-iluminacao-bancada/infinity-light-fontes.webp" alt="Duas fontes de 12 volts instaladas sobre uma placa de madeira durante a primeira execução do Infinity Light" caption="As duas fontes de 12 V / 5 A da instalação original. O registro documenta uma solução improvisada e não deve ser entendido como recomendação técnica." fit="contain" />
			<EditorialImage src="/images/controle-iluminacao-bancada/infinity-light-quarto.webp" alt="Fita de LED branca instalada no perímetro superior do quarto" caption="A iluminação percorria aproximadamente 13 metros do perímetro do quarto e produzia o resultado visual pretendido." variant="portrait" fit="contain" />
			<p>A solução também mantinha fontes presas a uma placa de madeira, fios expostos, alimentação direta pela tomada e nenhum interruptor adequado. Esse arranjo é preservado como evidência histórica, <strong>não como recomendação de montagem</strong>.</p>
			<div class="callout"><p class="note-label">SEGURANÇA</p><p>Fontes conectadas à rede e associações em paralelo exigem projeto, proteções e componentes adequados. A execução de 2023 funcionava, mas não era uma instalação madura ou segura.</p></div>
		</div></div></section>

		<section class="content"><div class="container section-grid"><p class="section-label">03 / PRIMEIRA DOCUMENTAÇÃO</p><div class="prose">
			<h2>SETE PARTES, E UMA DIFICULDADE MAIOR.</h2>
			<p>Os vídeos antigos foram usados apenas como fonte histórica. Para manter a Galeria leve, esta página preserva quadros representativos em WebP, sem incorporar os arquivos de vídeo completos.</p>
			<div class="documentation">{firstDocumentation.map((item) => <article class="documentation-event"><p class="event-part">{item.part}</p><div><h3>{item.title}</h3><p>{item.text}</p><div class:list={["documentation-images", { pair: item.images.length > 1 }]}>{item.images.map((image) => <EditorialImage {...image} />)}</div></div></article>)}</div>
			<h3>Parte 5 — aprendizados</h3>
			<p>A revisão dessa etapa deixou um conjunto de aprendizados que ia além do circuito:</p>
			<ul>
				<li><strong>Consistência:</strong> manter regularidade torna possível atravessar a fase difícil do começo.</li>
				<li><strong>Gerenciamento de recursos:</strong> organizar componentes e registrar uma sequência de montagem teria reduzido o tempo perdido.</li>
				<li><strong>Tempo:</strong> saber usá-lo pode decidir se uma ideia permanece possível.</li>
				<li><strong>Espaço:</strong> uma área de trabalho organizada evita retrabalho e perda de materiais.</li>
				<li><strong>Testar antes de replicar:</strong> montar três placas antes de validar a primeira multiplicou correções que poderiam ter sido feitas uma única vez.</li>
				<li><strong>Técnicas de soldagem:</strong> temperatura do ferro, proteção das ilhas e uso correto do estanho precisavam ser tratados como parte do processo.</li>
				<li><strong>Planejamento:</strong> se eu não explicar o que estou fazendo, ninguém entende — nem mesmo eu.</li>
			</ul>
			<p>A documentação não era decoração; era parte do projeto.</p>
			<h3>Parte 6 — planejamento</h3>
			<p>Planejar começou a consumir tempo. Eu estava mais acostumado com ferramentas técnicas e vetoriais do que com interfaces gráficas como o Canva. A tentativa de organizar eixos financeiros, executivos e criativos deixou claro que planejamento também era trabalho.</p>
			<EditorialImage src="/images/controle-iluminacao-bancada/infinity-light-planejamento-detalhes.jpg" alt="Trecho do planejamento do Infinity Light exibido em um celular" caption="Planejamento de produtos, fornecedores, agendamentos e possibilidades do Infinity Light." variant="portrait" fit="contain" />
			<h3>Parte 7 — nome e interrupção</h3>
			<p>O nome Infinity Light surgiu enquanto trabalho, consertos, banda e outros compromissos mudavam as prioridades. As próximas etapas já não envolviam apenas montar: incluíam ferramentas, tempo, identidade visual e uma maneira de explicar o processo. Executar parecia mais fácil do que planejar e documentar.</p>
		</div></div></section>

		<section class="content"><div class="container section-grid"><p class="section-label">04 / O APRENDIZADO REAL</p><div class="prose">
			<h2>O PROJETO QUE AJUDOU A REVELAR A NECESSIDADE DA GALERIA.</h2>
			<p>O projeto não parou porque deixou de fazer sentido. Ele parou porque ainda faltava método. Faltava transformar execução em registro, tentativa em documentação e ideia em projeto comunicável.</p>
			<p>Tempo e espaço também eram recursos. Testar a primeira placa antes de replicar, registrar alterações, explicar escolhas e praticar soldagem eram tão importantes quanto fazer a fita acender. Esse incômodo ajudou a formar a ideia da Galeria -2048 como lugar para preservar projetos, erros e evolução técnica.</p>
		</div></div></section>

		<section class="content"><div class="container section-grid"><p class="section-label">05 / TRÊS ANOS DEPOIS</p><div class="prose">
			<h2>DO QUARTO À BANCADA.</h2>
			<p>Três anos depois, o escopo mudou. A iluminação que antes era pensada para o quarto passou a servir à bancada onde hoje acontecem montagens, testes, consertos e estudos.</p>
			<p>A própria bancada foi construída com madeira, pallets, bobinas de cabo e uma estrutura funcional reaproveitada. A nova versão é menor que a ideia original, mas muito mais coerente com a rotina atual.</p>
			<div class="current-placeholders"><EditorialImage src="/images/controle-iluminacao-bancada/bancada-crua.webp" alt="Estrutura inicial da bancada feita com bobinas de cabo e tampo de madeira reaproveitado" caption="A bancada nasceu de materiais reaproveitados, antes mesmo da iluminação ganhar sua forma final." fit="contain" /><EditorialImage src="/images/controle-iluminacao-bancada/parafusos-e-conexoes.webp" alt="Detalhe da estrutura lateral ajustável, parafusos, perfil e fita de LED" caption="Detalhe da estrutura ajustável e da fita de LED instalada no perfil." fit="contain" /></div>
			<h3>Resultado atual</h3>
			<EditorialImage src="/images/controle-iluminacao-bancada/bancada-pronta.webp" alt="Bancada de trabalho pronta com a estrutura superior e a iluminação de LED ligada" caption="A versão atual do projeto: a ideia original de iluminação passou a servir a bancada de trabalho." fit="contain" />
		</div></div></section>

		<section class="content"><div class="container section-grid"><p class="section-label">06 / VERSÃO ATUAL</p><div class="prose">
			<h2>UM SISTEMA SIMPLES E EXPANSÍVEL.</h2>
			<p>O controlador atual usa ESP8266/NodeMCU, PWM no pino D2/GPIO4, driver com transistores BC548, IRFZ44N como chave low-side da fita de 12 V e um conversor buck para alimentar o ESP. A interface web embarcada reúne configuração de Wi-Fi, mDNS, WebSocket, slider vertical, percentual editável e controle pela rolagem do mouse.</p>
			<p>O firmware trabalha com PWM de 14 bits a 1 kHz. Uma curva gamma de 2,2 aproxima o ajuste elétrico da percepção visual do brilho, enquanto o último percentual é preservado na EEPROM após alguns segundos sem nova alteração.</p>
			<div class="tech-grid"><article class="tech-card"><h3>PWM</h3><p>Varia a potência por chaveamento, evitando o desperdício típico de um controle linear simples.</p></article><article class="tech-card"><h3>Driver de MOSFET</h3><p>Transforma o sinal lógico do ESP em acionamento adequado do transistor de potência.</p></article><article class="tech-card"><h3>WebSocket</h3><p>Mantém a troca de comandos entre interface e controlador em tempo real.</p></article><article class="tech-card"><h3>Curva gamma</h3><p>Compensa a diferença entre duty cycle e a maneira não linear como percebemos brilho.</p></article></div>
			<div class="protocol"><p class="note-label">PROTOCOLO COMUM</p><code>SET:0 → SET:100</code></div>
			<p>A página web e futuros controles físicos usam o mesmo comando lógico. Essa pequena decisão reduz acoplamento e permite expandir a interface sem reescrever o controle de potência.</p>
			<EditorialImage src="/images/controle-iluminacao-bancada/interface-web.webp" alt="Interface web do Infinity Light aberta em um celular e conectada ao ESP8266" caption="Interface web embarcada usada para configurar e controlar a iluminação da bancada." variant="portrait" fit="contain" />
		</div></div></section>

		<section class="content"><div class="container section-grid"><p class="section-label">07 / DIAGNÓSTICO</p><div class="prose">
			<h2>DIAGNÓSTICO E EVOLUÇÃO DO DRIVER.</h2>
			<p>O driver MOSFET foi uma das partes centrais da retomada. A ideia parecia simples: usar o PWM de 3,3 V do ESP8266 para controlar uma carga de LED em 12 V. Na bancada, porém, o acionamento do gate, a alimentação do ESP, os valores dos resistores e até o estado real do MOSFET interferiram no resultado.</p>
			<div class="diagnostic-steps">
				<article class="diagnostic-step"><h3>01 / Acionamento mais forte</h3><p>O resistor de pull-up do estágio de acionamento foi reduzido para <strong>120 Ω</strong>. O valor anterior limitava a corrente disponível para carregar o gate do MOSFET, deixando o chaveamento fraco. O pull-up do primeiro estágio também foi alterado para <strong>4,7 kΩ</strong>, tornando o sinal vindo do ESP8266 mais previsível durante o PWM.</p></article>
				<article class="diagnostic-step"><h3>02 / Alimentação por conversor buck</h3><p>A proposta inicial usava um regulador linear AMS1117 para obter a alimentação do NodeMCU a partir dos 12 V. Com o consumo do ESP8266 — especialmente durante a atividade de Wi-Fi — a dissipação térmica ficava alta demais. A substituição por um conversor buck de 12 V para 5 V tornou essa alimentação mais eficiente e estável.</p></article>
				<article class="diagnostic-step"><h3>03 / Um estágio a menos</h3><p>A revisão mostrou que um dos transistores previstos na versão anterior não era necessário para a função desejada. O circuito foi simplificado para manter somente os estágios necessários à adaptação do PWM e ao acionamento do gate. A versão atual é mais direta e mais fácil de analisar, mas continua documentada como protótipo experimental.</p></article>
				<article class="diagnostic-step"><h3>04 / O MOSFET também estava danificado</h3><p>As tensões medidas não correspondiam ao comportamento esperado: aparecia uma queda estranha no caminho do gate, como se o IRFZ44N estivesse carregando indevidamente o driver. Ao remover o MOSFET, o estágio passou a se comportar de outra forma; ao substituí-lo por outro IRFZ44N, o acionamento voltou a funcionar. O defeito, portanto, não estava apenas na topologia do driver: havia também um componente danificado distorcendo as medições.</p></article>
			</div>
			<p>Esse diagnóstico foi um lembrete útil: nem todo problema está no firmware ou no esquema. Um componente defeituoso pode mudar completamente aquilo que se observa na bancada.</p>
			<a class="document-link" href="/docs/infinity-light-driver-mosfet.pdf" target="_blank" rel="noreferrer"><span><strong>Esquemático: Infinity Light — Driver MOSFET</strong><br />Revisão 2.0 — ESP8266, BC548, IRFZ44N, buck e carga de 12 V.</span></a>
			<div class="callout"><p class="note-label">ESTADO DO DOCUMENTO</p><p>O PDF registra a versão atual do circuito e serve como referência de projeto. Não representa certificação, produto comercial ou instrução pronta para reprodução.</p></div>
		</div></div></section>

		<section class="content"><div class="container section-grid"><p class="section-label">08 / PRÓXIMOS PASSOS</p><div class="prose">
			<h2>MENOS IMPROVISO, MAIS USO.</h2>
