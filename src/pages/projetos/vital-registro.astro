---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StatusGrid from "../../components/StatusGrid.astro";
import Tag from "../../components/Tag.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import ImageLightbox from "../../components/ImageLightbox.astro";
import { getProject } from "../../data/projects";

const project = getProject("vital-registro");
if (!project?.page) throw new Error("Dados do VitalRegistro não encontrados.");
const page = project.page;

const buildFacts = [
	["KERNEL COLAB", "Python 3.13.16"],
	["PYTHON DE BUILD", "CPython 3.14.7"],
	["PYTHON NO APK", "3.14.2"],
	["ANDROID", "API 36 · mínimo 24"],
	["NDK", "r29"],
	["ABI", "arm64-v8a"],
];

const validation = [
	["66 TESTES DE LÓGICA", "APROVADOS", "ok"],
	["COMPILEALL E AUDITORIA DO REPOSITÓRIO", "APROVADOS", "ok"],
	["SMOKE DESKTOP DOS TRÊS TIPOS", "APROVADO", "ok"],
	["CAPTURAS ANDROID v0.2.0", "EVIDÊNCIA VISUAL PARCIAL", "ok"],
	["VALIDAÇÃO COMPLETA EM APARELHO", "PENDENTE", "pending"],
	["ROUND-TRIP SAF REAL", "PENDENTE", "pending"],
];
---

<BaseLayout title="VitalRegistro v0.2.0 — Galeria -2048" description={project.description} image={project.image} keywords={project.keywords}>
	<style is:global>
		body{background:radial-gradient(circle at 78% 8%,rgba(0,217,255,.06),transparent 520px),linear-gradient(rgba(255,255,255,.014) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.014) 1px,transparent 1px),var(--bg);background-size:auto,42px 42px,42px 42px,auto;font-family:Arial,Helvetica,sans-serif}
		.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,380px);gap:clamp(34px,5vw,70px);align-items:center;padding:100px 0 80px}.hero>*{min-width:0}.hero-copy{min-width:0}.code,.section-label,.signal,.event time{color:var(--programacao);font:.875rem/1.5 monospace;letter-spacing:.08em}.hero h1{max-width:100%;margin:24px 0 0;font-size:clamp(3.25rem,6.8vw,7rem);line-height:.84;letter-spacing:-.075em;white-space:nowrap}.subtitle{max-width:780px;margin-top:34px;color:var(--muted);font-size:clamp(1.2rem,2vw,1.55rem);line-height:1.55}.tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.status{margin-top:45px}.hero-icon{display:grid;place-items:center;min-width:0}.hero-icon .editorial-image{width:100%;margin:0}.hero-icon .editorial-image__trigger img{height:clamp(280px,32vw,430px);object-fit:contain}
		.content{padding:100px 0;border-bottom:1px solid var(--line)}.section-grid{display:grid;grid-template-columns:230px minmax(0,1fr);gap:75px}h2{max-width:940px;margin:0 0 35px;font-size:clamp(2.2rem,5vw,4.4rem);line-height:.96;letter-spacing:-.05em}h3{margin:34px 0 14px;font-size:1.45rem}.prose{max-width:780px}.prose p,.prose li{color:var(--muted);font:1.125rem/1.8 Georgia,"Times New Roman",serif}.prose p{margin:0 0 22px}.prose strong{color:var(--text)}.prose code{color:var(--programacao);font-size:.92em}.prose ul{padding-left:24px}.prose li+li{margin-top:9px}.lead-question{margin:0 0 36px;padding-left:24px;border-left:2px solid var(--programacao);font-size:clamp(1.7rem,3vw,2.7rem)!important;line-height:1.35!important;color:var(--text)!important}
		.principles{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin:38px 0;border:1px solid var(--line);background:var(--line)}.principles strong{padding:22px;background:var(--surface);font:.875rem/1.5 monospace;text-align:center}.flow{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:38px 0;border:1px solid var(--line);background:var(--line)}.flow article{padding:24px;background:var(--surface)}.flow strong{display:block;margin-bottom:10px;color:var(--programacao);font:.875rem/1.5 monospace}.flow p{margin:0;color:var(--muted);font:1rem/1.65 Georgia,"Times New Roman",serif}.callout{max-width:800px;margin:36px 0;padding:26px;border:1px solid var(--line);border-left:2px solid var(--programacao);background:rgba(0,217,255,.035)}.callout.warning{border-left-color:var(--automacao);background:rgba(255,138,0,.035)}.callout strong{display:block;margin-bottom:10px;font:.875rem/1.5 monospace;letter-spacing:.06em}.callout p{margin:0;color:var(--muted);font:1.0625rem/1.7 Georgia,"Times New Roman",serif}
		.screenshot-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-top:42px}.screenshot-grid--two{grid-template-columns:repeat(2,minmax(0,1fr));max-width:760px}.screenshot-grid .editorial-image{margin:0}.screenshot-grid .editorial-image__trigger img{height:clamp(420px,52vw,650px);object-fit:contain}.fact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:38px 0;border:1px solid var(--line);background:var(--line)}.fact{padding:22px;background:var(--surface)}.fact span,.fact strong{display:block}.fact span{color:var(--muted);font:.875rem/1.5 monospace}.fact strong{margin-top:9px;font-size:1.08rem;line-height:1.4}.build-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:38px 0;border:1px solid var(--line);background:var(--line)}.build-grid div{padding:20px;background:var(--surface)}.build-grid span,.build-grid strong{display:block;font:.875rem/1.5 monospace}.build-grid span{color:var(--programacao)}.build-grid strong{margin-top:8px}.hash{max-width:850px;margin:35px 0;padding:24px;border:1px solid var(--line);background:var(--surface)}.hash span,.hash code{display:block;font:.875rem/1.65 monospace}.hash span{color:var(--muted)}.hash code{margin-top:10px;color:var(--text);overflow-wrap:anywhere}.validation{max-width:900px;border:1px solid var(--line)}.validation-row{display:grid;grid-template-columns:1fr minmax(220px,.7fr);gap:20px;padding:15px 18px;border-bottom:1px solid var(--line);font:.875rem/1.5 monospace}.validation-row:last-child{border-bottom:0}.validation-row span:last-child{text-align:right}.validation-row .ok{color:var(--eletronica)}.validation-row .pending{color:var(--automacao)}.timeline{border-left:1px solid var(--line)}.event{position:relative;padding:0 0 46px 38px}.event:last-child{padding-bottom:0}.event::before{content:"";position:absolute;top:5px;left:-5px;width:9px;height:9px;border-radius:50%;background:var(--programacao);box-shadow:0 0 12px var(--programacao)}.event h3{margin:8px 0 10px}.event p{max-width:720px;margin:0;color:var(--muted);font:1.0625rem/1.75 Georgia,"Times New Roman",serif}.links{display:flex;flex-wrap:wrap;gap:12px;margin-top:36px}.links a{padding:14px 18px;border:1px solid var(--line);color:var(--text);font:700 .875rem/1.4 monospace;text-decoration:none}.links a:hover,.links a:focus-visible{border-color:var(--programacao);color:var(--programacao);outline:none}.closing{padding:115px 0;text-align:center}.closing h2{margin:16px auto 0}.closing p{max-width:760px;margin:28px auto 0;color:var(--muted);font:1.125rem/1.8 Georgia,"Times New Roman",serif}
		@media(max-width:1050px){.screenshot-grid{grid-template-columns:repeat(2,1fr)}}
		@media(max-width:950px){.hero{grid-template-columns:1fr;gap:45px}.hero-icon{max-width:500px}.hero h1{font-size:clamp(3.25rem,12vw,7rem)}.principles{grid-template-columns:repeat(2,1fr)}}
		@media(max-width:800px){.hero{padding:70px 0 60px}.content{padding:75px 0}.section-grid{grid-template-columns:1fr;gap:30px}.flow,.fact-grid,.build-grid{grid-template-columns:1fr}.validation-row{grid-template-columns:1fr}.validation-row span:last-child{text-align:left}}
		@media(max-width:600px){.screenshot-grid,.principles{grid-template-columns:1fr}.screenshot-grid .editorial-image__trigger img{height:min(155vw,650px)}.hero h1{font-size:clamp(2.5rem,12vw,4.7rem);letter-spacing:-.06em}}
	</style>

	<SiteHeader accent="var(--programacao)" />
	<main><div class="container">
		<section class="hero">
			<div class="hero-copy">
				<div class="code">{project.type} / {project.number} / SOFTWARE PESSOAL</div>
				<h1>{page.code}</h1>
				<p class="subtitle">{page.subtitle}</p>
				<div class="tags">{project.categories.map(({label,tone})=><Tag label={label} tone={tone} />)}</div>
				<div class="status"><StatusGrid items={page.status} /></div>
			</div>
			<div class="hero-icon"><EditorialImage src="/images/vital-registro/icone.png" alt="Ícone do VitalRegistro com coração, traçado de pulso, aparelho de pressão, balança e relógio" caption="Ícone oficial do VitalRegistro." fit="contain" eager={true} /></div>
		</section>

		<section class="content"><div class="section-grid"><div class="section-label">01 / TUDO COMEÇOU COM UM APARELHO</div><div><div class="prose"><p>Depois de algumas semanas sentindo dores frequentes na nuca, comprei um aparelho de pressão arterial em uma farmácia. A dor foi o motivo para começar a medir; <strong>não houve diagnóstico relacionando o sintoma à pressão alta</strong>.</p><p class="lead-question">Onde eu guardo essas medições?</p><p>Eu queria registrar sistólica, diastólica, pulso, peso, data, horário e observações. Uma planilha ou um bloco de notas resolveriam a necessidade imediata. Em vez disso, decidi transformar uma pergunta pequena em um projeto de software.</p></div><EditorialImage src="/images/vital-registro/apresentacao.png" alt="Apresentação visual do VitalRegistro com ícone e telas planejadas do aplicativo" caption="Apresentação visual original do projeto. É uma composição de design, não uma captura do APK." fit="contain" variant="detail" /></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">02 / LOCAL POR ESCOLHA</div><div><h2>Uma ferramenta pequena, direta e sem servidor.</h2><div class="principles"><strong>SEM ANÚNCIOS</strong><strong>SEM CONTA</strong><strong>SEM ASSINATURA</strong><strong>SEM TELEMETRIA</strong></div><div class="prose"><p>Os registros ficam no próprio aparelho, em um banco SQLite armazenado na área privada do aplicativo. Não existe login, sincronização obrigatória ou servidor necessário para usar o VitalRegistro.</p><p>Essa escolha também tem uma consequência: perder o aparelho, limpar os dados ou desinstalar o aplicativo pode significar perder o histórico. Não há backup automático em nuvem. A exportação CSV é a forma disponível de manter uma cópia externa, e a v0.2.0 passou a permitir que essa cópia seja importada novamente.</p><div class="callout"><strong>REGISTRAR NÃO É DIAGNOSTICAR</strong><p>O VitalRegistro registra, organiza, apresenta, importa e exporta medições. Não classifica automaticamente pressão ou glicemia e não substitui avaliação profissional.</p></div></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">03 / O PRIMEIRO MODELO</div><div><h2>A v0.1.0 provou que a ideia cabia no bolso.</h2><div class="flow"><article><strong>INTERFACE / KIVY</strong><p>Formulários, histórico e gráficos em uma aplicação Python.</p></article><article><strong>PERSISTÊNCIA / SQLITE</strong><p>Registros locais, editáveis e independentes de servidor.</p></article><article><strong>ANDROID / APK</strong><p>Um build debug ARM64 instalado e usado em aparelho real.</p></article></div><div class="prose"><p>A primeira versão juntava pressão, pulso e peso no mesmo registro. Era suficiente para atravessar o caminho completo — do formulário ao SQLite, dos gráficos ao CSV e do Python ao Android — e se tornar o primeiro marco funcional.</p><p>Em 30/09/2026, instalação, inicialização, criação, persistência, histórico e um gráfico com uma medição foram confirmados no Samsung Galaxy M55 com Android 16. Essa evidência pertence à v0.1.0 e continua preservada como parte da história.</p></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">04 / O USO MUDOU O PROJETO</div><div><h2>O registro único deixou de representar a vida real.</h2><div class="prose"><p>O aplicativo começou simples e ganhou forma conforme passou a ser usado. Pressão arterial e peso nem sempre são medidos juntos; cada leitura precisava de sua própria data, horário e observação. A glicemia acrescentou outro tipo de medição e contextos como jejum, antes da refeição, após a refeição e outro.</p><p>A v0.2.0 separou os tipos. O histórico passou a reunir ou filtrar registros, e cada item ganhou detalhes, edição e exclusão individual. Data e horário continuam representando o momento da medição, mesmo quando o dado é incluído depois.</p></div><div class="screenshot-grid"><EditorialImage src="/images/vital-registro/home-v020.png" alt="Tela inicial do VitalRegistro v0.2.0" caption="Home v0.2.0: novos caminhos para exportar e importar CSV." fit="contain" /><EditorialImage src="/images/vital-registro/historico-geral-v020.png" alt="Histórico geral do VitalRegistro com pressão, peso e glicemia" caption="Histórico geral com os três tipos independentes e dados fictícios." fit="contain" /><EditorialImage src="/images/vital-registro/formulario-pressao-arterial.png" alt="Formulário específico de pressão arterial" caption="Pressão e pulso têm formulário, data, horário e observação próprios." fit="contain" /><EditorialImage src="/images/vital-registro/glicemia-contextos-de-medicao.png" alt="Formulário de glicemia com contextos de medição" caption="Glicemia em mg/dL e contextos de medição, sem interpretação clínica." fit="contain" /></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">05 / TEMPO SEM TECLADO</div><div><h2>Data e horário viraram seletores próprios.</h2><div class="prose"><p>Em vez de digitar datas, a v0.2.0 usa colunas rolantes. O valor central fica destacado, o calendário corrige dias incompatíveis com mês e ano e a mesma lógica atende hora e minuto. Isso tornou mais direto registrar hoje uma medição feita antes.</p></div><div class="screenshot-grid screenshot-grid--two"><EditorialImage src="/images/vital-registro/seletor-data-rolante.png" alt="Seletor rolante de dia, mês e ano" caption="Dia, mês e ano em colunas rolantes; dados fictícios." fit="contain" /><EditorialImage src="/images/vital-registro/seletor-horario-rolante.png" alt="Seletor rolante de hora e minuto" caption="Hora e minuto seguem a mesma interação, sem abrir o teclado." fit="contain" /></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">06 / GRÁFICOS QUE RESPONDEM</div><div><h2>Os pontos agora devolvem o contexto da medição.</h2><div class="prose"><p>Pressão, pulso, peso e glicemia podem ser vistos nos últimos 7 dias, 30 dias ou em todo o histórico. Tocar um ponto apresenta valor, data e horário; na glicemia, também aparece o contexto. Quando duas séries ocupam exatamente a mesma posição, o aplicativo pede que o usuário escolha o ponto.</p><p>As linhas apenas conectam medições. Elas não classificam valores nem inventam uma leitura clínica.</p></div><div class="screenshot-grid screenshot-grid--two"><EditorialImage src="/images/vital-registro/grafico-glicemia.png" alt="Gráfico de glicemia com múltiplas medições fictícias" caption="O novo gráfico de glicemia mostra medições separadas ao longo do tempo." fit="contain" /><EditorialImage src="/images/vital-registro/grafico-pressao-tooltip-diastolica.png" alt="Gráfico de pressão com um ponto de diastólica selecionado" caption="Ao selecionar um ponto, o rótulo apresenta série, valor, data e horário." fit="contain" /></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">07 / CSV QUE VOLTA</div><div><h2>Exportar deixou de ser uma rua de mão única.</h2><div class="prose"><p>O CSV formato 2 guarda tipo, timestamp local e um UUID permanente para cada medição. A importação lê o arquivo, valida todo o lote e apresenta uma prévia antes de alterar o banco. Duplicatas idênticas são ignoradas; conflito de UUID ou erro bloqueia o lote inteiro, sem sobrescrever registros nem fazer uma importação parcial.</p><p>A operação é aditiva: importar acrescenta registros, não sincroniza edições e exclusões. Em um dos testes visuais, um CSV com oito registros já existentes foi analisado e o aplicativo reconheceu <strong>0 novos, 8 duplicatas idênticas, 0 conflitos e 0 erros</strong>, evitando inseri-los novamente.</p></div><div class="screenshot-grid screenshot-grid--two"><EditorialImage src="/images/vital-registro/importacao-previa-34-registros.png" alt="Prévia de importação com 34 registros novos válidos" caption="Prévia antes da confirmação: 34 linhas válidas, sem duplicatas, conflitos ou erros." fit="contain" /><EditorialImage src="/images/vital-registro/importacao-8-duplicatas.png" alt="Prévia de importação que reconheceu oito duplicatas" caption="Teste com registros já presentes: oito duplicatas reconhecidas e nenhuma nova inserção proposta." fit="contain" /></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">08 / UM NOVO BANCO, NÃO UM REMENDO</div><div><h2>A mudança de modelo foi assumida por inteiro.</h2><div class="prose"><p>A v0.2.0 usa <code>vitalregistro-v2.sqlite3</code>, schema 2. Uma tabela guarda medições de tipos diferentes com UUID, timestamp e somente os campos pertinentes a cada tipo. O banco da v0.1.0 permanece intacto e provoca um aviso quando é encontrado.</p><p>Não há migração automática nem importação do CSV antigo. O histórico v2 começa separado. Em um projeto ainda jovem, criar um novo contrato de dados foi mais honesto do que esconder uma mudança grande atrás de uma conversão improvisada. Desinstalar ou limpar dados não é um procedimento de migração e pode apagar os dois históricos.</p></div><div class="callout warning"><strong>INCOMPATIBILIDADE DOCUMENTADA</strong><p>Banco e CSV v0.1.0 não entram no importador v0.2.0. A cópia antiga deve ser preservada como registro externo da primeira fase.</p></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">09 / DO PYTHON AO APK</div><div><h2>O build continuou fazendo parte da história.</h2><div class="prose"><p>A cadeia separa o Python do notebook Colab, o Python isolado que executa Buildozer e python-for-android e o Python embarcado no APK. A v0.2.0 preservou os commits fixados das ferramentas e atualizou o registro do ambiente realmente usado.</p></div><div class="build-grid">{buildFacts.map(([label,value])=><div><span>{label}</span><strong>{value}</strong></div>)}</div><EditorialImage src="/images/vital-registro/build-apk-google-colab.png" alt="Notebook do Google Colab após gerar e iniciar o download de um APK ARM64 do VitalRegistro" caption="Registro histórico do fluxo no Colab. A v0.2.0 mantém a mesma cadeia fixada e possui seu próprio build-info.json." fit="contain" variant="detail" /></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">10 / RASTREABILIDADE</div><div><h2>Qual código produziu exatamente este arquivo?</h2><div class="prose"><p>O <code>build-info.json</code> acompanha o nome, tamanho, SHA-256, ambiente e commit que originou o APK. Na v0.2.0, o binário veio do commit <code>0835bab79306bbf44bf21954dff897d4f936a562</code>. O fechamento documental aconteceu depois e não altera essa origem.</p><p>Separar o commit do build do commit final de documentação evita atribuir um binário a um código que nunca o produziu. A v0.1.0 mantém seu próprio JSON e seu próprio hash como evidência histórica independente.</p></div><div class="fact-grid"><div class="fact"><span>APK</span><strong>vitalregistro-0.2.0-arm64-v8a-debug.apk</strong></div><div class="fact"><span>TAMANHO</span><strong>26.326.438 bytes</strong></div><div class="fact"><span>COMMIT DO BUILD</span><strong>0835bab…</strong></div></div><div class="hash"><span>v0.2.0 · SHA-256 informado no build-info.json</span><code>ce8a592d5485ae328335a7e03aa9a566356fd6cf65fdbbee8410377e1158a202</code></div><div class="callout warning"><strong>DEBUG + ARM64-V8A</strong><p>O APK documentado é uma versão de desenvolvimento para ARM64. Não é um pacote de produção assinado para publicação na Google Play.</p></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">11 / EVIDÊNCIAS E LIMITES</div><div><h2>Mostrar o que existe sem transformar captura em certificado.</h2><div class="prose"><p>Em 05/10/2026, a suíte local registrou 66 testes aprovados, verificação de sintaxe, auditoria do repositório e smoke desktop com os três tipos, filtros, gráficos, importação e seletores. As capturas Android desta página usam dados fictícios autorizados e documentam estados reais da interface.</p><p>Elas não comprovam sozinhas a confirmação da importação, persistência após reinício, rollback, ergonomia de todos os gestos nem vínculo com o hash do APK. A validação completa da v0.2.0 em aparelho, incluindo round-trip real pelo Storage Access Framework, continua pendente.</p></div><div class="validation">{validation.map(([item,result,tone])=><div class="validation-row"><span>{item}</span><span class={tone}>{result}</span></div>)}</div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">12 / v0.1.0 → v0.2.0</div><div><h2>Do primeiro marco a um aplicativo moldado pelo uso.</h2><div class="timeline">{page.timeline.map((event)=><article class="event"><time>{event.year}</time><h3>{event.title}</h3><p>{event.text}</p></article>)}</div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">13 / CÓDIGO E RELEASES</div><div class="prose"><h2>Duas versões, duas etapas preservadas.</h2><p>A v0.1.0 permanece como o primeiro marco funcional. A v0.2.0 registra a evolução do modelo de dados, dos gráficos e do caminho de saída e retorno pelo CSV. Ambas continuam disponíveis para que o projeto não pareça ter nascido pronto.</p><p>O VitalRegistro continua em desenvolvimento. Intervalo personalizado nos gráficos, melhorias de acessibilidade baseadas em uso e uma validação Android completa permanecem como trabalho futuro. Sincronização ou backup em nuvem exigiriam outra decisão explícita sobre privacidade.</p><div class="links"><a href="https://github.com/akioShaolin/vital-registro" target="_blank" rel="noreferrer">CÓDIGO-FONTE ↗</a><a href="https://github.com/akioShaolin/vital-registro/releases/tag/v0.1.0" target="_blank" rel="noreferrer">RELEASE v0.1.0 ↗</a><a href="https://github.com/akioShaolin/vital-registro/releases/tag/v0.2.0" target="_blank" rel="noreferrer">RELEASE v0.2.0 ↗</a><a href="https://github.com/akioShaolin/vital-registro/blob/v0.2.0/docs/CSV.md" target="_blank" rel="noreferrer">FORMATO CSV 2 ↗</a><a href="https://github.com/akioShaolin/vital-registro/blob/v0.2.0/docs/VALIDATION.md" target="_blank" rel="noreferrer">VALIDAÇÃO ↗</a></div></div></div></section>

		<section class="closing"><div class="signal">[ IDEIAS EM SINAL ]</div><h2>O aplicativo não nasceu completo. Começou a ser usado.</h2><p>Uma necessidade pessoal atravessou banco de dados, Android e reprodutibilidade. O uso revelou limites, e os limites deram forma à versão seguinte — sem apagar o caminho que levou até ela.</p></section>
	</div></main>
	<SiteFooter rightText={`${project.type} / ${project.number}`} />
