---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StatusGrid from "../../components/StatusGrid.astro";
import Tag from "../../components/Tag.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import ImageLightbox from "../../components/ImageLightbox.astro";
import { getProject } from "../../data/projects";

const project = getProject("vital-registro");
if (!project?.page) throw new Error("Dados do VitalRegistro não encontrados.");
const page = project.page;

const buildFacts = [
	["KERNEL COLAB", "Python 3.13.15"],
	["PYTHON DE BUILD", "CPython 3.14.7"],
	["PYTHON NO APK", "3.14.2"],
	["ANDROID", "API 36 · mínimo 24"],
	["NDK", "r29"],
	["ABI", "arm64-v8a"],
];

const validation = [
	["INSTALAÇÃO E INICIALIZAÇÃO", "CONFIRMADAS", "ok"],
	["CRIAÇÃO E PERSISTÊNCIA", "CONFIRMADAS", "ok"],
	["HISTÓRICO", "CONFIRMADO", "ok"],
	["GRÁFICO COM UMA MEDIÇÃO", "CONFIRMADO", "ok"],
	["EDIÇÃO E EXCLUSÃO NO APARELHO", "PENDENTES", "pending"],
	["EXPORTAÇÃO SAF NO APARELHO", "PENDENTE", "pending"],
	["AJUSTES VISUAIS NO APK FINAL", "PENDENTES", "pending"],
];
---

<BaseLayout title="VitalRegistro — Galeria -2048" description={project.description} image={project.image} keywords={project.keywords}>
	<style is:global>
		body{background:radial-gradient(circle at 78% 8%,rgba(0,217,255,.06),transparent 520px),linear-gradient(rgba(255,255,255,.014) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.014) 1px,transparent 1px),var(--bg);background-size:auto,42px 42px,42px 42px,auto;font-family:Arial,Helvetica,sans-serif}.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,430px);gap:70px;align-items:center;padding:100px 0 80px}.code,.section-label,.signal,.event time{color:var(--programacao);font:.875rem/1.5 monospace;letter-spacing:.08em}.hero h1{margin:24px 0 0;font-size:clamp(3.6rem,9vw,8.4rem);line-height:.82;letter-spacing:-.075em}.subtitle{max-width:780px;margin-top:34px;color:var(--muted);font-size:clamp(1.2rem,2vw,1.55rem);line-height:1.55}.tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.status{margin-top:45px}.hero-icon{display:grid;place-items:center}.hero-icon .editorial-image{width:100%;margin:0}.hero-icon .editorial-image__trigger img{height:clamp(280px,35vw,430px);object-fit:contain}
		.content{padding:100px 0;border-bottom:1px solid var(--line)}.section-grid{display:grid;grid-template-columns:230px minmax(0,1fr);gap:75px}h2{max-width:940px;margin:0 0 35px;font-size:clamp(2.2rem,5vw,4.4rem);line-height:.96;letter-spacing:-.05em}h3{margin:34px 0 14px;font-size:1.45rem}.prose{max-width:780px}.prose p,.prose li{color:var(--muted);font:1.125rem/1.8 Georgia,"Times New Roman",serif}.prose p{margin:0 0 22px}.prose strong{color:var(--text)}.prose code{color:var(--programacao);font-size:.92em}.prose ul{padding-left:24px}.prose li+li{margin-top:9px}.lead-question{margin:0 0 36px;padding-left:24px;border-left:2px solid var(--programacao);font-size:clamp(1.7rem,3vw,2.7rem)!important;line-height:1.35!important;color:var(--text)!important}
		.principles{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin:38px 0;border:1px solid var(--line);background:var(--line)}.principles strong{padding:22px;background:var(--surface);font:.875rem/1.5 monospace;text-align:center}.flow{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:38px 0;border:1px solid var(--line);background:var(--line)}.flow article{padding:24px;background:var(--surface)}.flow strong{display:block;margin-bottom:10px;color:var(--programacao);font:.875rem/1.5 monospace}.flow p{margin:0;color:var(--muted);font:1rem/1.65 Georgia,"Times New Roman",serif}.callout{max-width:800px;margin:36px 0;padding:26px;border:1px solid var(--line);border-left:2px solid var(--programacao);background:rgba(0,217,255,.035)}.callout.warning{border-left-color:var(--automacao);background:rgba(255,138,0,.035)}.callout strong{display:block;margin-bottom:10px;font:.875rem/1.5 monospace;letter-spacing:.06em}.callout p{margin:0;color:var(--muted);font:1.0625rem/1.7 Georgia,"Times New Roman",serif}
		.screenshot-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-top:42px}.screenshot-grid .editorial-image{margin:0}.screenshot-grid .editorial-image__trigger img{height:clamp(420px,52vw,650px);object-fit:contain}.fact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:38px 0;border:1px solid var(--line);background:var(--line)}.fact{padding:22px;background:var(--surface)}.fact span,.fact strong{display:block}.fact span{color:var(--muted);font:.875rem/1.5 monospace}.fact strong{margin-top:9px;font-size:1.08rem;line-height:1.4}.build-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:38px 0;border:1px solid var(--line);background:var(--line)}.build-grid div{padding:20px;background:var(--surface)}.build-grid span,.build-grid strong{display:block;font:.875rem/1.5 monospace}.build-grid span{color:var(--programacao)}.build-grid strong{margin-top:8px}.hash{max-width:850px;margin:35px 0;padding:24px;border:1px solid var(--line);background:var(--surface)}.hash span,.hash code{display:block;font:.875rem/1.65 monospace}.hash span{color:var(--muted)}.hash code{margin-top:10px;color:var(--text);overflow-wrap:anywhere}.validation{max-width:900px;border:1px solid var(--line)}.validation-row{display:grid;grid-template-columns:1fr minmax(220px,.7fr);gap:20px;padding:15px 18px;border-bottom:1px solid var(--line);font:.875rem/1.5 monospace}.validation-row:last-child{border-bottom:0}.validation-row span:last-child{text-align:right}.validation-row .ok{color:var(--eletronica)}.validation-row .pending{color:var(--automacao)}.timeline{border-left:1px solid var(--line)}.event{position:relative;padding:0 0 46px 38px}.event:last-child{padding-bottom:0}.event::before{content:"";position:absolute;top:5px;left:-5px;width:9px;height:9px;border-radius:50%;background:var(--programacao);box-shadow:0 0 12px var(--programacao)}.event h3{margin:8px 0 10px}.event p{max-width:720px;margin:0;color:var(--muted);font:1.0625rem/1.75 Georgia,"Times New Roman",serif}.links{display:flex;flex-wrap:wrap;gap:12px;margin-top:36px}.links a{padding:14px 18px;border:1px solid var(--line);color:var(--text);font:700 .875rem/1.4 monospace;text-decoration:none}.links a:hover,.links a:focus-visible{border-color:var(--programacao);color:var(--programacao);outline:none}.closing{padding:115px 0;text-align:center}.closing h2{margin:16px auto 0}.closing p{max-width:760px;margin:28px auto 0;color:var(--muted);font:1.125rem/1.8 Georgia,"Times New Roman",serif}
		@media(max-width:1050px){.screenshot-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:950px){.hero{grid-template-columns:1fr;gap:45px}.hero-icon{max-width:500px}.principles{grid-template-columns:repeat(2,1fr)}}@media(max-width:800px){.hero{padding:70px 0 60px}.content{padding:75px 0}.section-grid{grid-template-columns:1fr;gap:30px}.flow,.fact-grid,.build-grid{grid-template-columns:1fr}.validation-row{grid-template-columns:1fr}.validation-row span:last-child{text-align:left}}@media(max-width:600px){.screenshot-grid,.principles{grid-template-columns:1fr}.screenshot-grid .editorial-image__trigger img{height:min(155vw,650px)}.hero h1{font-size:clamp(3.2rem,17vw,5.4rem)}}
	</style>

	<SiteHeader accent="var(--programacao)" />
	<main><div class="container">
		<section class="hero"><div><div class="code">{project.type} / {project.number} / SOFTWARE PESSOAL</div><h1>{page.code}</h1><p class="subtitle">{page.subtitle}</p><div class="tags">{project.categories.map(({label,tone})=><Tag label={label} tone={tone} />)}</div><div class="status"><StatusGrid items={page.status} /></div></div><div class="hero-icon"><EditorialImage src="/images/vital-registro/icone.png" alt="Ícone do VitalRegistro com coração, traçado de pulso, aparelho de pressão, balança e relógio" caption="Ícone oficial do VitalRegistro." fit="contain" eager={true} /></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">01 / TUDO COMEÇOU COM UM APARELHO</div><div><div class="prose"><p>Depois de algumas semanas sentindo dores frequentes na nuca, comprei um aparelho de pressão arterial em uma farmácia. A dor foi o motivo para começar a medir; <strong>não houve diagnóstico relacionando o sintoma à pressão alta</strong>.</p><p class="lead-question">Onde eu guardo essas medições?</p><p>Eu queria registrar sistólica, diastólica, pulso, peso, data, horário e observações. Uma planilha ou um bloco de notas resolveriam a necessidade imediata. Em vez disso, decidi transformar uma pergunta pequena em um projeto de software.</p></div><EditorialImage src="/images/vital-registro/apresentacao.png" alt="Apresentação visual do VitalRegistro com ícone e telas planejadas do aplicativo" caption="Apresentação visual do projeto. É uma composição de design, não uma captura do APK." fit="contain" variant="detail" /></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">02 / LOCAL POR ESCOLHA</div><div><h2>Uma ferramenta pequena, direta e sem servidor.</h2><div class="principles"><strong>SEM ANÚNCIOS</strong><strong>SEM CONTA</strong><strong>SEM ASSINATURA</strong><strong>SEM TELEMETRIA</strong></div><div class="prose"><p>Os registros ficam no próprio aparelho, em um banco SQLite armazenado na área privada do aplicativo. Não existe login, cadastro, sincronização obrigatória ou servidor necessário para usar o VitalRegistro.</p><p>Essa escolha não é perfeita. Perda ou dano do telefone, limpeza dos dados, desinstalação ou restauração do aparelho podem remover o histórico que não tenha sido exportado. Nesta versão não há sincronização, importação nem backup automático em nuvem.</p></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">03 / PYTHON, KIVY E SQLITE</div><div><h2>Do formulário ao histórico.</h2><div class="flow"><article><strong>INTERFACE / KIVY</strong><p>Coleta os campos, permite escolher data e horário e apresenta histórico e gráficos.</p></article><article><strong>MODELO / PYTHON</strong><p>Valida formatos de entrada sem classificar o significado médico dos valores.</p></article><article><strong>PERSISTÊNCIA / SQLITE</strong><p>Grava cada medição de forma transacional, com identificador próprio e data/hora da medição.</p></article></div><div class="prose"><p>Data e horário pertencem à medição, não ao instante em que o formulário foi salvo. Isso permite registrar depois uma leitura feita anteriormente. O histórico consulta o banco pelo momento medido, do mais recente para o mais antigo; se dois registros compartilham o mesmo minuto, o identificador desempata a ordem.</p><p>As mesmas linhas alimentam detalhes, edição, gráficos e exportação. Uma falha de leitura não provoca recriação destrutiva do banco.</p></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">04 / INTERFACE REAL</div><div><h2>Abrir, registrar e seguir a vida.</h2><div class="prose"><p>A interface foi mantida simples de propósito. As capturas abaixo foram feitas no primeiro APK instalado no Samsung Galaxy M55 e usam dados fictícios. Elas antecedem ajustes posteriores de transparência do ícone, áreas seguras e seletores, portanto documentam uma etapa real — não necessariamente a aparência final do artefato publicado.</p></div><div class="screenshot-grid"><EditorialImage src="/images/vital-registro/home-android.jpg" alt="Tela inicial histórica do VitalRegistro no Android" caption="Home do primeiro APK." fit="contain" /><EditorialImage src="/images/vital-registro/novo-registro-android.jpg" alt="Formulário histórico de novo registro no Android" caption="Formulário com data, horário e campos da medição." fit="contain" /><EditorialImage src="/images/vital-registro/historico-android.jpg" alt="Histórico do VitalRegistro com uma medição fictícia" caption="Histórico com dados fictícios." fit="contain" /><EditorialImage src="/images/vital-registro/graficos-android.jpg" alt="Tela histórica de gráficos com seletor de período aberto" caption="Gráfico com uma única observação e seletor de período." fit="contain" /></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">05 / VISUALIZAR SEM INVENTAR</div><div class="prose"><h2>Um ponto continua sendo apenas um ponto.</h2><p>Os gráficos apresentam pressão, pulso ou peso nos últimos 7 dias, últimos 30 dias ou em todo o histórico. Durante o primeiro teste havia somente uma medição, então o gráfico mostrou somente um ponto.</p><p>Esse comportamento é correto. Criar uma linha, tendência ou interpretação com uma única observação acrescentaria informação que não existe nos dados.</p><div class="callout"><strong>REGISTRAR NÃO É DIAGNOSTICAR</strong><p>O VitalRegistro registra, organiza, apresenta e exporta. Ele não classifica automaticamente uma pressão como boa, ruim, normal, alta, baixa, saudável ou perigosa e não substitui avaliação profissional.</p></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">06 / TIRANDO OS DADOS DO APP</div><div><h2>CSV como saída e cópia externa.</h2><div class="prose"><p>A exportação reúne todos os registros em ordem cronológica, em CSV UTF-8, com data, hora, sistólica, diastólica, pulso, peso e observação. Aspas e quebras de linha são tratadas pelo gerador.</p><p>No Android, o aplicativo abre o seletor de documentos do sistema. O usuário escolhe nome e destino sem conceder ao aplicativo permissões amplas de armazenamento. Serviços de nuvem podem aparecer se já estiverem instalados, mas só são usados por escolha explícita.</p><p>A geração do CSV possui testes automatizados. O adaptador Android foi testado com componentes simulados; salvar, cancelar e repetir pelo seletor em um aparelho físico ainda aguardam validação.</p></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">07 / “AGORA SÓ FALTA O APK”</div><div><h2>O aplicativo não foi o único desafio.</h2><div class="prose"><p>Transformar o projeto Python/Kivy em um APK exigiu Google Colab, Buildozer, python-for-android, Android SDK e Android NDK. O fluxo anterior esperava Python entre 3.10 e 3.12, enquanto o Colab já executava Python 3.13.15.</p><p>Remover a verificação de versão não resolveria recipes, compilador nativo ou dependências. A cadeia foi revista para separar o Python que coordena o notebook, o Python que executa as ferramentas de build e o Python preparado pelo p4a para o aplicativo.</p></div><div class="build-grid">{buildFacts.map(([label,value])=><div><span>{label}</span><strong>{value}</strong></div>)}</div><EditorialImage src="/images/vital-registro/build-apk-google-colab.png" alt="Notebook do Google Colab após gerar e iniciar o download do APK ARM64 do VitalRegistro" caption="Fim do processo no Google Colab: o APK ARM64 foi gerado e encaminhado para download. A compilação bem-sucedida ainda precisava ser seguida pela instalação e pelo teste no aparelho." fit="contain" variant="detail" /></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">08 / BUILD REPRODUZÍVEL</div><div><h2>Mais do que “funcionou naquele notebook”.</h2><div class="prose"><p>O ambiente final fixou commits específicos do Buildozer e do python-for-android, API 36, NDK 29 e o commit do próprio projeto. O arquivo <code>build-info.json</code> preserva o ambiente efetivo e associa esses dados ao APK produzido.</p></div><div class="fact-grid"><div class="fact"><span>BUILDOZER</span><strong>a153097b…</strong></div><div class="fact"><span>PYTHON-FOR-ANDROID</span><strong>e772ad93…</strong></div><div class="fact"><span>PROJETO DO APK</span><strong>895c3dc2…</strong></div></div><div class="callout"><strong>TRÊS CONTEXTOS DE PYTHON</strong><p>Kernel Colab 3.13.15, ferramentas de build em CPython 3.14.7 e Python 3.14.2 nas recipes/artefato Android. São funções diferentes dentro da mesma cadeia.</p></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">09 / O HASH QUE EVITOU UM ERRO</div><div><h2>Dois APKs. O mesmo nome.</h2><div class="prose"><p>No fechamento da versão existiam dois arquivos chamados <code>vitalregistro-0.1.0-arm64-v8a-debug.apk</code>. Um era um build anterior; o outro, o artefato final. A conferência do SHA-256 evitou que o arquivo antigo fosse usado na publicação.</p><p>Uma informação que parecia formalidade mostrou imediatamente sua utilidade: identificar exatamente qual binário correspondia ao ambiente documentado.</p></div><div class="hash"><span>v0.1.0 · 26.306.986 bytes · SHA-256</span><code>259866134942d6990cf9f157603e3f024538b1101006a633fda633d5d386765a</code></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">10 / CELULAR DE VERDADE</div><div><h2>O que foi confirmado — e somente isso.</h2><div class="prose"><p>O APK debug ARM64 foi instalado em um Samsung Galaxy M55 com Android 16. A documentação separa implementação, teste automatizado, smoke desktop e validação no aparelho.</p></div><div class="validation">{validation.map(([item,result,tone])=><div class="validation-row"><span>{item}</span><span class={tone}>{result}</span></div>)}</div><div class="callout warning"><strong>MOCK NÃO É HARDWARE</strong><p>Os testes automatizados do adaptador Android simulam Activity, Java e o seletor de documentos. Isso não equivale a executar o Storage Access Framework no telefone.</p></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">11 / TESTES</div><div><h2>Trinta e cinco verificações antes do fechamento documental.</h2><div class="prose"><p>A suíte registrada cobre CRUD, persistência, edição de todos os campos, ordenação histórica, datas inválidas e bissextas, peso decimal, rollback, CSV UTF-8, áreas seguras e estados simulados da exportação Android.</p><p>Um smoke desktop exercitou detalhes, edição, gráficos vazios e preenchidos, pressão, pulso, peso, períodos, exportações repetidas e exclusão usando somente dados temporários fictícios. Esses testes ampliam a confiança no código, mas não substituem a lista curta do que foi confirmado no Galaxy M55.</p></div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">12 / v0.1.0</div><div><h2>O primeiro marco funcional.</h2><div class="prose"><p>A v0.1.0 reúne um aplicativo funcional, persistência local, histórico, gráficos, exportação implementada, documentação de build e uma primeira validação em hardware. O artefato publicado é <strong>DEBUG + ARM64-V8A</strong>; não é uma versão pronta para Google Play.</p><p>Ferramentas de IA participaram de discussões, implementação, revisão e documentação. A necessidade, as decisões, os testes e a conferência em hardware continuaram sendo parte de um processo conduzido e verificado por uma pessoa.</p></div><div class="timeline">{page.timeline.map((event)=><article class="event"><time>{event.year}</time><h3>{event.title}</h3><p>{event.text}</p></article>)}</div></div></div></section>

		<section class="content"><div class="section-grid"><div class="section-label">13 / LIMITES E PRÓXIMOS PASSOS</div><div class="prose"><h2>Local, funcional e ainda em desenvolvimento.</h2><p>Continuam pendentes no aparelho: edição e exclusão completas, todos os gráficos e períodos, exportação/cancelamento pelo seletor, teclado, suspensão e retomada, além da validação visual dos ajustes feitos depois das capturas.</p><p>Importação CSV, intervalo personalizado, acessibilidade ampliada e preparação para distribuição assinada são possibilidades posteriores. Sincronização ou backup em nuvem exigiriam uma decisão futura explícita sobre privacidade.</p><p>O VitalRegistro não substitui avaliação, diagnóstico ou orientação de profissionais de saúde.</p><div class="links"><a href="https://github.com/akioShaolin/vital-registro" target="_blank" rel="noreferrer">CÓDIGO-FONTE ↗</a><a href="https://github.com/akioShaolin/vital-registro/releases/tag/v0.1.0" target="_blank" rel="noreferrer">RELEASE v0.1.0 ↗</a></div></div></div></section>

		<section class="closing"><div class="signal">[ IDEIAS EM SINAL ]</div><h2>Uma pergunta banal atravessou banco de dados, Android e reprodutibilidade.</h2><p>O resultado não é apenas um APK. É o registro de como uma necessidade pessoal pequena cresceu até exigir decisões de produto, privacidade, interface, testes, compilação e identificação precisa de artefatos.</p></section>
	</div></main>
	<SiteFooter rightText={`${project.type} / ${project.number}`} />
	<ImageLightbox />
</BaseLayout>
