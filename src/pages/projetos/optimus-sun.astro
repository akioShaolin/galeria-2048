---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StatusGrid from "../../components/StatusGrid.astro";
import Tag from "../../components/Tag.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import ImageLightbox from "../../components/ImageLightbox.astro";
import { getProject } from "../../data/projects";

const project = getProject("optimus-sun");

if (!project?.page) {
	throw new Error("Dados do projeto Optimus Sun não encontrados.");
}

const page = project.page;
---

<BaseLayout
	title="Optimus Sun — Galeria -2048"
	description={page.subtitle}
	image={project.image}
	keywords={project.keywords}
>
	<style is:global>
		body {
			background:
				radial-gradient(circle at 76% 8%, rgba(255, 224, 0, .045), transparent 520px),
				linear-gradient(rgba(255,255,255,.014) 1px, transparent 1px),
				linear-gradient(90deg, rgba(255,255,255,.014) 1px, transparent 1px),
				var(--bg);
			background-size: auto, 42px 42px, 42px 42px, auto;
			font-family: Arial, Helvetica, sans-serif;
		}

		.hero {
			padding: 100px 0 75px;
		}

		.code,
		.section-label,
		.event-year,
		.pending-label {
			color: var(--programacao);
			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;
			letter-spacing: .08em;
		}

		h1 {
			max-width: 1050px;
			margin: 25px 0 0;
			font-size: clamp(4rem, 11vw, 9rem);
			line-height: .82;
			letter-spacing: -.075em;
		}

		.subtitle {
			max-width: 790px;
			margin-top: 38px;
			color: var(--muted);
			font-size: clamp(1.2rem, 2vw, 1.6rem);
			line-height: 1.55;
		}

		.tags {
			display: flex;
			flex-wrap: wrap;
			gap: 10px;
			margin-top: 30px;
		}

		.status { margin-top: 55px; }

		.hero-image {
			margin: 0;
			border: 1px solid var(--line);
			background: var(--surface);
		}

		.hero-image img {
			display: block;
			width: 100%;
			height: clamp(340px, 55vw, 620px);
			object-fit: contain;
		}

		.hero-image figcaption {
			padding: 12px 15px;
			border-top: 1px solid var(--line);
			color: var(--muted);
			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;
		}

		.content {
			padding: 100px 0;
			border-bottom: 1px solid var(--line);
		}

		.section-grid {
			display: grid;
			grid-template-columns: 250px 1fr;
			gap: 75px;
		}

		h2 {
			max-width: 850px;
			margin: 0 0 35px;
			font-size: clamp(2.2rem, 5vw, 4.4rem);
			line-height: .96;
			letter-spacing: -.05em;
		}

		.prose {
			max-width: 760px;
		}

		.prose p,
		.prose li {
			color: var(--muted);
			font-family: Georgia, "Times New Roman", serif;
			font-size: 1.125rem;
			line-height: 1.8;
		}

		.prose p { margin: 0 0 22px; }
		.prose strong { color: var(--text); }
		.prose ul,
		.prose ol { padding-left: 24px; }
		.prose li + li { margin-top: 10px; }

		.distinctions {
			display: grid;
			gap: 1px;
			margin-top: 40px;
			border: 1px solid var(--line);
			background: var(--line);
		}

		.distinction {
			padding: 22px;
			background: var(--surface);
		}

		.distinction strong {
			display: block;
			margin-bottom: 8px;
			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;
			letter-spacing: .04em;
		}

		.distinction span {
			color: var(--muted);
			font-family: Georgia, "Times New Roman", serif;
			font-size: 1.0625rem;
			line-height: 1.7;
		}

		.pending {
			max-width: 760px;
			margin-top: 35px;
			padding: 24px;
			border: 1px solid var(--line);
			border-left: 2px solid var(--automacao);
			background: rgba(255, 138, 0, .035);
		}

		.pending p {
			margin: 10px 0 0;
			color: var(--muted);
			font-family: monospace;
			font-size: .875rem;
			line-height: 1.65;
		}

		.media-placeholder {
			display: grid;
			place-items: center;
			min-height: 300px;
			margin-top: 40px;
			padding: 30px;
			border: 1px dashed var(--line);
			background: var(--surface);
			color: var(--muted);
			font-family: monospace;
			font-size: .875rem;
			line-height: 1.6;
			text-align: center;
		}

		.workflow {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1px;
			margin: 40px 0;
			border: 1px solid var(--line);
			background: var(--line);
		}

		.workflow-step {
			padding: 22px;
			background: var(--surface);
		}

		.workflow-step strong {
			display: block;
			color: var(--programacao);
			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;
		}

		.workflow-step span {
			display: block;
			margin-top: 9px;
			color: var(--muted);
			font-family: Georgia, "Times New Roman", serif;
			font-size: 1rem;
			line-height: 1.65;
		}

		.screen-list {
			display: grid;
			gap: 1px;
			margin: 35px 0;
			border: 1px solid var(--line);
			background: var(--line);
		}

		.screen-item {
			display: grid;
			grid-template-columns: 180px 1fr;
			gap: 24px;
			padding: 22px;
			background: var(--surface);
		}

		.screen-item strong { font-family: monospace; font-size: .875rem; line-height: 1.5; }
		.screen-item span { color: var(--muted); font-family: Georgia, "Times New Roman", serif; font-size: 1.0625rem; line-height: 1.7; }

		.media-grid,
		.app-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 24px;
			margin-top: 40px;
		}

		.media-grid > *,
		.app-grid > * { min-width: 0; margin: 0; }

		.app-card {
			padding: 24px;
			border: 1px solid var(--line);
			background: var(--surface);
		}

		.app-card h3 { margin: 0 0 12px; font-size: 1.35rem; }
		.app-card p { margin: 0; color: var(--muted); font: 1.0625rem/1.7 Georgia, "Times New Roman", serif; }

		.link-group {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 12px;
			margin-top: 35px;
		}

		.link-group .project-link { margin-top: 0; }

		.download-copy {
			margin: 30px auto 0;
			text-align: left;
		}

		.project-link {
			display: inline-block;
			margin-top: 35px;
			padding: 14px 18px;
			border: 1px solid var(--line);
			color: var(--text);
			font: 700 .875rem/1.4 monospace;
			text-decoration: none;
		}

		.project-link:hover,
		.project-link:focus-visible { border-color: var(--programacao); color: var(--programacao); outline: none; }

		.timeline { border-left: 1px solid var(--line); }

		.event {
			position: relative;
			padding: 0 0 55px 42px;
		}

		.event:last-child { padding-bottom: 0; }

		.event::before {
			content: "";
			position: absolute;
			left: -5px;
			top: 5px;
			width: 9px;
			height: 9px;
			border-radius: 50%;
			background: var(--programacao);
			box-shadow: 0 0 12px var(--programacao);
		}

		.event h3 {
			margin: 10px 0 12px;
			font-size: 1.5rem;
		}

		.event p {
			max-width: 700px;
			margin: 0;
			color: var(--muted);
			font-family: Georgia, "Times New Roman", serif;
			font-size: 1.0625rem;
			line-height: 1.75;
		}

		.project-open {
			padding: 120px 0;
			text-align: center;
		}

		.project-open div {
			margin-bottom: 20px;
			color: var(--programacao);
			font-family: monospace;
			font-size: .875rem;
			line-height: 1.5;
		}

		.project-open h2 { margin: auto; }

		@media (max-width: 800px) {
			.hero { padding: 70px 0 55px; }
			.content { padding: 75px 0; }
			.section-grid { grid-template-columns: 1fr; gap: 30px; }
			.event { padding-left: 28px; }
			.workflow { grid-template-columns: 1fr 1fr; }
			.screen-item { grid-template-columns: 1fr; gap: 10px; }
			.media-grid,
			.app-grid { grid-template-columns: 1fr; }
		}

		@media (max-width: 600px) { .workflow { grid-template-columns: 1fr; } }
	</style>

	<SiteHeader accent="var(--programacao)" />

	<main>
		<div class="container">
			<section class="hero">
				<div class="code">{project.type} / {project.number}</div>
				<h1>{page.code}</h1>
				<div class="subtitle">{page.subtitle}</div>
				<div class="tags">{project.categories.map(({ label, tone }) => <Tag label={label} tone={tone} />)}</div>
				<div class="status"><StatusGrid items={page.status} /></div>
			</section>

			<EditorialImage src={project.image} alt="Identidade visual do Optimus Sun com módulo fotovoltaico, inversor e sol" caption="Identidade visual do Optimus Sun, preservada desde as primeiras versões do projeto." eager={true} />

			<section class="content">
				<div class="section-grid">
					<div class="section-label">[ 01 / A ORIGEM ]</div>
					<div class="prose">
						<h2>Uma ferramenta que começou como uma planilha</h2>
						<p>A ideia do Optimus Sun surgiu em 2022, quando eu trabalhava em uma empresa de energia fotovoltaica e era responsável por acompanhar obras remotamente e orientar instaladores em campo.</p>
						<p>Parte desse trabalho envolvia verificar combinações entre inversores e módulos fotovoltaicos. Era necessário saber não apenas se determinada configuração poderia funcionar, mas também quais eram as condições mínimas para a partida e operação do inversor e como montar os arranjos de forma compatível com suas faixas de tensão de trabalho.</p>
						<p>A intenção era facilitar esses cálculos e tornar mais rápida a análise das combinações entre módulos e inversores, incluindo as condições necessárias para funcionamento e a busca por configurações que respeitassem as tensões de operação relevantes para uma boa utilização do equipamento.</p>
						<p>No início, o Optimus Sun era apenas uma planilha de Excel. Conforme a necessidade aumentou, a ferramenta começou a evoluir. Vieram automações em VBA, experimentações em Python e outras formas de organizar e executar os cálculos.</p>
						<p>O que começou como uma planilha para resolver uma tarefa recorrente acabou se tornando um projeto por si só.</p>
						<div class="pending">
							<div class="pending-label">NOTA TÉCNICA</div>
							<p>Uma combinação precisa ser confrontada com as especificações do fabricante, as condições ambientais, o projeto elétrico e os critérios aplicáveis. Esta página não apresenta o Optimus Sun como garantia universal de compatibilidade ou desempenho.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="content">
				<div class="section-grid">
					<div class="section-label">[ 02 / O QUE FAZ ]</div>
					<div>
						<h2>Compatibilidade transformada em limites legíveis</h2>
						<div class="prose">
							<p>Na versão 2.6.0, o Optimus Sun tornou-se uma suíte de três aplicativos para Windows. A aplicação principal pesquisa equipamentos no banco SQLite, calcula quantidades de módulos por string, strings por MPPT e o resumo do inversor; os outros dois aplicativos cuidam dos cadastros e da comparação em matriz.</p>
							<p>Nos resultados horizontais, vermelho indica valores fora da faixa, amarelo representa a faixa de operação e verde destaca a faixa de carga máxima. Nos gráficos comparativos, a barra vermelha identifica o critério que limita o resultado — não uma garantia isolada de segurança ou compatibilidade.</p>
						</div>
						<div class="distinctions">
							<div class="distinction"><strong>POR STRING</strong><span>Compara tensão de circuito aberto, faixa de operação e faixa de carga máxima para estabelecer os intervalos admitidos.</span></div>
							<div class="distinction"><strong>POR MPPT</strong><span>Compara corrente de curto-circuito, corrente de operação e quantidade física de entradas para limitar o número de strings.</span></div>
							<div class="distinction"><strong>POR INVERSOR</strong><span>Consolida os grupos de MPPT e confronta circuito aberto, operação, sobrecarga e carga máxima para indicar o limite global.</span></div>
						</div>
						<EditorialImage src="/images/optimus-sun/v2.6.0/scrsht-1.png" alt="Tela principal do Optimus Sun 2.6.0 com equipamentos selecionados e resultados do cálculo" caption="Aplicação principal após um cálculo válido: a pesquisa é recolhida e permanecem os equipamentos escolhidos, as opções e os resultados." />
					</div>
				</div>
			</section>

			<section class="content">
				<div class="section-grid">
					<div class="section-label">[ 03 / COMO UTILIZAR ]</div>
					<div>
						<h2>Da seleção ao resumo do arranjo</h2>
						<div class="prose">
							<p>Inversor e módulo são pesquisados de forma independente por ID, modelo ou fabricante — informar o fabricante não é obrigatório. Há filtros básicos e avançados, incluindo parâmetros CA e CC para inversores, potência para módulos e a situação ativa ou inativa.</p>
							<p>Digitar ou filtrar apenas atualiza a lista: a escolha é explícita, por clique ou teclado. Uma nova busca limpa somente a seleção daquele equipamento. Quando a combinação é válida e o cálculo acontece, a área de pesquisa recolhe por completo; ao reabri-la, abas largas e painéis recolhíveis preservam os filtros. Cartões mantêm visíveis os itens escolhidos e dão acesso aos detalhes.</p>
						</div>
						<div class="workflow">
							<div class="workflow-step"><strong>01 / PESQUISAR</strong><span>Por ID, modelo ou fabricante, com filtros próprios para cada equipamento.</span></div>
							<div class="workflow-step"><strong>02 / CONFERIR</strong><span>Dados técnicos e parâmetros cadastrados.</span></div>
							<div class="workflow-step"><strong>03 / ANALISAR</strong><span>Limites por string e por grupo de MPPT.</span></div>
							<div class="workflow-step"><strong>04 / CONSOLIDAR</strong><span>Quantidade e potência no inversor completo.</span></div>
						</div>
						<div class="screen-list">
							<div class="screen-item"><strong>FICHAS TÉCNICAS</strong><span>Apresentam sistema, propriedades elétricas e MPPTs do inversor; tecnologia, grandezas elétricas e coeficientes de temperatura do módulo.</span></div>
							<div class="screen-item"><strong>LIMITES POR MPPT</strong><span>As barras comparam restrições simultâneas. Nos gráficos, vermelho identifica o menor valor que limita a configuração; verde mostra os demais limites válidos para a comparação.</span></div>
							<div class="screen-item"><strong>RESUMO GLOBAL</strong><span>Confronta os limites do inversor inteiro e detalha quantidade e potência por grupo de MPPTs.</span></div>
						</div>
						<div class="media-grid">
							<EditorialImage src="/images/optimus-sun/v2.6.0/scrsht-2.png" alt="Fichas de detalhes de um inversor e um módulo no Optimus Sun 2.6.0" caption="Fichas técnicas para conferir os dados usados no cálculo." />
							<EditorialImage src="/images/optimus-sun/v2.6.0/scrsht-3.png" alt="Gráficos de limites por MPPT e por string no Optimus Sun 2.6.0" caption="Gráficos por MPPT: a barra vermelha evidencia o critério limitante." />
							<EditorialImage src="/images/optimus-sun/v2.6.0/scrsht-4.png" alt="Resumo geral do inversor no Optimus Sun 2.6.0" caption="Resumo global do inversor e distribuição calculada por grupo de MPPT." />
						</div>
						<div class="pending"><div class="pending-label">CONTROLES DE CÁLCULO</div><p>A sobrecarga pode vir do cadastro ou ser personalizada apenas para a sessão, sem modificar o banco. “Ignorar corrente de operação” e “Ignorar faixa de carga máxima” retiram critérios do cálculo e exigem justificativa técnica e conferência nos documentos dos fabricantes.</p></div>
					</div>
				</div>
			</section>

			<section class="content">
				<div class="section-grid">
					<div class="section-label">[ 04 / TRÊS APLICATIVOS ]</div>
					<div>
						<h2>Uma suíte, três tarefas separadas</h2>
						<div class="app-grid">
							<article class="app-card"><h3>Optimus Sun</h3><p>Pesquisa inversores e módulos, mantém a escolha explícita, apresenta detalhes e calcula uma combinação por vez.</p></article>
							<article class="app-card"><h3>Optimus Sun Cadastros</h3><p>Visualiza e edita fabricantes, módulos, inversores e seus grupos de MPPT em uma interface própria.</p></article>
							<article class="app-card"><h3>Matriz de Compatibilidade</h3><p>Compara vários inversores e módulos simultaneamente e organiza quantidade, potência e sobrecarga em uma matriz.</p></article>
						</div>
						<div class="prose">
							<p>O cadastro unificado permite visualizar dados em modo somente leitura, editar ou duplicar um item como rascunho. Inversor e grupos de MPPT são salvos como um conjunto; posições físicas, quantidade de entradas e parâmetros passam por validação, e características podem ser copiadas para acelerar cadastros semelhantes. A captura abaixo registra um rascunho ainda incompleto, não um equipamento pronto para uso.</p>
						</div>
						<div class="media-grid">
							<EditorialImage src="/images/optimus-sun/v2.6.0/scrsht-5.png" alt="Lista de fabricantes no aplicativo Optimus Sun Cadastros" caption="Cadastros: consulta, edição e criação de rascunhos para fabricantes e equipamentos." />
							<EditorialImage src="/images/optimus-sun/v2.6.0/scrsht-6.png" alt="Rascunho incompleto de inversor e editor de grupo de MPPT" caption="Edição conjunta de inversor e grupos de MPPT; a imagem mostra deliberadamente um rascunho incompleto." />
							<EditorialImage src="/images/optimus-sun/v2.6.0/scrsht-7.png" alt="Visualização somente leitura de um módulo no Optimus Sun Cadastros" caption="Modo de visualização: os dados podem ser conferidos sem entrar em edição." />
						</div>
					</div>
				</div>
			</section>

			<section class="content">
				<div class="section-grid">
					<div class="section-label">[ 05 / MATRIZ ]</div>
					<div>
						<h2>Muitas combinações em uma leitura</h2>
						<div class="prose">
							<p>A Matriz de Compatibilidade é um aplicativo separado. Seus seletores mostram equipamentos ativos e permitem associar vários inversores a vários módulos. Cada célula apresenta quantidade, potência, sobrecarga e, quando necessário, uma ocorrência textual. A sobrecarga também pode ser personalizada por inversor.</p>
							<p>O modo que ignora corrente de operação pode produzir ganho de quantidade e o sinaliza no resultado. “Não suporta” significa que nenhuma configuração válida foi encontrada; “N/D” indica dados insuficientes para calcular — situações diferentes que não devem ser confundidas.</p>
							<p>A matriz importa e exporta CSV. Após importar, os valores permanecem como registro até que um novo cálculo seja solicitado. No arquivo, uma sobrecarga de 50% é gravada como <strong>0,50</strong>, e não como razão total 1,50; arquivos antigos ambíguos exigem que o usuário escolha explicitamente como interpretar o valor.</p>
						</div>
						<EditorialImage src="/images/optimus-sun/v2.6.0/scrsht-8.png" alt="Matriz de Compatibilidade do Optimus Sun comparando três inversores e três módulos" caption="Aplicativo independente de matriz: múltiplas combinações, resultados por célula e indicação de ganhos quando a corrente de operação é ignorada." />
					</div>
				</div>
			</section>

			<section class="content">
				<div class="section-grid">
					<div class="section-label">[ 06 / EVOLUÇÃO ]</div>
					<div>
						<h2>Da planilha ao software</h2>
						<div class="timeline">
							{page.timeline.map((entry) => (
								<article class="event">
									<div class="event-year">{entry.year}</div>
									<h3>{entry.title}</h3>
									<p>{entry.text}</p>
								</article>
							))}
						</div>
					</div>
				</div>
			</section>

			<section class="content">
				<div class="section-grid">
					<div class="section-label">[ 07 / TECNOLOGIA E USO ]</div>
					<div class="prose">
						<h2>Apoio para verificações recorrentes</h2>
						<p>A versão atual é construída em <strong>Python</strong>, com interfaces em <strong>Tkinter</strong>, banco <strong>SQLite</strong>, gráficos em <strong>Matplotlib</strong>, imagens tratadas com <strong>Pillow</strong> e distribuição Windows por <strong>PyInstaller</strong>. Excel e VBA pertencem à história do projeto, não à arquitetura atual.</p>
						<p>A aplicação principal utiliza funções compartilhadas de <strong>optimus_lib.py</strong>. A matriz tem seu próprio conjunto de módulos em <strong>src/compatibility</strong>; isso não significa que toda a aplicação principal tenha migrado para essa arquitetura.</p>
						<p>O Optimus Sun é útil como ferramenta de apoio em situações nas quais muitas combinações entre módulos e inversores precisam ser verificadas. Essa necessidade apareceu no acompanhamento remoto de obras e na orientação técnica a instaladores.</p>
						<p>A ferramenta busca organizar e automatizar parte dessas verificações. Ela não substitui datasheets e documentação oficial dos fabricantes, critérios de engenharia e projeto, normas técnicas aplicáveis ou a análise das condições ambientais e elétricas reais da instalação.</p>
						<p>A proposta é auxiliar a análise, não emitir uma garantia universal de compatibilidade ou desempenho.</p>
					</div>
				</div>
			</section>

			<section class="content">
				<div class="section-grid">
					<div class="section-label">[ 08 / O FUTURO ]</div>
					<div class="prose">
						<h2>O projeto continua aberto</h2>
