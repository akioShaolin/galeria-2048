---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StatusGrid from "../../components/StatusGrid.astro";
import Tag from "../../components/Tag.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import ImageLightbox from "../../components/ImageLightbox.astro";
import { getProject } from "../../data/projects";

const project = getProject("gtr-01");

if (!project?.page) {
	throw new Error("Dados do projeto GTR-01 não encontrados.");
}

const page = project.page;
---

<BaseLayout
	title={`${page.code} — Galeria -2048`}
	description="GTR-01 — uma guitarra em constante reconstrução, documentada como projeto aberto de luthieria, eletrônica e áudio."
>
	<style is:global>
		body {
			font-family:Arial, Helvetica, sans-serif;
		}

		header {
			border-bottom:1px solid var(--line);
		}

		nav {
			height:70px;
			display:flex;
			align-items:center;
			justify-content:space-between;
		}

		.brand {
			font-weight:800;
			letter-spacing:-.04em;
		}

		.back {
			font-family:monospace;
			color:var(--muted);
			font-size:.875rem;
		}

		.back:hover {
			color:var(--luthieria);
		}

		.hero {
			padding:100px 0 70px;
		}

		.code {
			font-family:monospace;
			color:var(--luthieria);
			font-size:.875rem;
			line-height:1.5;
			letter-spacing:.08em;
			margin-bottom:25px;
		}

		h1 {
			margin:0;
			font-size:clamp(4rem, 11vw, 9rem);
			line-height:.82;
			letter-spacing:-.075em;
		}

		.subtitle {
			margin-top:35px;
			color:var(--muted);
			font-size:clamp(1.2rem, 2vw, 1.6rem);
			max-width:750px;
			line-height:1.5;
		}

		.tags {
			display:flex;
			flex-wrap:wrap;
			gap:10px;
			margin-top:30px;
		}

		.tag {
			font-family:monospace;
			font-size:.875rem;
			line-height:1.4;
			padding:7px 10px;
			border:1px solid currentColor;
		}

		.luthieria { color:var(--luthieria); }
		.audio { color:var(--audio); }
		.eletronica { color:var(--eletronica); }

		.status {
			margin-top:55px;
		}

		.hero-image {
			margin:0;
			height:clamp(350px, 55vw, 680px);
			border:1px solid var(--line);
			background:
				linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),
				linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px),
				#090c0e;
			background-size:40px 40px;

			overflow:hidden;
		}

		.hero-image img {
			display:block;
			width:100%;
			height:100%;
			object-fit:contain;
			object-position:center;
		}

		section.content {
			padding:100px 0;
			border-bottom:1px solid var(--line);
		}

		.section-grid {
			display:grid;
			grid-template-columns:280px 1fr;
			gap:80px;
		}

		.section-label {
			font-family:monospace;
			font-size:.875rem;
			line-height:1.5;
			color:var(--luthieria);
			letter-spacing:.08em;
		}

		h2 {
			font-size:clamp(2rem,4vw,3.8rem);
			letter-spacing:-.05em;
			margin:0 0 35px;
		}

		.prose {
			max-width:760px;
		}

		.prose p {
			color:var(--muted);
			font-family:Georgia, "Times New Roman", serif;
			font-size:1.125rem;
			line-height:1.8;
		}

		.prose strong {
			color:var(--text);
		}

		.timeline {
			border-left:1px solid var(--line);
		}

		.event {
			position:relative;
			padding:0 0 65px 45px;
		}

		.event::before {
			content:"";
			position:absolute;
			left:-5px;
			top:5px;
			width:9px;
			height:9px;
			border-radius:50%;
			background:var(--luthieria);
			box-shadow:0 0 12px var(--luthieria);
		}

		.event-year {
			font-family:monospace;
			color:var(--luthieria);
			font-size:.875rem;
			line-height:1.5;
			margin-bottom:10px;
		}

		.event h3 {
			font-size:clamp(1.5rem, 3vw, 2.2rem);
			margin:0 0 20px;
		}

		.event h4 {
			margin:50px 0 15px;
			font-size:1.25rem;
			letter-spacing:-.02em;
		}

		.event p {
			color:var(--muted);
			font-family:Georgia, "Times New Roman", serif;
			font-size:1.0625rem;
			line-height:1.75;
			max-width:700px;
			margin:0 0 20px;
		}

		.event p:last-child {
			margin-bottom:0;
		}

		.event strong {
			color:var(--text);
		}

		.event blockquote {
			max-width:700px;
			margin:30px 0;
			padding:5px 0 5px 24px;
			border-left:2px solid var(--luthieria);
			color:var(--text);
			font-family:Georgia, "Times New Roman", serif;
			font-size:1.125rem;
			line-height:1.75;
		}

		.image-pair {
			display:grid;
			grid-template-columns:repeat(2, minmax(0, 1fr));
			gap:20px;
			max-width:900px;
		}

		.specs {
			border-top:1px solid var(--line);
		}

		.spec {
			display:grid;
			grid-template-columns:1fr 1fr;
			gap:30px;
			padding:17px 0;
			border-bottom:1px solid var(--line);
			font-family:monospace;
			font-size:.875rem;
			line-height:1.5;
		}

		.spec-name {
			color:var(--muted);
		}

		.continues {
			padding:120px 0;
			text-align:center;
		}

		.continues div {
			color:var(--luthieria);
			font-family:monospace;
			font-size:.875rem;
			line-height:1.5;
			margin-bottom:20px;
		}

		.continues h2 {
			max-width:800px;
			margin:auto;
		}

		footer {
			border-top:1px solid var(--line);
			padding:30px 0;
			color:var(--muted);
			font-family:monospace;
			font-size:.875rem;
			line-height:1.5;
		}

		.footer {
			display:flex;
			justify-content:space-between;
		}

		@media(max-width:800px) {
			.section-grid {
				grid-template-columns:1fr;
				gap:30px;
			}

			.spec {
				grid-template-columns:1fr;
				gap:7px;
			}

			.image-pair {
				grid-template-columns:1fr;
			}

			.event {
				padding-left:28px;
			}
		}
	</style>

	<SiteHeader accent="var(--luthieria)" />

	<main>

		<div class="container">

			<section class="hero">

				<div class="code">
					{project.type} / {project.number}
				</div>

				<h1>
					{page.code}
				</h1>

				<div class="subtitle">
					{page.subtitle}
				</div>

				<div class="tags">
					{project.categories.map(({ label, tone }) => (
						<Tag label={label} tone={tone} />
					))}
				</div>

				<div class="status"><StatusGrid items={page.status} /></div>

			</section>

			<figure class="hero-image">
				<img
					src={project.image}
					alt="Guitarra GTR-01 em seu estado atual"
				/>
			</figure>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 01 / A HISTÓRIA ]
					</div>

					<div class="prose">

						<h2>
							Um instrumento que nunca ficou realmente pronto (e que nunca vai ficar)
						</h2>

						<p>
							Esta guitarra faz parte da minha história há vários anos.
							Antes de virar um projeto documentado, ela já havia
							passado por uso, desmontagens, modificações, venda,
							presenteamento e longos
							períodos esperando a próxima ideia.
						</p>

						<p>
							Em 2026 decidi retomar o instrumento com outra
							abordagem: <strong>documentar</strong>. Eu já vinha fazendo
							modificações havia muito tempo; agora, além de continuar
							experimentando com ele, quero registrar o processo.
						</p>

						<p>
							Desde então, elétrica, captadores, ferragens,
							acabamento e até a possibilidade de eletrônica ativa
							passaram a fazer parte do projeto.
						</p>

						<p>
							Esta página não representa uma guitarra terminada.
							Ela é o registro do que aconteceu com ela — inclusive
							das ideias que não deram certo.
						</p>

					</div>

				</div>

			</section>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 02 / LINHA DO TEMPO ]
					</div>

					<div>

						<h2>
							A transformação
						</h2>

						<div class="timeline">

							<article class="event">
								<div class="event-year">DÉCADA DE 2010</div>
								<h3>O começo</h3>
								<p>Desde criança eu me interessava por tocar um instrumento musical, principalmente por influência da minha irmã e do violão dela. Queria porque queria uma guitarra, até que, de tanto insistir, meu pai me deu uma.</p>
								<p>Na época ele pagou cerca de R$ 400 nela em uma loja de Barretos que hoje nem existe mais, a Frujelle Musical.</p>
								<p>Não era das melhores guitarras, e tanto eu quanto ele sabíamos disso. O som não me agradava: eu o achava frio e magro. Minha diversão era ligar a guitarra na entrada de microfone do aparelho de som de casa e aumentar o volume para ouvi-lo distorcendo — até o dia em que consegui queimar a entrada do aparelho.</p>
								<p>Meu pai também me lançou um desafio: eu deveria aprender a tocar <strong>O Milionário</strong>, d'Os Incríveis. É um desafio que ainda não consegui cumprir, mesmo depois de quase 15 anos.</p>
								<EditorialImage src="/images/gtr-01/inicio-decada-2010.jpg" alt="Pedro ainda jovem segurando a guitarra preta no início de sua história com o instrumento" caption="A guitarra no começo da história, ainda na década de 2010." position="center 45%" />

								<h4>O que eu tocava</h4>
								<p>Conforme fui crescendo, acabei optando por tocar baixo. Na época eu via a base da música como um caminho mais fácil para começar — uma ideia bastante comum entre muitos músicos que acabaram se tornando baixistas.</p>
								<p>Na guitarra eu também tocava principalmente bases. Raramente arriscava riffs, embora alguns clássicos aparecessem: <em>Sweet Child O' Mine</em>, <em>Smoke on the Water</em>, <em>Highway to Hell</em>, <em>Back in Black</em>, <em>Toxicity</em>, além de alguns solos como <em>So Far Away</em>, do Avenged Sevenfold, e o primeiro solo de <em>Knockin' on Heaven's Door</em>, do Guns N' Roses.</p>
								<p>Nunca fui guitarrista de banda; fui baixista. A guitarra ficou como hobby.</p>
								<p>Ganhei do meu tio uma pedaleira Zoom G1XNext, mas eu não tinha muita paciência para efeitos. O wah-wah parecia estranho, eu sentia falta de uma alavanca e, principalmente, faltava habilidade para entender o que eu estava fazendo.</p>
								<p>Um amigo meu, o Cristrian, pegava a guitarra e conseguia tirar um som bom. Quando eu tocava, saía um som que me desagradava.</p>
								<p>Resumindo: eu não sabia regular ou equalizar direito e nunca estava satisfeito com o que já tinha. Isso me frustrou por anos.</p>
							</article>

							<article class="event">
								<div class="event-year">ANTES DA PANDEMIA</div>
								<h3>O fim do início</h3>
								<p>Quando eu tinha acabado de fazer 19 anos, fui morar sozinho e levei meus instrumentos comigo. Minha vida passou a ser trabalhar, fazer faculdade e sobreviver.</p>
								<p>Algum tempo depois, pouco antes da pandemia, eu havia me mudado para um condomínio onde o aluguel já incluía água, luz, internet e mobília. As kitnets eram pequenas e espaço era um problema.</p>
								<p>Foi lá que conheci Marcos, meu vizinho. Ele gostava de música como eu. Havia sido vocalista de uma banda na juventude e, naquele momento, estava se desafiando nos instrumentos de corda. Foi quando perguntou se eu queria vender a guitarra e a pedaleira.</p>
								<p>Depois de negociarmos, a guitarra passou a ser dele.</p>
								<EditorialImage src="/images/gtr-01/instrumento-antes-da-venda.jpeg" alt="Guitarra preta desmontada, com o braço separado do corpo" caption="O instrumento durante uma das fases anteriores à venda." variant="portrait" position="center 42%" />
								<p>Essa escolha acabou dando um novo significado à existência do instrumento. Foi o Marcos quem começou a dar outra personalidade à guitarra: colou adesivos, colocou cordas de calibre maior e expandiu o repertório que passava por ela.</p>
								<EditorialImage src="/images/gtr-01/marcos-com-a-guitarra.jpg" alt="Marcos tocando a guitarra preta já modificada com adesivos" caption="Com Marcos, a guitarra ganhou outras marcas, cordas e repertório." position="center 58%" />

								<h4>O acidente</h4>
								<p>Alguns dias depois de perceber que não via Marcos pelo condomínio, descobri que ele havia sofrido um grave acidente de moto. A recuperação seria longa e ele precisou voltar a morar com a família.</p>
								<p>Nesse período decidiu vender a guitarra e a pedaleira. Assim que vi o anúncio da guitarra no Facebook, não pensei duas vezes. Consegui comprá-la de volta, embora a pedaleira já tivesse sido vendida.</p>
								<p>Depois, emprestei a guitarra para que ele pudesse continuar praticando durante a recuperação.</p>
								<EditorialImage src="/images/gtr-01/marcos-praticando.jpg" alt="Marcos praticando com a guitarra preta em frente a equipamentos musicais" caption="A guitarra voltou temporariamente para que Marcos continuasse praticando." position="center 55%" />
								<p>Com o tempo, Marcos se recuperou, comprou a guitarra de volta e continuou tocando e experimentando com o instrumento. Trocou adesivos, fez novos ajustes e chegou a fazer uma blindagem utilizando manta asfáltica.</p>
								<p>Juntos também fomos tocar na pista de skate e no lago da cidade e chegamos a formar uma banda — mas essa é história para outro dia.</p>
								<EditorialImage src="/images/gtr-01/encontro-musical.jpg" alt="Dois músicos tocando guitarra e baixo em um encontro informal" caption="Uma das ocasiões em que eu e Marcos nos reunimos para tocar em banda." position="center 52%" />
							</article>

							<article class="event">
								<div class="event-year">O PRESENTE</div>
								<h3>A guitarra volta para casa</h3>
								<p>Antes de eu me mudar do condomínio, Marcos me deu a guitarra de presente para que eu a levasse comigo.</p>
								<p>Relembrei as vezes em que consertamos o instrumento, trocamos cordas e improvisamos soluções — inclusive quando o jack plate quebrou e eu coloquei no lugar uma tampa de margarina cortada.</p>
								<p>Decidi não parar por ali.</p>
								<EditorialImage src="/images/gtr-01/jack-plate-margarina.jpg" alt="Jack da guitarra instalado em uma peça vermelha recortada de tampa de margarina" caption="O jack plate improvisado com uma tampa de margarina." variant="detail" position="center 58%" />

								<p>Certo dia desmontei a guitarra inteira. Coloquei as peças metálicas em álcool isopropílico para limpeza, substituí a blindagem anterior por alumínio adesivo, lixei, poli e remontei o instrumento.</p>
								<div class="image-pair">
									<EditorialImage src="/images/gtr-01/corpo-desmontado.jpg" alt="Corpo e braço da guitarra desmontados, com cavidades e marcas das modificações expostas" caption="O corpo desmontado antes da limpeza e da remontagem." variant="detail" position="center" />
									<EditorialImage src="/images/gtr-01/limpeza-blindagem-tarraxas.jpg" alt="Sequência mostrando blindagem com alumínio, peças metálicas em limpeza e montagem das tarraxas" caption="Blindagem, limpeza das ferragens e remontagem das tarraxas." variant="detail" position="center" />
								</div>

								<p>Em outro momento decidi trocar o humbucker da ponte por um captador barato que encontrei para comprar. Só depois percebi que havia comprado um captador destinado à posição do braço de uma Stratocaster.</p>
								<p>Não tem problema. Isso também passou a fazer parte do som peculiar do instrumento.</p>
								<EditorialImage src="/images/gtr-01/troca-captador-ponte.jpg" alt="Captador claro removido acima da guitarra enquanto outro captador está instalado na ponte" caption="O captador comprado para a posição errada entrou na história do instrumento." variant="detail" position="center 55%" />

								<p>Depois substituí aquele jack plate improvisado de tampa de margarina por um jack plate de bambu que eu mesmo fiz.</p>
								<div class="image-pair">
									<EditorialImage src="/images/gtr-01/abertura-jack.jpg" alt="Lateral da guitarra com a abertura do jack e fios expostos durante a modificação" caption="A abertura antes da instalação da nova peça." variant="detail" position="center" />
									<EditorialImage src="/images/gtr-01/jack-plate-bambu.jpg" alt="Jack da guitarra instalado em uma placa quadrada feita de bambu" caption="O jack plate de bambu feito à mão." variant="detail" position="center" />
								</div>

								<p>Troquei também a ponte original, que desalinhava as cordas e fazia o mizão ficar para fora da posição correta, por uma ponte curta de Telecaster. Com ela consegui corrigir o alinhamento.</p>
								<div class="image-pair">
									<EditorialImage src="/images/gtr-01/configuracao-ponte-antiga.jpg" alt="Corpo da guitarra com a configuração anterior de captadores e ponte" caption="A configuração anterior, ainda com o problema de alinhamento." variant="detail" position="center" />
									<EditorialImage src="/images/gtr-01/ponte-telecaster.jpg" alt="Detalhe da ponte curta de Telecaster instalada na guitarra" caption="A ponte curta de Telecaster corrigiu o alinhamento das cordas." variant="detail" position="center" />
								</div>

								<p>O single coil original do braço foi substituído por um mini humbucker.</p>
								<EditorialImage src="/images/gtr-01/mini-humbucker-braco.jpg" alt="Guitarra preta pendurada com mini humbucker instalado na posição do braço" caption="O mini humbucker já instalado na posição do braço." variant="portrait" position="center 46%" />

								<p>Mais tarde troquei os potenciômetros por equivalentes da marca Alpha. Atualmente estou trabalhando também em molduras de bambu para os captadores. Antes da fabricação definitiva, fiz moldes de papelão para testar dimensões e encaixe.</p>
								<EditorialImage src="/images/gtr-01/moldes-papelao.jpg" alt="Guitarra com moldes de papelão ao redor dos dois captadores" caption="Moldes de papelão usados para testar dimensões e encaixe das futuras molduras." variant="portrait" position="center 54%" />
							</article>

							<article class="event">
								<div class="event-year">META ATIVA</div>
								<h3>Molduras de bambu</h3>
								<p>A ideia de trabalhar com bambu surgiu ainda durante a confecção do jack plate, mas eu não sabia ao certo como executar peças mais elaboradas tendo à disposição basicamente um pedaço grande de bambu, serrote e lixa.</p>
								<p>A sugestão do método de fabricação das molduras surgiu durante uma conversa com IA.</p>
								<p>A proposta atual é produzir as molduras a partir de <strong>duas lâminas de bambu laminadas entre si, com as fibras orientadas aproximadamente a 90°</strong>, aumentando a resistência da peça, e depois realizar o corte a laser.</p>
								<EditorialImage src="/images/gtr-01/desenho-molduras-bambu.png" alt="Desenho técnico de quatro formatos de molduras para captadores" caption="Estudo das geometrias das molduras que serão produzidas em bambu laminado." variant="detail" position="center" />
							</article>

							<article class="event">
								<div class="event-year">PRÓXIMOS PASSOS</div>
								<h3>O que o futuro trará</h3>
								<p>O projeto continua aberto.</p>
								<p>Ainda pretendo desenvolver knobs, outros detalhes mecânicos e estéticos e explorar a possibilidade de eletrônica ativa.</p>
								<p>Entre as ideias está incorporar circuitos com JFET, experimentando uma eletrônica ativa capaz de acrescentar brilho e definição ao instrumento. Neste momento, isso ainda é uma possibilidade a ser desenvolvida e testada.</p>
							</article>

						</div>

					</div>

				</div>

			</section>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 03 / ESTADO ATUAL ]
					</div>

					<div>

						<h2>
							Configuração atual
						</h2>

						<div class="specs">

							{
								page.specifications.map(({ name, value }) => (
									<div class="spec">

										<div class="spec-name">
											{name}
										</div>

										<div>
											{value}
										</div>

									</div>
								))
							}

						</div>

					</div>

				</div>

			</section>

			<section class="continues">

				<div>
					[ PROJETO ABERTO ]
				</div>

				<h2>
					Esta página continuará mudando junto com a guitarra.
				</h2>

			</section>

		</div>

	</main>

	<ImageLightbox />

	<SiteFooter rightText={`${project.type} / ${project.number}`} />

</BaseLayout>
