---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StatusGrid from "../../components/StatusGrid.astro";
import Tag from "../../components/Tag.astro";
import { getProject } from "../../data/projects";

const project = getProject("gtr-01");

if (!project?.page) {
	throw new Error("Dados do projeto GTR-01 não encontrados.");
}

const page = project.page;
---

<BaseLayout
	title={`${page.code} — Galeria -2048`}
	description="GTR-01 — uma guitarra em constante reconstrução, documentada como projeto aberto de luthieria, eletrônica e áudio."
>
	<style is:global>
		body {
			font-family:Arial, Helvetica, sans-serif;
		}

		header {
			border-bottom:1px solid var(--line);
		}

		nav {
			height:70px;
			display:flex;
			align-items:center;
			justify-content:space-between;
		}

		.brand {
			font-weight:800;
			letter-spacing:-.04em;
		}

		.back {
			font-family:monospace;
			color:var(--muted);
			font-size:.875rem;
		}

		.back:hover {
			color:var(--luthieria);
		}

		.hero {
			padding:100px 0 70px;
		}

		.code {
			font-family:monospace;
			color:var(--luthieria);
			font-size:.875rem;
			line-height:1.5;
			letter-spacing:.08em;
			margin-bottom:25px;
		}

		h1 {
			margin:0;
			font-size:clamp(4rem, 11vw, 9rem);
			line-height:.82;
			letter-spacing:-.075em;
		}

		.subtitle {
			margin-top:35px;
			color:var(--muted);
			font-size:clamp(1.2rem, 2vw, 1.6rem);
			max-width:750px;
			line-height:1.5;
		}

		.tags {
			display:flex;
			flex-wrap:wrap;
			gap:10px;
			margin-top:30px;
		}

		.tag {
			font-family:monospace;
			font-size:.875rem;
			line-height:1.4;
			padding:7px 10px;
			border:1px solid currentColor;
		}

		.luthieria { color:var(--luthieria); }
		.audio { color:var(--audio); }
		.eletronica { color:var(--eletronica); }

		.status {
			margin-top:55px;
		}

		.hero-image {
			margin:0;
			height:clamp(350px, 55vw, 680px);
			border:1px solid var(--line);
			background:
				linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),
				linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px),
				#090c0e;
			background-size:40px 40px;

			overflow:hidden;
		}

		.hero-image img {
			display:block;
			width:100%;
			height:100%;
			object-fit:contain;
			object-position:center;
		}

		section.content {
			padding:100px 0;
			border-bottom:1px solid var(--line);
		}

		.section-grid {
			display:grid;
			grid-template-columns:280px 1fr;
			gap:80px;
		}

		.section-label {
			font-family:monospace;
			font-size:.875rem;
			line-height:1.5;
			color:var(--luthieria);
			letter-spacing:.08em;
		}

		h2 {
			font-size:clamp(2rem,4vw,3.8rem);
			letter-spacing:-.05em;
			margin:0 0 35px;
		}

		.prose {
			max-width:760px;
		}

		.prose p {
			color:var(--muted);
			font-family:Georgia, "Times New Roman", serif;
			font-size:1.125rem;
			line-height:1.8;
		}

		.prose strong {
			color:var(--text);
		}

		.timeline {
			border-left:1px solid var(--line);
		}

		.event {
			position:relative;
			padding:0 0 65px 45px;
		}

		.event::before {
			content:"";
			position:absolute;
			left:-5px;
			top:5px;
			width:9px;
			height:9px;
			border-radius:50%;
			background:var(--luthieria);
			box-shadow:0 0 12px var(--luthieria);
		}

		.event-year {
			font-family:monospace;
			color:var(--luthieria);
			font-size:.875rem;
			line-height:1.5;
			margin-bottom:10px;
		}

		.event h3 {
			font-size:1.5rem;
			margin:0 0 12px;
		}

		.event p {
			color:var(--muted);
			font-family:Georgia, "Times New Roman", serif;
			font-size:1.0625rem;
			line-height:1.75;
			max-width:700px;
			margin:0;
		}

		.specs {
			border-top:1px solid var(--line);
		}

		.spec {
			display:grid;
			grid-template-columns:1fr 1fr;
			gap:30px;
			padding:17px 0;
			border-bottom:1px solid var(--line);
			font-family:monospace;
			font-size:.875rem;
			line-height:1.5;
		}

		.spec-name {
			color:var(--muted);
		}

		.continues {
			padding:120px 0;
			text-align:center;
		}

		.continues div {
			color:var(--luthieria);
			font-family:monospace;
			font-size:.875rem;
			line-height:1.5;
			margin-bottom:20px;
		}

		.continues h2 {
			max-width:800px;
			margin:auto;
		}

		footer {
			border-top:1px solid var(--line);
			padding:30px 0;
			color:var(--muted);
			font-family:monospace;
			font-size:.875rem;
			line-height:1.5;
		}

		.footer {
			display:flex;
			justify-content:space-between;
		}

		@media(max-width:800px) {
			.section-grid {
				grid-template-columns:1fr;
				gap:30px;
			}

			.spec {
				grid-template-columns:1fr;
				gap:7px;
			}
		}
	</style>

	<SiteHeader accent="var(--luthieria)" />

	<main>

		<div class="container">

			<section class="hero">

				<div class="code">
					{project.type} / {project.number}
				</div>

				<h1>
					{page.code}
				</h1>

				<div class="subtitle">
					{page.subtitle}
				</div>

				<div class="tags">
					{project.categories.map(({ label, tone }) => (
						<Tag label={label} tone={tone} />
					))}
				</div>

				<div class="status"><StatusGrid items={page.status} /></div>

			</section>

			<figure class="hero-image">
				<img
					src={project.image}
					alt="Guitarra GTR-01 em seu estado atual"
				/>
			</figure>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 01 / A HISTÓRIA ]
					</div>

					<div class="prose">

						<h2>
							Um instrumento que nunca ficou realmente pronto.
						</h2>

						<p>
							Esta guitarra faz parte da minha história há anos.
							Antes de virar um projeto documentado, ela já havia
							passado por uso, desmontagens, modificações e longos
							períodos esperando a próxima ideia.
						</p>

						<p>
							Em 2026 decidi retomar o instrumento com outra
							abordagem: <strong>não apenas consertá-lo, mas experimentar
							com ele</strong>.
						</p>

						<p>
							Desde então, elétrica, captadores, ferragens,
							acabamento e até a possibilidade de eletrônica ativa
							passaram a fazer parte do projeto.
						</p>

						<p>
							Esta página não representa uma guitarra terminada.
							Ela é o registro do que aconteceu com ela — inclusive
							das ideias que não deram certo.
						</p>

					</div>

				</div>

			</section>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 02 / LINHA DO TEMPO ]
					</div>

					<div>

						<h2>
							A transformação
						</h2>

						<div class="timeline">

							{
								page.timeline.map((entry) => (
									<article class="event">

										<div class="event-year">
											{entry.year}
										</div>

										<h3>
											{entry.title}
										</h3>

										<p>
											{entry.text}
										</p>

									</article>
								))
							}

						</div>

					</div>

				</div>

			</section>

			<section class="content">

				<div class="section-grid">

					<div class="section-label">
						[ 03 / ESTADO ATUAL ]
					</div>

					<div>

						<h2>
							Configuração atual
						</h2>

						<div class="specs">

							{
								page.specifications.map(({ name, value }) => (
									<div class="spec">

										<div class="spec-name">
											{name}
										</div>

										<div>
											{value}
										</div>

									</div>
								))
							}

						</div>

					</div>

				</div>

			</section>

			<section class="continues">

				<div>
					[ PROJETO ABERTO ]
				</div>

				<h2>
					Esta página continuará mudando junto com a guitarra.
				</h2>

			</section>

		</div>

	</main>

	<SiteFooter rightText={`${project.type} / ${project.number}`} />

</BaseLayout>
