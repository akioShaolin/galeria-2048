	["0x0108", "32", "INT8 array", "°C", "Sensores de temperatura; atribuição individual ainda parcial", "Partial"],
	["0x0109", "4", "UINT32 LE", "mV", "Tensão do pack", "Confirmed"],
	["0x010A", "4", "INT32 LE", "mA", "Corrente do pack", "Confirmed"],
	["0x010D", "4", "UINT32 LE", "%", "SOC", "Confirmed"],
	["0x010E", "4", "UINT32 LE", "%", "SOH", "Confirmed"],
	["0x010F", "4", "UINT32 LE", "mAh", "Capacidade restante", "Confirmed"],
	["0x0110", "4", "UINT32 LE", "mAh", "Capacidade completa", "Confirmed"],
	["0x0114", "4", "2 × UINT16 LE", "mA / ?", "Corrente USB confirmada; segundo campo desconhecido", "Partial"],
	["0x0115", "128", "mixed struct", "mixed", "Estatísticas e acumuladores de vida útil", "Partial"],
	["0x0116", "16", "—", "—", "Função ainda não determinada", "Unknown"],
	["0x0117", "4", "UINT32 LE", "ciclos", "Contador de ciclos", "Confirmed"],
	["0x0118", "4", "UINT32 LE", "mAh", "Capacidade de projeto", "Confirmed"],
	["0x0119", "4", "UINT32 LE", "mV", "Tensão de projeto", "Confirmed"],
	["0x011A", "8", "mixed / ASCII", "—", "Versões de software/hardware e IDX", "Partial"],
