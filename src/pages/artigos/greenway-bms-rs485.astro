	["0x0121", "32", "ASCII", "—", "Nome da bateria", "Confirmed"],
	["0x0122", "16", "ASCII", "—", "Nome/modelo da célula", "Confirmed"],
	["0x0123", "32", "ASCII", "—", "Número de série — payload não publicado", "Confirmed"],
