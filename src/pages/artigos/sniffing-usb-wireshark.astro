t:.9375rem/1.5 monospace}.diagram{margin:35px 0;padding:24px;border:1px solid var(--line);background:var(--surface);color:var(--text);font:.9375rem/1.75 monospace;white-space:pre-wrap}.byte-equation{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:16px;margin:35px 0}.byte-equation div{padding:22px;border:1px solid var(--line);background:var(--surface)}.byte-equation strong,.byte-equation span{display:block}.byte-equation strong{font:700 1.35rem/1.3 monospace}.byte-equation span{margin-top:7px;color:var(--muted);font:.875rem/1.5 monospace}.byte-equation b{color:var(--programacao)}.hypothesis,.notice{margin:36px 0;padding:26px;border:1px solid var(--experimentacao);background:rgba(169,92,255,.035)}.hypothesis pre{padding:20px;overflow:auto;background:var(--bg)}.hypothesis pre code{color:var(--text)}.sequence{display:grid;grid-template-columns:minmax(280px,1fr) 1fr;gap:1px;margin:35px 0;border:1px solid var(--line);background:var(--line)}.sequence code,.sequence span{padding:15px;background:var(--surface);font:.875rem/1.5 monospace}.sequence code{color:var(--programacao)}.sequence span{color:var(--muted)}.notepad-wrap{max-width:520px}.download{display:flex;justify-content:space-between;gap:24px;margin:30px 0;padding:22px;border:1px solid var(--programacao);color:var(--text)!important;font:.9rem/1.5 monospace;text-decoration:none}.download span{color:var(--muted)}.download:hover,.download:focus-visible{background:rgba(0,217,255,.05);outline:none}.notice{border-color:var(--line);border-left:2px solid var(--programacao)}.notice strong{font:.875rem/1.5 monospace}.notice p:last-child{margin-bottom:0}.closing{padding:120px 24px;text-align:center}.closing h2{margin:18px auto 0}.closing p{max-width:760px;margin:28px auto 0;color:var(--muted);font:1.125rem/1.8 Georgia,serif}@media(max-width:800px){.hero{padding:70px 0 50px}.content{padding:70px 0}.section-grid{grid-template-columns:1fr;gap:28px}.meta,.byte-equation{grid-template-columns:1fr}.meta 