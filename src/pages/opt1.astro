---
const projetos = [
	{
		id: "001",
		tipo: "PROJETO",
		titulo: "MODBUS SNIFFER",
		descricao: "Monitoramento e diagnóstico de barramentos RS485.",
		categorias: [
			["ELETRÔNICA", "eletronica"],
			["PROGRAMAÇÃO", "programacao"],
			["AUTOMAÇÃO", "automacao"],
		],
	},
	{
		id: "002",
		tipo: "EXPERIMENTO",
		titulo: "PEDAL DE ÁUDIO",
		descricao: "Circuitos analógicos observados da entrada à saída.",
		categorias: [
			["ÁUDIO", "audio"],
			["ELETRÔNICA", "eletronica"],
		],
	},
	{
		id: "003",
		tipo: "REPARO",
		titulo: "LUTHIERIA ELÉTRICA",
		descricao: "Instrumentos, elétrica, modificações e restauração.",
		categorias: [
			["LUTHIERIA", "luthieria"],
			["ÁUDIO", "audio"],
		],
	},
];
---

<html lang="pt-BR">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<title>Galeria -2048 / Instrumentação</title>

	<style>
		:root {
			--bg: #07090a;
			--panel: #0d1113;
			--line: #263036;
			--text: #e7ecee;
			--muted: #77858d;

			--eletronica: #caff33;
			--programacao: #32dcff;
			--automacao: #ff982e;
			--audio: #ff49ce;
			--luthieria: #ffd43b;
		}

		* { box-sizing: border-box; }

		body {
			margin: 0;
			background: var(--bg);
			color: var(--text);
			font-family: "Courier New", monospace;
		}

		.container {
			width: min(1200px, calc(100% - 40px));
			margin: auto;
		}

		header {
			border-bottom: 1px solid var(--line);
		}

		nav {
			height: 62px;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.logo {
			font-weight: bold;
			letter-spacing: .08em;
		}

		.status {
			color: var(--eletronica);
			font-size: .72rem;
		}

		.status::before {
			content: "●";
			margin-right: 8px;
		}

		.hero {
			display: grid;
			grid-template-columns: 1.3fr .7fr;
			min-height: 580px;
			border-bottom: 1px solid var(--line);
		}

		.hero-main {
			padding: 100px 60px 80px 0;
			border-right: 1px solid var(--line);
		}

		.path {
			color: var(--programacao);
			font-size: .75rem;
			margin-bottom: 40px;
		}

		h1 {
			font-size: clamp(4rem, 10vw, 8rem);
			line-height: .82;
			letter-spacing: -.08em;
			margin: 0;
		}

		.hero p {
			max-width: 650px;
			color: var(--muted);
			line-height: 1.7;
			margin-top: 40px;
		}

		.monitor {
			padding: 45px 0 45px 40px;
			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		.monitor-title {
			font-size: .7rem;
			color: var(--muted);
			margin-bottom: 25px;
		}

		.reading {
			border-top: 1px solid var(--line);
			padding: 18px 0;
			display: flex;
			justify-content: space-between;
			font-size: .8rem;
		}

		.value {
			color: var(--eletronica);
		}

		.projects {
			padding: 80px 0;
		}

		.section-title {
			display: flex;
			justify-content: space-between;
			margin-bottom: 30px;
			font-size: .8rem;
			color: var(--muted);
		}

		.project {
			display: grid;
			grid-template-columns: 80px 150px 1fr 1fr;
			align-items: center;
			gap: 25px;
			border-top: 1px solid var(--line);
			padding: 30px 0;
			transition: .2s;
		}

		.project:last-child {
			border-bottom: 1px solid var(--line);
		}

		.project:hover {
			padding-left: 12px;
			background: #0b0e10;
		}

		.number {
			color: var(--eletronica);
		}

		.type {
			font-size: .7rem;
			color: var(--muted);
		}

		.project h2 {
			font-size: 1.35rem;
			margin: 0 0 7px;
		}

		.project p {
			color: var(--muted);
			margin: 0;
			font-size: .82rem;
		}

		.categories {
			display: flex;
			gap: 10px;
			justify-content: flex-end;
			flex-wrap: wrap;
		}

		.cat {
			font-size: .65rem;
			border: 1px solid currentColor;
			padding: 5px 7px;
		}

		.eletronica { color: var(--eletronica); }
		.programacao { color: var(--programacao); }
		.automacao { color: var(--automacao); }
		.audio { color: var(--audio); }
		.luthieria { color: var(--luthieria); }

		footer {
			border-top: 1px solid var(--line);
			padding: 30px 0;
			color: var(--muted);
			font-size: .7rem;
		}

		@media(max-width:800px) {
			.hero { grid-template-columns: 1fr; }
			.hero-main {
				border-right: 0;
				padding-right: 0;
			}
			.monitor { padding-left: 0; }
			.project { grid-template-columns: 50px 1fr; }
			.type { display:none; }
			.categories { justify-content:flex-start; }
		}
	</style>
</head>

<body>
	<header>
		<div class="container">
			<nav>
				<div class="logo">GALERIA / -2048</div>
				<div class="status">SYSTEM ONLINE</div>
			</nav>
		</div>
	</header>

	<main class="container">
		<section class="hero">
			<div class="hero-main">
				<div class="path">~/galeria/acervo/</div>

				<h1>IDEIAS<br />EM SINAL.</h1>

				<p>
					Um registro aberto de coisas construídas, desmontadas,
					programadas, medidas, modificadas e compreendidas.
				</p>
			</div>

			<aside class="monitor">
				<div class="monitor-title">[ SYSTEM / AREAS ]</div>

				<div class="reading">
					<span>ELETRÔNICA</span>
					<span class="value">ACTIVE</span>
				</div>
				<div class="reading">
					<span>PROGRAMAÇÃO</span>
					<span style="color:var(--programacao)">ACTIVE</span>
				</div>
				<div class="reading">
					<span>AUTOMAÇÃO</span>
					<span style="color:var(--automacao)">ACTIVE</span>
				</div>
				<div class="reading">
					<span>ÁUDIO</span>
					<span style="color:var(--audio)">ACTIVE</span>
				</div>
				<div class="reading">
					<span>LUTHIERIA</span>
					<span style="color:var(--luthieria)">ACTIVE</span>
				</div>
			</aside>
		</section>

		<section class="projects">
			<div class="section-title">
				<span>[ ACERVO ]</span>
				<span>03 REGISTROS</span>
			</div>

			{projetos.map((p) => (
				<article class="project">
					<div class="number">/{p.id}</div>
					<div class="type">{p.tipo}</div>

					<div>
						<h2>{p.titulo}</h2>
						<p>{p.descricao}</p>
					</div>

					<div class="categories">
						{p.categorias.map(([nome, classe]) => (
							<span class={`cat ${classe}`}>{nome}</span>
						))}
					</div>
				</article>
			))}
		</section>
	</main>

	<footer>
		<div class="container">
			GALERIA -2048 // AKIOSHAOLIN // ARQUIVO EM CONSTANTE CONSTRUÇÃO
		</div>
	</footer>
</body>
</html>