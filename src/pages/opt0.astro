---
const projetos = [
	{
		tipo: "Projeto",
		numero: "001",
		titulo: "Modbus Sniffer",
		categorias: ["Eletrônica", "Programação", "Automação"],
		descricao:
			"Ferramenta para monitoramento, análise e diagnóstico de comunicação Modbus em barramentos RS485.",
		status: "Em documentação",
	},
	{
		tipo: "Experimento",
		numero: "002",
		titulo: "Pedal de áudio",
		categorias: ["Áudio", "Eletrônica", "Música"],
		descricao:
			"Estudo de circuitos de efeito, comportamento de sinal e análise com osciloscópio.",
		status: "Em desenvolvimento",
	},
	{
		tipo: "Reparo",
		numero: "003",
		titulo: "Luthieria elétrica",
		categorias: ["Luthieria", "Eletrônica", "Áudio"],
		descricao:
			"Modificações, revisão elétrica e experimentos aplicados a instrumentos musicais.",
		status: "Em desenvolvimento",
	},
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<meta
			name="description"
			content="Galeria -2048 — projetos, experimentos e documentação em eletrônica, programação, automação, áudio e luthieria."
		/>

		<title>Galeria -2048</title>

		<style>
			:root {
				--bg: #0b0d0f;
				--surface: #121518;
				--surface-hover: #181c20;
				--text: #e8e8e8;
				--muted: #949ba2;
				--line: #2a3036;
				--accent: #d9ff43;

				font-family:
					Inter,
					ui-sans-serif,
					system-ui,
					-apple-system,
					BlinkMacSystemFont,
					"Segoe UI",
					sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			html {
				background: var(--bg);
				color: var(--text);
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				min-height: 100vh;
				background:
					linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
					var(--bg);
				background-size: 32px 32px;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			.container {
				width: min(1180px, calc(100% - 40px));
				margin: 0 auto;
			}

			header {
				border-bottom: 1px solid var(--line);
			}

			nav {
				height: 72px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 24px;
			}

			.logo {
				font-weight: 800;
				letter-spacing: -0.04em;
				font-size: 1.4rem;
			}

			.logo span {
				color: var(--accent);
			}

			.menu {
				display: flex;
				gap: 28px;
				color: var(--muted);
				font-size: 0.95rem;
			}

			.menu a:hover {
				color: var(--text);
			}

			.hero {
				min-height: 620px;
				display: flex;
				flex-direction: column;
				justify-content: center;
				border-bottom: 1px solid var(--line);
			}

			.eyebrow {
				color: var(--accent);
				font-family: monospace;
				font-size: 0.85rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				margin-bottom: 24px;
			}

			h1 {
				font-size: clamp(4rem, 11vw, 9rem);
				line-height: 0.82;
				letter-spacing: -0.075em;
				margin: 0;
				max-width: 1000px;
			}

			.hero-copy {
				margin-top: 40px;
				max-width: 720px;
				font-size: clamp(1.1rem, 2vw, 1.45rem);
				line-height: 1.6;
				color: var(--muted);
			}

			.hero-copy strong {
				color: var(--text);
				font-weight: 500;
			}

			.tags {
				margin-top: 28px;
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
			}

			.tag {
				border: 1px solid var(--line);
				border-radius: 999px;
				padding: 7px 11px;
				color: var(--muted);
				font-size: 0.78rem;
				font-family: monospace;
			}

			.hero-actions {
				margin-top: 40px;
			}

			.button {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				background: var(--accent);
				color: #0a0b0b;
				padding: 14px 18px;
				font-weight: 700;
				font-size: 0.9rem;
			}

			.button:hover {
				filter: brightness(0.92);
			}

			section {
				padding: 90px 0;
			}

			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: end;
				gap: 32px;
				margin-bottom: 38px;
			}

			.section-kicker {
				font-family: monospace;
				color: var(--accent);
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				margin-bottom: 10px;
			}

			h2 {
				font-size: clamp(2.2rem, 5vw, 4rem);
				margin: 0;
				letter-spacing: -0.055em;
			}

			.section-description {
				color: var(--muted);
				max-width: 460px;
				line-height: 1.6;
			}

			.grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1px;
				background: var(--line);
				border: 1px solid var(--line);
			}

			.card {
				background: var(--surface);
				padding: 28px;
				min-height: 350px;
				display: flex;
				flex-direction: column;
				transition: 0.2s ease;
			}

			.card:hover {
				background: var(--surface-hover);
				transform: translateY(-3px);
			}

			.card-top {
				display: flex;
				justify-content: space-between;
				gap: 16px;
				font-family: monospace;
				font-size: 0.78rem;
				color: var(--muted);
			}

			.card-number {
				color: var(--accent);
			}

			.card h3 {
				font-size: 1.65rem;
				margin: 58px 0 14px;
				letter-spacing: -0.035em;
			}

			.card p {
				color: var(--muted);
				line-height: 1.6;
				margin: 0;
			}

			.card-footer {
				margin-top: auto;
				padding-top: 32px;
			}

			.card-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
			}

			.card-tag {
				font-size: 0.72rem;
				color: var(--muted);
				border-bottom: 1px solid var(--line);
				padding-bottom: 2px;
			}

			.about {
				display: grid;
				grid-template-columns: 0.8fr 1.2fr;
				gap: 80px;
				border-top: 1px solid var(--line);
			}

			.about p {
				color: var(--muted);
				font-size: 1.15rem;
				line-height: 1.8;
				max-width: 700px;
			}

			.about strong {
				color: var(--text);
			}

			footer {
				border-top: 1px solid var(--line);
				padding: 36px 0;
				color: var(--muted);
				font-family: monospace;
				font-size: 0.8rem;
			}

			.footer-content {
				display: flex;
				justify-content: space-between;
				gap: 24px;
			}

			@media (max-width: 850px) {
				.menu {
					display: none;
				}

				.hero {
					min-height: 560px;
				}

				.grid {
					grid-template-columns: 1fr;
				}

				.about {
					grid-template-columns: 1fr;
					gap: 20px;
				}

				.section-header {
					align-items: start;
					flex-direction: column;
				}
			}
		</style>
	</head>

	<body>
		<header>
			<div class="container">
				<nav>
					<a class="logo" href="/">GALERIA <span>-2048</span></a>

					<div class="menu">
						<a href="#projetos">Projetos</a>
						<a href="#sobre">Sobre</a>
						<a href="https://github.com/akioShaolin" target="_blank">GitHub</a>
					</div>
				</nav>
			</div>
		</header>

		<main>
			<div class="container">
				<section class="hero">
					<div class="eyebrow">Laboratório · Oficina · Acervo</div>

					<h1>GALERIA<br />-2048</h1>

					<div class="hero-copy">
						Um espaço para <strong>construir, desmontar, testar e documentar</strong>.
						Projetos técnicos, experimentos e processos que atravessam software,
						eletrônica, automação, áudio e luthieria.
					</div>

					<div class="tags">
						<span class="tag">ELETRÔNICA</span>
						<span class="tag">PROGRAMAÇÃO</span>
						<span class="tag">AUTOMAÇÃO</span>
						<span class="tag">ÁUDIO</span>
						<span class="tag">LUTHIERIA</span>
						<span class="tag">EXPERIMENTAÇÃO</span>
					</div>

					<div class="hero-actions">
						<a href="#projetos" class="button">Explorar a galeria ↓</a>
					</div>
				</section>

				<section id="projetos">
					<div class="section-header">
						<div>
							<div class="section-kicker">Acervo / recentes</div>
							<h2>Projetos</h2>
						</div>

						<div class="section-description">
							Projetos acabados, protótipos, testes de bancada, reparos e investigações.
							Nem tudo aqui precisa estar terminado para ser documentado.
						</div>
					</div>

					<div class="grid">
						{
							projetos.map((projeto) => (
								<article class="card">
									<div class="card-top">
										<span>{projeto.tipo}</span>
										<span class="card-number">#{projeto.numero}</span>
									</div>

									<h3>{projeto.titulo}</h3>

									<p>{projeto.descricao}</p>

									<div class="card-footer">
										<div class="card-tags">
											{projeto.categorias.map((categoria) => (
												<span class="card-tag">{categoria}</span>
											))}
										</div>
									</div>
								</article>
							))
						}
					</div>
				</section>

				<section class="about" id="sobre">
					<div>
						<div class="section-kicker">Sobre / 2048</div>
						<h2>Um acervo em construção.</h2>
					</div>

					<div>
						<p>
							A <strong>Galeria -2048</strong> reúne projetos, experiências, reparos e
							estudos desenvolvidos em diferentes áreas técnicas e criativas.
						</p>

						<p>
							O objetivo não é apenas mostrar o resultado final, mas registrar o
							processo: hipóteses, erros, medições, versões, decisões de projeto e
							o que foi aprendido no caminho.
						</p>

						<p>
							Projetos e documentação por <strong>AkioShaolin</strong>.
						</p>
					</div>
				</section>
			</div>
		</main>

		<footer>
			<div class="container footer-content">
				<span>GALERIA -2048</span>
				<span>Construindo · testando · documentando</span>
			</div>
		</footer>
	</body>
</html>