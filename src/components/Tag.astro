---
import { getAreaByLabel, getAreaPath } from "../data/areas";

interface Props {
	label: string;
	tone: string;
	compact?: boolean;
	href?: string;
}

const { label, tone, compact = false, href } = Astro.props;
const area = getAreaByLabel(label);
const target = href ?? (area ? getAreaPath(area) : undefined);
const Element = target ? "a" : "span";
---

<Element href={target} class:list={["tag", tone, { compact, interactive: target }]}>{label}</Element>

<style>
	.tag {
		display: inline-block;
		padding: 7px 14px;
		border: 1px solid currentColor;
		font-family: monospace;
		font-size: .875rem;
		font-weight: bold;
		line-height: 1.35;
		letter-spacing: .03em;
		box-shadow: inset 0 0 8px rgba(255, 255, 255, .02);
	}

	.compact {
		padding: 5px 10px;
	}

	.interactive {
		transition: background-color .2s ease, color .2s ease, box-shadow .2s ease;
	}

	.interactive:hover,
	.interactive:focus-visible {
		background: color-mix(in srgb, currentColor 14%, transparent);
		box-shadow: 0 0 12px color-mix(in srgb, currentColor 35%, transparent);
		outline: 1px solid currentColor;
		outline-offset: 3px;
	}
</style>
