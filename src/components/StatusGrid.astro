---
interface StatusItem {
	label: string;
	value: string;
	tone?: string;
}

interface Props {
	items: StatusItem[];
}

const { items } = Astro.props;
---

<div class="status-grid">
	{items.map((item) => (
		<div class="status-item">
			<div class="status-label">{item.label}</div>
			<div class:list={["status-value", item.tone]}>{item.value}</div>
		</div>
	))}
</div>

<style>
	.status-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border: 1px solid var(--line);
	}

	.status-item {
		padding: 20px;
		border-right: 1px solid var(--line);
	}

	.status-item:last-child {
		border-right: 0;
	}

	.status-label,
	.status-value {
		font-family: monospace;
		line-height: 1.45;
	}

	.status-label {
		margin-bottom: 8px;
		color: var(--muted);
		font-size: .875rem;
	}

	.status-value {
		font-size: .9375rem;
	}

	@media (max-width: 800px) {
		.status-grid {
			grid-template-columns: 1fr;
		}

		.status-item {
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}

		.status-item:last-child {
			border-bottom: 0;
		}
	}
</style>
