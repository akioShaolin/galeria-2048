<dialog class="image-lightbox" data-image-lightbox aria-label="Visualização ampliada da fotografia">
	<div class="image-lightbox__panel">
		<button class="image-lightbox__close" type="button" aria-label="Fechar imagem ampliada">FECHAR ×</button>
		<img class="image-lightbox__image" src="" alt="" />
		<p class="image-lightbox__caption" hidden></p>
	</div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>("[data-image-lightbox]");

	if (dialog) {
		const image = dialog.querySelector<HTMLImageElement>(".image-lightbox__image");
		const caption = dialog.querySelector<HTMLParagraphElement>(".image-lightbox__caption");
		const closeButton = dialog.querySelector<HTMLButtonElement>(".image-lightbox__close");
		let opener: HTMLElement | null = null;

		document.querySelectorAll<HTMLElement>("[data-lightbox-src]").forEach((trigger) => {
			trigger.addEventListener("click", () => {
				if (!image || !caption) return;
				opener = trigger;
				image.src = trigger.dataset.lightboxSrc ?? "";
				image.alt = trigger.dataset.lightboxAlt ?? "";
				caption.textContent = trigger.dataset.lightboxCaption ?? "";
				caption.hidden = !caption.textContent;
				dialog.showModal();
				closeButton?.focus();
			});
		});

		const close = () => dialog.close();
		closeButton?.addEventListener("click", close);
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) close();
		});
		dialog.addEventListener("close", () => {
			image?.removeAttribute("src");
			opener?.focus();
		});
	}
</script>

<style>
	.image-lightbox {
		width: 100vw;
		max-width: none;
		height: 100vh;
		max-height: none;
		margin: 0;
		padding: 20px;
		border: 0;
		background: rgba(5, 7, 8, .96);
		color: var(--text);
	}

	.image-lightbox::backdrop {
		background: rgba(0, 0, 0, .9);
	}

	.image-lightbox__panel {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		gap: 12px;
		width: 100%;
		height: 100%;
	}

	.image-lightbox__close {
		justify-self: end;
		padding: 8px 10px;
		border: 1px solid var(--line);
		background: var(--surface);
		color: var(--text);
		font-family: monospace;
		font-size: .875rem;
		cursor: pointer;
	}

	.image-lightbox__close:hover,
	.image-lightbox__close:focus-visible {
		border-color: var(--luthieria);
		color: var(--luthieria);
	}

	.image-lightbox__image {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 0;
		object-fit: contain;
	}

	.image-lightbox__caption {
		max-width: 760px;
		margin: 0 auto;
		color: var(--muted);
		font-family: monospace;
		font-size: .875rem;
		line-height: 1.5;
		text-align: center;
	}

	@media (max-width: 600px) {
		.image-lightbox {
			padding: 12px;
		}
	}
</style>
