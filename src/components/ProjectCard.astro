---
import Tag from "./Tag.astro";
import type { Project } from "../data/projects";

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<article class:list={["card", { future: !project.path }]}>
	{project.path ? (
		<a class="card-image" href={project.path} aria-label={`Abrir ${project.title}`}>
			<img src={project.image} alt={project.title} />
		</a>
	) : (
		<div class="card-image"><img src={project.image} alt={project.title} /></div>
	)}

	<div class="card-content">
		<div class={`card-code ${project.categories[0].tone}`}>
			{project.type}&nbsp;/&nbsp;{project.number}
		</div>

		{!project.path && <div class="availability">[ EM DESENVOLVIMENTO ]</div>}

		<h2>{project.path ? <a href={project.path}>{project.title}</a> : project.title}</h2>

		<div class="tags">
			{project.categories.map(({ label, tone }) => <Tag label={label} tone={tone} compact />)}
		</div>

		<div class="card-bottom">
			<div class="card-description">{project.description}</div>
			{project.path && <a class="arrow" href={project.path} aria-label={`Abrir ${project.title}`}>→</a>}
		</div>
	</div>
</article>

<style>
	.future {
		cursor: default;
	}

	.future:hover {
		transform: none;
		border-color: var(--line);
	}

	.availability {
		margin: -2px 0 12px;
		color: var(--muted);
		font-family: monospace;
		font-size: .875rem;
		font-weight: bold;
		line-height: 1.45;
		letter-spacing: .03em;
	}

	.card-image {
		display: block;
	}

	h2 a:focus-visible,
	.arrow:focus-visible,
	.card-image:focus-visible {
		outline: 2px solid var(--programacao);
		outline-offset: 3px;
	}
</style>
