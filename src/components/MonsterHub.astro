---
import type { MonsterHubGraph } from "../data/monsterHub";
import { buildMonsterHubLayout, parentSegmentStyle } from "../data/monsterHubLayout";

interface Props {
	graph: MonsterHubGraph;
}

const { graph } = Astro.props;
const nodePalette = {
	projetos: { label: "Projetos", accent: "#66d4ad", surface: "#0d221d" },
	artigos: { label: "Artigos", accent: "#b8a1f5", surface: "#1d1729" },
	oficina: { label: "Casos de oficina", accent: "#f0cf78", surface: "#241e13" },
};
const { positions, parentBends, initialFocusNodeId } = buildMonsterHubLayout(graph);
const serializedGraph = JSON.stringify({
	initialFocusNodeId,
	nodes: graph.nodes.map((node) => {
		const section = node.data.url.split("/")[1];
		const { accent, surface } = section === "artigos" || section === "oficina"
			? nodePalette[section]
			: nodePalette.projetos;
		return {
			...node,
			position: positions[node.data.id],
			data: { ...node.data, accent, surface },
		};
	}),
	edges: graph.edges.map((edge) => {
		const { id, source, target } = edge.data;
		const bends = parentBends[id];
		return bends?.length
			? { ...edge, classes: "has-bends", style: parentSegmentStyle(positions[source], positions[target], bends) }
			: edge;
	}),
}).replace(/</g, "\\u003c");
const nodeById = new Map(graph.nodes.map(({ data }) => [data.id, data]));
const relationsByKind = {
	parentesco: graph.edges.filter(({ data }) => data.kind === "parentesco"),
	influencia: graph.edges.filter(({ data }) => data.kind === "influencia"),
	paralelo: graph.edges.filter(({ data }) => data.kind === "paralelo"),
};
---

<div class="hub-stage">
<section class="hub-shell" aria-labelledby="monster-map-title">
	<div class="hub-toolbar">
		<div class="filter-group" aria-label="Filtrar tipos de relação">
			<button type="button" class="filter-button is-active" data-filter="todos" aria-pressed="true">TODOS</button>
			<button type="button" class="filter-button" data-filter="parentesco" aria-pressed="false">PARENTESCO</button>
			<button type="button" class="filter-button" data-filter="influencia" aria-pressed="false">INFLUÊNCIA</button>
			<button type="button" class="filter-button" data-filter="paralelo" aria-pressed="false">PARALELOS</button>
		</div>

		<form class="hub-search" data-hub-search>
			<label for="monster-hub-search">LOCALIZAR NO MAPA</label>
			<div>
				<input id="monster-hub-search" name="query" type="search" list="monster-hub-options" autocomplete="off" placeholder="Título, código ou ID" />
				<datalist id="monster-hub-options">
					{graph.nodes.map(({ data }) => <option value={data.label}>{data.type}{data.code ? ` / ${data.code}` : ""}</option>)}
				</datalist>
				<button type="submit">LOCALIZAR</button>
			</div>
		</form>
	</div>

	<div class="hub-workspace">
		<div class="graph-column">
			<div class="graph-heading">
				<div>
					<p class="system-label">[ MAPA INTERATIVO ]</p>
					<h2 id="monster-map-title">PROJETOS EM CONSTELAÇÃO</h2>
				</div>
				<div class="graph-actions">
					<button type="button" data-fullscreen-toggle aria-pressed="false" hidden>TELA CHEIA</button>
					<button type="button" data-details-toggle aria-controls="monster-hub-details" aria-expanded="false" hidden>DETALHES</button>
					<button type="button" data-clear-focus>LIMPAR FOCO</button>
				</div>
			</div>
			<div class="graph-frame">
				<div id="monster-hub-graph" role="img" aria-label="Grafo interativo das relações entre conteúdos da Galeria -2048">
					<p class="graph-loading">[ CARREGANDO MAPA ]</p>
				</div>
				<div class="zoom-controls" role="group" aria-label="Controles de zoom do grafo">
					<button type="button" data-zoom-in aria-label="Aumentar zoom">+</button>
					<button type="button" data-zoom-out aria-label="Diminuir zoom">−</button>
					<button type="button" data-fit-graph aria-label="Ajustar grafo à tela">AJUSTAR</button>
				</div>
			</div>
			<ul class="node-legend" aria-label="Tipos de conteúdo no mapa">
				{Object.values(nodePalette).map(({ label, accent, surface }) => (
					<li style={`--node-accent: ${accent}; --node-surface: ${surface}`}>
						<span aria-hidden="true"></span>{label}
					</li>
				))}
			</ul>
			<p class="graph-help">ARRASTE PARA MOVER / USE A RODA OU PINÇA PARA ZOOM / TOQUE EM UM NÓ OU RELAÇÃO</p>
			<p class="search-status" data-search-status aria-live="polite"></p>
		</div>

		<aside id="monster-hub-details" class="detail-panel" aria-label="Detalhes da seleção" aria-live="polite">
			<div class="detail-empty" data-detail-empty>
				<p class="system-label">[ LEITURA DO MAPA ]</p>
				<h2>ESCOLHA UM SINAL.</h2>
				<p>Selecione um projeto para ver sua vizinhança ou uma linha para entender por que os dois conteúdos estão conectados.</p>
			</div>

			<div class="detail-content" data-detail-node hidden>
				<p class="detail-kicker" data-node-type></p>
				<h2 data-node-title></h2>
				<figure class="detail-image" data-node-image-wrap hidden><img data-node-image alt="" /></figure>
				<p class="detail-description" data-node-description></p>
				<div class="detail-tags" data-node-areas></div>
				<p class="detail-count" data-node-relations></p>
				<a class="detail-link" data-node-link href="/">ABRIR CONTEÚDO</a>
			</div>

			<div class="detail-content" data-detail-edge hidden>
				<p class="detail-kicker" data-edge-kind></p>
				<h2 data-edge-label></h2>
				<p class="relation-path"><span data-edge-source></span><b data-edge-symbol>→</b><span data-edge-target></span></p>
				<p class="detail-description" data-edge-description></p>
				<p class="detail-count" data-edge-subtype></p>
			</div>
		</aside>
	</div>

	<script id="monster-hub-data" type="application/json" is:inline set:html={serializedGraph}></script>
</section>
</div>

<section class="text-map" aria-labelledby="text-map-title">
	<div class="text-map-heading">
		<p class="system-label">[ ALTERNATIVA TEXTUAL / MESMA FONTE DE DADOS ]</p>
		<h2 id="text-map-title">RELAÇÕES REGISTRADAS</h2>
		<p>Esta lista preserva o conteúdo do mapa para leitores de tela, navegação por teclado e situações em que o grafo interativo não estiver disponível.</p>
	</div>

	<div class="text-relation-groups">
		{Object.entries(relationsByKind).map(([kind, entries]) => (
			<section class={`text-relation-group ${kind}`} aria-labelledby={`text-${kind}`}>
				<h3 id={`text-${kind}`}>{kind === "influencia" ? "INFLUÊNCIA" : kind.toUpperCase()}</h3>
				<ul>
					{entries.map(({ data }) => {
						const source = nodeById.get(data.source);
						const target = nodeById.get(data.target);
						if (!source || !target) return null;
						return (
							<li>
								<div class="relation-titles">
									<a href={source.url}>{source.label}</a>
									<span aria-hidden="true">{data.kind === "paralelo" ? "↔" : "→"}</span>
									<a href={target.url}>{target.label}</a>
								</div>
								<strong>{data.label}</strong>
								{data.description && <p>{data.description}</p>}
							</li>
						);
					})}
				</ul>
			</section>
		))}
	</div>
</section>

<script>
	import cytoscape, {
		type Core,
		type EdgeDefinition,
		type EdgeSingular,
		type EventObject,
		type NodeDefinition,
		type NodeSingular,
	} from "cytoscape";
	import type { MonsterHubGraph, MonsterHubNodeData } from "../data/monsterHub";
	import { HUB_NODE_WIDTH, HUB_NODE_HEIGHT } from "../data/monsterHubLayout";

	type PositionedGraph = {
		nodes: Array<NodeDefinition & MonsterHubGraph["nodes"][number]>;
		edges: EdgeDefinition[];
		initialFocusNodeId?: string;
	};

	const graphElement = document.querySelector<HTMLElement>("#monster-hub-graph");
	const dataElement = document.querySelector<HTMLScriptElement>("#monster-hub-data");

	if (graphElement && dataElement) {
		const graph = JSON.parse(dataElement.textContent ?? "{}") as PositionedGraph;
		const nodesById = new Map(graph.nodes.map(({ data }) => [data.id, data]));
		let activeFilter = "todos";
		let cy: Core;
		let viewportWasAdjusted = false;
		let resizeFrame = 0;
		let viewportWidth = graphElement.clientWidth;
		let viewportHeight = graphElement.clientHeight;

		const MIN_ZOOM = 0.1;
		const MAX_ZOOM = 2.6;
		const ZOOM_STEP = 1.2;
		const emptyPanel = document.querySelector<HTMLElement>("[data-detail-empty]");
		const nodePanel = document.querySelector<HTMLElement>("[data-detail-node]");
		const edgePanel = document.querySelector<HTMLElement>("[data-detail-edge]");
		const searchStatus = document.querySelector<HTMLElement>("[data-search-status]");
		const shell = graphElement.closest<HTMLElement>(".hub-shell");
		const fullscreenButton = shell?.querySelector<HTMLButtonElement>("[data-fullscreen-toggle]");
		const detailsButton = shell?.querySelector<HTMLButtonElement>("[data-details-toggle]");
		const detailsPanel = shell?.querySelector<HTMLElement>("#monster-hub-details");
		const compactScreen = window.matchMedia("(max-width: 800px)");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const inertSiblings: HTMLElement[] = [];
		let fullscreen = false;
		let detailsOpen = false;
		let pageScroll = { x: 0, y: 0 };

		const syncDetailsPanel = () => {
			if (!detailsButton || !detailsPanel) return;
			const useDrawer = fullscreen && compactScreen.matches;
			detailsButton.hidden = !useDrawer;
			detailsButton.textContent = useDrawer && detailsOpen ? "FECHAR DETALHES" : "DETALHES";
			detailsButton.setAttribute("aria-expanded", String(useDrawer && detailsOpen));
			const hidePanel = useDrawer && !detailsOpen;
			if (hidePanel && detailsPanel.contains(document.activeElement)) {
				detailsButton.focus({ preventScroll: true });
			}
			detailsPanel.hidden = hidePanel;
		};

		const revealSelection = () => {
			if (!fullscreen || !compactScreen.matches) return;
			detailsOpen = true;
			syncDetailsPanel();
		};

		const setText = (selector: string, value: string) => {
			const element = document.querySelector<HTMLElement>(selector);
			if (element) element.textContent = value;
		};

		const hideDetails = () => {
			if (emptyPanel) emptyPanel.hidden = false;
			if (nodePanel) nodePanel.hidden = true;
			if (edgePanel) edgePanel.hidden = true;
		};

		const clearHighlight = () => {
			cy.elements().removeClass("is-dimmed is-neighbor is-focus");
			hideDetails();
		};

		const contentLinkLabel = (type: string) => {
			if (type.includes("ARTIGO")) return "ABRIR ARTIGO";
			if (type.includes("OFICINA")) return "ABRIR CASO";
			return "ABRIR PROJETO";
		};

		const showNode = (node: NodeSingular) => {
			const data = node.data() as MonsterHubNodeData;
			const neighborhood = node.closedNeighborhood();
			cy.elements().removeClass("is-dimmed is-neighbor is-focus");
			cy.elements().not(neighborhood).addClass("is-dimmed");
			neighborhood.addClass("is-neighbor");
			node.addClass("is-focus");

			if (emptyPanel) emptyPanel.hidden = true;
			if (edgePanel) edgePanel.hidden = true;
			if (nodePanel) nodePanel.hidden = false;
			setText("[data-node-type]", `${data.type}${data.code ? ` / ${data.code}` : ""}`);
			setText("[data-node-title]", data.label);
			setText("[data-node-description]", data.description);
			setText("[data-node-relations]", `${node.connectedEdges(":visible").length} RELAÇÃO(ÕES) VISÍVEL(IS)`);

			const imageWrap = document.querySelector<HTMLElement>("[data-node-image-wrap]");
			const image = document.querySelector<HTMLImageElement>("[data-node-image]");
			if (imageWrap && image) {
				imageWrap.hidden = !data.image;
				if (data.image) {
					image.src = data.image;
					image.alt = `Imagem de ${data.label}`;
				} else {
					image.removeAttribute("src");
					image.alt = "";
				}
			}

			const tags = document.querySelector<HTMLElement>("[data-node-areas]");
			if (tags) {
				tags.replaceChildren(...data.areas.map((area) => {
					const tag = document.createElement("span");
					tag.textContent = area;
					return tag;
				}));
			}

			const link = document.querySelector<HTMLAnchorElement>("[data-node-link]");
			if (link) {
				link.href = data.url;
				link.textContent = contentLinkLabel(data.type);
			}
			revealSelection();
		};

		const showEdge = (edge: EdgeSingular) => {
			const data = edge.data();
			const endpoints = edge.connectedNodes();
			cy.elements().removeClass("is-dimmed is-neighbor is-focus");
			cy.elements().not(edge.union(endpoints)).addClass("is-dimmed");
			edge.union(endpoints).addClass("is-neighbor");
			edge.addClass("is-focus");

			if (emptyPanel) emptyPanel.hidden = true;
			if (nodePanel) nodePanel.hidden = true;
			if (edgePanel) edgePanel.hidden = false;
			setText("[data-edge-kind]", data.kind === "influencia" ? "INFLUÊNCIA" : String(data.kind).toUpperCase());
			setText("[data-edge-label]", data.label);
			setText("[data-edge-source]", nodesById.get(data.source)?.label ?? data.source);
			setText("[data-edge-target]", nodesById.get(data.target)?.label ?? data.target);
			setText("[data-edge-symbol]", data.kind === "paralelo" ? "↔" : "→");
			setText("[data-edge-description]", data.description ?? "Relação registrada no acervo.");
			setText("[data-edge-subtype]", data.subtype ? `SUBTIPO / ${String(data.subtype).replaceAll("_", " ").toUpperCase()}` : "");
			revealSelection();
		};

		const visibleGraph = () => {
			const visibleEdges = cy.edges(":visible");
			return visibleEdges.length
				? visibleEdges.union(visibleEdges.connectedNodes())
				: cy.nodes(":visible");
		};

		const viewportPadding = () => graphElement.clientWidth < 680 ? 32 : 55;
		const initialZoomFloor = () => graphElement.clientWidth < 680 ? 0.46 : 0.68;

		const fitVisibleGraph = () => {
			const elements = visibleGraph();
			if (!elements.length) return;

			cy.stop();
			cy.fit(elements, viewportPadding());
			cy.center(elements);
		};

		const initialFocus = () => {
			const node = graph.initialFocusNodeId ? cy.getElementById(graph.initialFocusNodeId) : cy.collection();
			if (!node.length || !node.visible()) return visibleGraph();
			const nearby = node.closedNeighborhood();
			if (graphElement.clientWidth < 950) return nearby.filter(":visible");

			// Wide panels can also show where the nearest descendant branches lead.
			const branches = node.outgoers('edge[kind = "parentesco"]').targets().outgoers('edge[kind = "parentesco"]');
			return nearby.union(branches).union(branches.targets()).filter(":visible");
		};

		const frameInitialView = () => {
			const elements = initialFocus();
			if (!elements.length) return;
			cy.stop();
			cy.fit(elements, viewportPadding());
			if (cy.zoom() < initialZoomFloor()) cy.zoom(initialZoomFloor());
			const anchor = graph.initialFocusNodeId && graphElement.clientWidth < 480
				? cy.getElementById(graph.initialFocusNodeId)
				: elements;
			cy.center(anchor);
		};

		const applyFilter = (kind: string) => {
			activeFilter = kind;
			cy.elements().style("display", "element");
			if (kind !== "todos") {
				const visibleEdges = cy.edges().filter((edge) => edge.data("kind") === kind);
				const visibleNodes = visibleEdges.connectedNodes();
				cy.edges().not(visibleEdges).style("display", "none");
				cy.nodes().not(visibleNodes).style("display", "none");
			}
			clearHighlight();
			document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
				const selected = button.dataset.filter === kind;
				button.classList.toggle("is-active", selected);
				button.setAttribute("aria-pressed", String(selected));
			});
			fitVisibleGraph();
			viewportWasAdjusted = true;
		};

		cy = cytoscape({
			container: graphElement,
			elements: [...graph.nodes, ...graph.edges],
			layout: { name: "preset", fit: false },
			minZoom: MIN_ZOOM,
			maxZoom: MAX_ZOOM,
			boxSelectionEnabled: false,
			autoungrabify: true,
			style: [
				{
					selector: "node",
					style: {
						label: "data(graphLabel)",
						shape: "round-rectangle",
						width: HUB_NODE_WIDTH,
						height: HUB_NODE_HEIGHT,
						"background-color": "data(surface)",
						"border-color": "data(accent)",
						"border-width": 1,
						color: "#f0f2f2",
						"font-family": "Courier New, monospace",
						"font-size": 14,
						"font-weight": 600,
						"text-wrap": "wrap",
						"text-max-width": "198px",
						"text-halign": "center",
						"text-valign": "center",
						"line-height": 1.35,
						"overlay-opacity": 0,
					},
				},
				{
					selector: "edge",
					style: {
						width: 2,
						"curve-style": "bezier",
						"line-color": "#64727a",
						"target-arrow-color": "#64727a",
						"target-arrow-shape": "triangle",
						"arrow-scale": 1.15,
						"overlay-opacity": 0,
					},
				},
				{
					selector: 'edge[kind = "parentesco"]',
					style: {
						"curve-style": "straight",
						"source-endpoint": "50% 0%",
						"target-endpoint": "-50% 0%",
						// @ts-expect-error O Cytoscape aceita "endpoints" em execução, mas ainda não o declara no tipo.
						"edge-distances": "endpoints",
						"line-color": "#00d9ff",
						"target-arrow-color": "#00d9ff",
						"z-index": 2,
						width: 3,
					},
				},
				{
					selector: 'edge[kind = "parentesco"].has-bends',
					style: { "curve-style": "segments" },
				},
				{
					selector: 'edge[kind = "influencia"]',
					style: {
						"curve-style": "unbundled-bezier", "control-point-distances": 25, "control-point-weights": 0.5,
						"line-color": "#ff8a00", "target-arrow-color": "#ff8a00", "line-style": "dashed",
					},
				},
				{
					selector: 'edge[kind = "paralelo"]',
					style: {
						"curve-style": "unbundled-bezier", "control-point-distances": 39, "control-point-weights": 0.5,
						"line-color": "#ff20c7", "target-arrow-shape": "none", "line-style": "dotted", width: 2,
					},
				},
				{ selector: ".is-dimmed", style: { opacity: 0.12 } },
				{ selector: "node.is-neighbor", style: { "border-color": "#f0f2f2", "border-width": 2 } },
				{ selector: "node.is-focus", style: { "border-color": "#cfff00", "border-width": 4 } },
				{ selector: "edge.is-neighbor", style: { opacity: 1, "z-index": 20 } },
				{ selector: "edge.is-focus", style: { width: 5, "z-index": 30 } },
			],
		});

		cy.on("tap", "node", (event: EventObject) => showNode(event.target as NodeSingular));
		cy.on("tap", "edge", (event: EventObject) => showEdge(event.target as EdgeSingular));
		cy.on("tap", (event: EventObject) => {
			if (event.target === cy) clearHighlight();
		});

		const markViewportAsAdjusted = () => {
			viewportWasAdjusted = true;
		};

		const zoomBy = (factor: number) => {
			markViewportAsAdjusted();
			const level = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, cy.zoom() * factor));
			cy.zoom({
				level,
				renderedPosition: {
					x: graphElement.clientWidth / 2,
					y: graphElement.clientHeight / 2,
				},
			});
		};

		graphElement.addEventListener("wheel", markViewportAsAdjusted, { passive: true });
		graphElement.addEventListener("pointerdown", markViewportAsAdjusted, { passive: true });
		graphElement.addEventListener("touchstart", markViewportAsAdjusted, { passive: true });

		document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
			button.addEventListener("click", () => applyFilter(button.dataset.filter ?? "todos"));
		});

		document.querySelector<HTMLButtonElement>("[data-clear-focus]")?.addEventListener("click", clearHighlight);
		document.querySelector<HTMLButtonElement>("[data-zoom-in]")?.addEventListener("click", () => zoomBy(ZOOM_STEP));
		document.querySelector<HTMLButtonElement>("[data-zoom-out]")?.addEventListener("click", () => zoomBy(1 / ZOOM_STEP));
		document.querySelector<HTMLButtonElement>("[data-fit-graph]")?.addEventListener("click", () => {
			fitVisibleGraph();
			markViewportAsAdjusted();
		});

		document.querySelector<HTMLFormElement>("[data-hub-search]")?.addEventListener("submit", (event) => {
			event.preventDefault();
			const form = event.currentTarget as HTMLFormElement;
			const query = new FormData(form).get("query")?.toString().trim().toLocaleLowerCase("pt-BR") ?? "";
			if (!query) return;

			if (activeFilter !== "todos") applyFilter("todos");
			const match = graph.nodes.find(({ data }) =>
				[data.label, data.code, data.id].filter(Boolean).some((value) => String(value).toLocaleLowerCase("pt-BR").includes(query)),
			);

			if (!match) {
				if (searchStatus) searchStatus.textContent = `Nenhum conteúdo encontrado para “${query}”.`;
				return;
			}

			const node = cy.getElementById(match.data.id) as NodeSingular;
			markViewportAsAdjusted();
			cy.stop();
			if (reducedMotion.matches) {
				cy.zoom(1.15);
				cy.center(node);
			} else {
				cy.animate({ center: { eles: node }, zoom: 1.15 }, { duration: 350 });
			}
			showNode(node);
			if (searchStatus) searchStatus.textContent = `${match.data.label} selecionado no mapa.`;
		});

		const scheduleViewportResize = () => {
			cancelAnimationFrame(resizeFrame);
			resizeFrame = requestAnimationFrame(() => {
				const width = graphElement.clientWidth;
				const height = graphElement.clientHeight;
				if (!width || !height || (width === viewportWidth && height === viewportHeight)) return;
				const zoom = cy.zoom();
				const pan = cy.pan();
				const modelCenter = {
					x: (viewportWidth / 2 - pan.x) / zoom,
					y: (viewportHeight / 2 - pan.y) / zoom,
				};
				cy.resize();
				viewportWidth = width;
				viewportHeight = height;
				if (!viewportWasAdjusted) {
					frameInitialView();
					return;
				}
				cy.viewport({
					zoom,
					pan: {
						x: width / 2 - modelCenter.x * zoom,
						y: height / 2 - modelCenter.y * zoom,
					},
				});
			});
		};
		const resizeObserver = new ResizeObserver(scheduleViewportResize);
		resizeObserver.observe(graphElement);

		const stage = shell?.parentElement;
		if (shell && stage && fullscreenButton) {
			const setFullscreen = (enabled: boolean) => {
				if (enabled === fullscreen) return;
				cy.stop();
				markViewportAsAdjusted();
				fullscreen = enabled;
				detailsOpen = false;
				if (enabled) {
					pageScroll = { x: window.scrollX, y: window.scrollY };
					stage.style.minHeight = `${shell.offsetHeight}px`;
					// Make only the existing workspace available to keyboard and assistive technology.
					for (let branch: HTMLElement = shell; branch.parentElement && branch !== document.body; branch = branch.parentElement) {
						for (const sibling of branch.parentElement.children) {
							if (!(sibling instanceof HTMLElement) || sibling === branch || sibling.inert) continue;
							sibling.inert = true;
							inertSiblings.push(sibling);
						}
					}
					document.documentElement.classList.add("monster-hub-immersive");
					shell.setAttribute("role", "dialog");
					shell.setAttribute("aria-modal", "true");
				} else {
					for (const sibling of inertSiblings.splice(0)) sibling.inert = false;
					document.documentElement.classList.remove("monster-hub-immersive");
					shell.removeAttribute("role");
					shell.removeAttribute("aria-modal");
					stage.style.removeProperty("min-height");
				}
				shell.classList.toggle("is-fullscreen", enabled);
				fullscreenButton.textContent = enabled ? "SAIR DA TELA CHEIA" : "TELA CHEIA";
				fullscreenButton.setAttribute("aria-pressed", String(enabled));
				syncDetailsPanel();
				if (!enabled) window.scrollTo({ top: pageScroll.y, left: pageScroll.x, behavior: "instant" });
				fullscreenButton.focus({ preventScroll: true });
				scheduleViewportResize();
			};

			fullscreenButton.hidden = false;
			fullscreenButton.addEventListener("click", () => setFullscreen(!fullscreen));
			detailsButton?.addEventListener("click", () => {
				detailsOpen = !detailsOpen;
				syncDetailsPanel();
			});
			compactScreen.addEventListener("change", () => {
				const detailHadFocus = document.activeElement === detailsButton;
				syncDetailsPanel();
				if (detailHadFocus && detailsButton?.hidden) fullscreenButton.focus({ preventScroll: true });
			});
			document.addEventListener("keydown", (event) => {
				if (!fullscreen || event.isComposing) return;
				if (event.key === "Escape") {
					event.preventDefault();
					setFullscreen(false);
				} else if (event.key === "Tab") {
					const controls = Array.from(shell.querySelectorAll<HTMLElement>("button:enabled, input:enabled, a[href]"))
						.filter((control) => control.getClientRects().length > 0);
					const first = controls.at(0);
					const last = controls.at(-1);
					if (!first || !last) return;
					const current = document.activeElement;
					if (!shell.contains(current) || current === (event.shiftKey ? first : last)) {
						event.preventDefault();
						(event.shiftKey ? last : first).focus();
					}
				}
			});
		}

		frameInitialView();
		graphElement.querySelector(".graph-loading")?.remove();
	}
